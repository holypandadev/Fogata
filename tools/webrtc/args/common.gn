# Arguments every Fogata build of WebRTC shares (see ../README.md).
is_debug = false
is_component_build = false
symbol_level = 0
enable_iterator_debugging = false
treat_warnings_as_errors = false
use_siso = false
rtc_include_tests = true
rtc_build_tools = false
rtc_build_examples = false
rtc_enable_protobuf = false

# Calls use VP8 (with RTX) and Opus only: no other codec is built, so none can be
# negotiated and no decoder of one is there for what others send.
rtc_use_h264 = false
rtc_use_h265 = false
rtc_libvpx_build_vp9 = false
enable_libaom = false
rtc_include_dav1d_in_internal_decoder_factory = false
