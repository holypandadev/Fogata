# macOS, built for arm64 and for x64 (build-macos.sh adds target_cpu) and joined into one
# framework, as webrtc-sdk's own macOS build.
target_os = "mac"
mac_deployment_target = "12.0"
rtc_include_tests = false
rtc_enable_symbol_export = true
use_rtti = true
enable_dsyms = false
enable_stripping = true
