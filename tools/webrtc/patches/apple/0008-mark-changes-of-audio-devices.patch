Mark changes of audio devices in the macOS audio engine device

WebRTC patch 0011 makes the echo controller anew at the next start of recording after a
change of audio devices. WebRTC-SDK's AudioEngineDevice, the audio device module of the
macOS framework, marks one (MarkAudioDevicesChanged) when CoreAudio tells of a change of
the system's list of devices or of its default output or input, at once on CoreAudio's
thread (its own handling waits 500 ms, and a microphone turned on within it must know),
and when an output or input other than the current one is chosen. Not marked: an output
switching its data source on the same device (the headphone jack of Macs that show
headphones and internal speakers as one device: it would take a listener on the current
output device itself, followed from device to device, and it could not be tried here);
and the engine's configuration changes, which it may also post as it reconfigures itself,
at every microphone turned on.

diff --git a/modules/audio_device/audio_engine_device.mm b/modules/audio_device/audio_engine_device.mm
index 53a2f59..aaca3ba 100644
--- a/modules/audio_device/audio_engine_device.mm
+++ b/modules/audio_device/audio_engine_device.mm
@@ -247,6 +247,13 @@ AVAudioVoiceProcessingOtherAudioDuckingLevel ToAVDuckingLevel(
 
   for (const AudioObjectPropertyAddress& address :
        webrtc::ArrayView<const AudioObjectPropertyAddress>(addresses, numberAddresses)) {
+    // Fogata: another room maybe (WebRTC patch 0011), told at once, before the
+    // debounced handling, so that a microphone turned on within it knows.
+    if (address.mSelector == kAudioHardwarePropertyDevices ||
+        address.mSelector == kAudioHardwarePropertyDefaultOutputDevice ||
+        address.mSelector == kAudioHardwarePropertyDefaultInputDevice) {
+      MarkAudioDevicesChanged();
+    }
     ptrThis->HandleDeviceListenerEvent(address.mSelector);
   }
 
@@ -902,6 +909,10 @@ AVAudioVoiceProcessingOtherAudioDuckingLevel ToAVDuckingLevel(
 
   // Set as default device if index == 0
   AudioDeviceID output_device_id = index == 0 ? kAudioObjectUnknown : output_device_ids_[index - 1];
+  // Fogata: another output may be another room (WebRTC patch 0011).
+  if (output_device_id != engine_state_.output_device_id) {
+    MarkAudioDevicesChanged();
+  }
 
   int32_t result = ModifyEngineState([output_device_id](EngineState state) -> EngineState {
     state.output_device_id = output_device_id;
@@ -1047,6 +1058,10 @@ AVAudioVoiceProcessingOtherAudioDuckingLevel ToAVDuckingLevel(
 
   // Set as default device if index == 0
   AudioDeviceID input_device_id = index == 0 ? kAudioObjectUnknown : input_device_ids_[index - 1];
+  // Fogata: as for the output (WebRTC patch 0011).
+  if (input_device_id != engine_state_.input_device_id) {
+    MarkAudioDevicesChanged();
+  }
 
   int32_t result = ModifyEngineState([input_device_id](EngineState state) -> EngineState {
     state.input_device_id = input_device_id;
