The desktop capturer captures at the rate asked, as the C++ wrapper's does
(patches/wrapper/0008): the next capture waited the whole interval after the last one
ended, so a capture that took 20 ms made 30 frames a second into 19. It is now due one
interval after the last one began (at once when that is already past, never several to
catch up). Screens are no longer compared frame by frame for an updated region nobody
reads. Every 10 s, WebRTC's log says at the info level how many captures were made and
what one cost.

diff --git a/sdk/objc/native/src/objc_desktop_capture.h b/sdk/objc/native/src/objc_desktop_capture.h
index fee081d..a01c4c0 100644
--- a/sdk/objc/native/src/objc_desktop_capture.h
+++ b/sdk/objc/native/src/objc_desktop_capture.h
@@ -62,6 +62,15 @@ class ObjCDesktopCapturer : public DesktopCapturer::Callback {
   webrtc::DesktopCapturer::SourceId source_id_;
   id<RTC_OBJC_TYPE(RTCDesktopCapturerPrivateDelegate)> delegate_;
   uint32_t capture_delay_ = 1000; // 1s
+  // When the next capture is due (WebRTC's clock, microseconds); 0 before the
+  // first. Used on thread_ only.
+  int64_t next_capture_us_ = 0;
+  // What the captures cost since stats_since_us_, for the log.
+  int64_t stats_since_us_ = 0;
+  int64_t stats_frames_ = 0;
+  int64_t stats_total_us_ = 0;
+  int64_t stats_longest_us_ = 0;
+  void NoteCapture(int64_t took_us, int64_t now_us);
   webrtc::DesktopCapturer::Result result_ = webrtc::DesktopCapturer::Result::SUCCESS;
 };
 
