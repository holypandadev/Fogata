 void ObjCDesktopCapturer::CaptureFrame() {
   RTC_DCHECK_RUN_ON(thread_.get());
-  if (capture_state_ == CS_RUNNING) {
-    capturer_->CaptureFrame();
-    thread_->PostDelayedHighPrecisionTask(
-      [this]() {
-        CaptureFrame();
-      },
-      TimeDelta::Millis(capture_delay_));
+  if (capture_state_ != CS_RUNNING) {
+    return;
+  }
+  const int64_t started = TimeMicros();
+  capturer_->CaptureFrame();
+  const int64_t now = TimeMicros();
+  NoteCapture(now - started, now);
+  // The next capture is due one interval after this one began, not after it
+  // ended: waiting the whole interval after a capture that took 20 ms made 30
+  // frames a second into 19. A capture that took longer than the interval is
+  // followed by the next at once, never by several to catch up.
+  const int64_t interval = int64_t{capture_delay_} * 1000;
+  next_capture_us_ = next_capture_us_ == 0 ? started + interval
+                                           : next_capture_us_ + interval;
+  if (next_capture_us_ < now) {
+    next_capture_us_ = now;
+  }
+  thread_->PostDelayedHighPrecisionTask(
+      [this]() { CaptureFrame(); },
+      TimeDelta::Micros(next_capture_us_ - now));
+}
+
+void ObjCDesktopCapturer::NoteCapture(int64_t took_us, int64_t now_us) {
+  // What capturing a frame costs on this computer (the capturer, the cursor,
+  // the conversion and the hand-over to the encoder), told every 10 s to
+  // WebRTC's log at the info level.
+  if (stats_since_us_ == 0) {
+    stats_since_us_ = now_us;
+  }
+  stats_frames_++;
+  stats_total_us_ += took_us;
+  stats_longest_us_ = std::max(stats_longest_us_, took_us);
+  const int64_t span = now_us - stats_since_us_;
+  if (span < 10'000'000) {
+    return;
   }
+  RTC_LOG(LS_INFO) << "ObjCDesktopCapturer: " << stats_frames_
+                   << " captures in " << span / 1000 << " ms ("
+                   << stats_frames_ * 1'000'000.0 / span
+                   << " a second, asked " << 1000.0 / capture_delay_
+                   << "), " << stats_total_us_ / 1000.0 / stats_frames_
+                   << " ms each on average, longest "
+                   << stats_longest_us_ / 1000.0 << " ms";
+  stats_since_us_ = now_us;
+  stats_frames_ = 0;
+  stats_total_us_ = 0;
+  stats_longest_us_ = 0;
 }
 
 }  // namespace webrtc
