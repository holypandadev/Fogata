-    if (type == kScreen) {
-      capturer_ = std::make_unique<DesktopAndCursorComposer>(
-          webrtc::DesktopCapturer::CreateScreenCapturer(options_), options_);
-    } else {
-      capturer_ = std::make_unique<DesktopAndCursorComposer>(
-          webrtc::DesktopCapturer::CreateWindowCapturer(options_), options_);
+    std::unique_ptr<webrtc::DesktopCapturer> desktop =
+        type == kScreen ? webrtc::DesktopCapturer::CreateScreenCapturer(options_)
+                        : webrtc::DesktopCapturer::CreateWindowCapturer(options_);
+    // WebRTC makes no capturer where it cannot capture this kind of source;
+    // the cursor composer would use it without looking. Start() then fails.
+    if (!desktop) {
+      RTC_LOG(LS_WARNING) << "No capturer for this "
+                          << (type == kScreen ? "screen" : "window");
+      return;
     }
+    capturer_ = std::make_unique<DesktopAndCursorComposer>(std::move(desktop), options_);
   });
 }
 
