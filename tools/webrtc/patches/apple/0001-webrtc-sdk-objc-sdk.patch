+#include <wincrypt.h>
+// clang-format on
+
+#include <memory>
+
+#include "rtc_base/buffer.h"
+#include "rtc_base/logging.h"
+#include "rtc_base/platform_certificate_verifier.h"
+#include "rtc_base/ssl_certificate.h"
