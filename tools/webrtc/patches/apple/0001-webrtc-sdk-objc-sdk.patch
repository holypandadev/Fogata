+
+class ObjCDesktopCapturer : public DesktopCapturer::Callback {
+ public:
+  enum CaptureState { CS_RUNNING, CS_STOPPED, CS_FAILED};
+
+ public:
+  ObjCDesktopCapturer(DesktopType type,
+    webrtc::DesktopCapturer::SourceId source_id,
