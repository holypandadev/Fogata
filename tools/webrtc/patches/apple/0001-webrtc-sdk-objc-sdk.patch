+  // Float32 -> Int16 converter.
+  AudioConverterRef converter_ref_ = nullptr;
+  AVAudioPCMBuffer* converter_buffer_;
+
+  void* configuration_observer_ RTC_GUARDED_BY(thread_) = nullptr;
+};
