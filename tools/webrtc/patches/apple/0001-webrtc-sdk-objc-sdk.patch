+  RTC_OBJC_TYPE(RTCAudioRendererAdapter) *adapter =
+      [[RTC_OBJC_TYPE(RTCAudioRendererAdapter) alloc] initWithNativeRenderer:renderer];
+  [_adapters addObject:adapter];
