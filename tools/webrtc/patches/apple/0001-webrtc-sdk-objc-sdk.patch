+int32_t AudioEngineDevice::EnablePlatformVoiceProcessingPath(bool enable) {
+#if TARGET_OS_SIMULATOR
+  return -1;
+#else
+  RTC_DCHECK_RUN_ON(thread_);
+  if (enable && !engine_state_.platform_voice_processing_allowed) {
+    return -1;
