+// Fogata: the echo model kept at a call's start while the linear filter takes
+// no echo away (Fogata-Aec3KeepEchoModelWhileErleIsLow/margin:<x>,pauses:<y>/):
+// margin, how much louder than the microphone heard over its stationary noise,
+// against the render, it may take the echo to be (energy ratio, from 0, left
+// out and stock AEC3, to 100; default 4: 6 dB); pauses, how far under its
+// average 96 ms of the render may fall and the far end still count as playing
+// without pauses (energy ratio, 0 to 1; default 0.5: 3 dB). A value out of
+// range keeps the default.
+struct KeepEchoModelSettings {
+  float margin = 4.f;
+  float pauses = 0.5f;
+};
+
+KeepEchoModelSettings GetKeepEchoModelSettings(
+    const FieldTrialsView& field_trials) {
+  KeepEchoModelSettings settings;
+  FieldTrialParameter<double> margin("margin", settings.margin);
+  FieldTrialParameter<double> pauses("pauses", settings.pauses);
+  ParseFieldTrial(
+      {&margin, &pauses},
+      field_trials.Lookup("Fogata-Aec3KeepEchoModelWhileErleIsLow"));
+  if (margin.Get() >= 0.0 && margin.Get() <= 100.0) {
+    settings.margin = static_cast<float>(margin.Get());
+  }
+  if (pauses.Get() >= 0.0 && pauses.Get() <= 1.0) {
+    settings.pauses = static_cast<float>(pauses.Get());
+  }
+  return settings;
+}
+
+// Fogata: the linear filter takes echo away once its full-band ERLE reaches
+// 3 dB (log2 1); from then on the echo model is not kept, after realigns too.
+constexpr float kKeepEchoModelErleLog2 = 1.f;
+
+// Fogata: the echo path gain is bounded over a window of the last 1.15 s, in 24
+// parts of 48 ms: the quietest part of the microphone, as if it held all the
+// window, against the render read in the window at least 0.6 s ago, whose echo
+// has reached the microphone within it, once that render is as loud as active
+// render on average over a quarter of its blocks. The quietest part leaves out
+// the person's own words, which pause where an echo of music does not.
+constexpr int kBoundPartBlocks = 12;
+constexpr int kBoundParts = 24;
+constexpr int kBoundWindowBlocks = kBoundParts * kBoundPartBlocks;
+constexpr int kBoundLagBlocks = 3 * kNumBlocksPerSecond / 5;
+
+// Fogata: the echo model is kept only while the far end plays without pauses,
+// as music does: no 96 ms of the render in the window under `pauses` times its
+// average.
+constexpr int kPauseParts = 2;
+
+// Fogata: the microphone's stationary noise: the lowest of its energy smoothed
+// over about 40 ms, held for 1 s, then rising by 5 dB a second. Four times that
+// is taken off each block's energy, so that noise alone leaves nothing.
+constexpr float kCaptureNoiseSmoothing = 0.1f;
+constexpr int kCaptureNoiseHoldBlocks = kNumBlocksPerSecond;
+constexpr float kCaptureNoiseRise = 1.005f;
+constexpr float kCaptureNoiseFactor = 4.f;
+
 }  // namespace
 
