+
+void ResidualEchoEstimator::HandleEchoPathChange(
+    const EchoPathVariability& echo_path_variability) {
+  if (!echo_path_variability.gain_change &&
+      echo_path_variability.delay_change ==
+          EchoPathVariability::DelayAdjustment::kNone) {
+    return;
+  }
+  // The render buffer may read elsewhere now: measure the window again. The
+  // bound measured so far stays, as the room did not change.
+  bound_capture_energy_.fill(0.f);
+  bound_render_energy_.fill(0.f);
+  bound_blocks_ = 0;
+  bound_render_sum_ = 0.0;
+  render_without_pauses_ = false;
+}
+
+void ResidualEchoEstimator::UpdateEchoPathGainBound(
+    const RenderBuffer& render_buffer,
+    std::span<const std::array<float, kFftLengthBy2>> capture) {
+  if (keep_echo_model_margin_ <= 0.f || linear_filter_took_echo_away_) {
+    return;
+  }
+  const Block& render = render_buffer.GetBlock(0);
+  float render_energy = 0.f;
+  for (int ch = 0; ch < render.NumChannels(); ++ch) {
+    for (float x : render.View(/*band=*/0, ch)) {
+      render_energy += x * x;
+    }
+  }
+  float capture_energy = 0.f;
+  for (const auto& y : capture) {
+    float energy = 0.f;
+    for (float v : y) {
+      energy += v * v;
+    }
+    capture_energy = std::max(capture_energy, energy);
+  }
+
+  // The microphone's stationary noise, taken off.
+  capture_smoothed_energy_ =
+      capture_noise_energy_ < 0.f
+          ? capture_energy
+          : capture_smoothed_energy_ +
+                kCaptureNoiseSmoothing *
+                    (capture_energy - capture_smoothed_energy_);
+  if (capture_noise_energy_ < 0.f ||
+      capture_smoothed_energy_ < capture_noise_energy_) {
+    capture_noise_energy_ = capture_smoothed_energy_;
+    capture_noise_hold_blocks_ = 0;
+  } else if (++capture_noise_hold_blocks_ > kCaptureNoiseHoldBlocks) {
+    capture_noise_energy_ *= kCaptureNoiseRise;
+  }
+  capture_energy = std::max(
+      0.f, capture_energy - kCaptureNoiseFactor * capture_noise_energy_);
+
+  // The window: the capture of its blocks, the render of those read at least
+  // kBoundLagBlocks ago.
+  const int slot = bound_blocks_ % kBoundWindowBlocks;
+  if (bound_blocks_ >= kBoundWindowBlocks) {
+    // The block leaving the window was read kBoundWindowBlocks ago.
+    bound_render_sum_ -= bound_render_energy_[slot];
+  }
+  if (bound_blocks_ >= kBoundLagBlocks) {
+    bound_render_sum_ +=
+        bound_render_energy_[(bound_blocks_ - kBoundLagBlocks) %
+                             kBoundWindowBlocks];
+  }
+  bound_capture_energy_[slot] = capture_energy;
+  bound_render_energy_[slot] = render_energy;
+  ++bound_blocks_;
+  // At the end of each part, with a full window; its oldest block is next to
+  // be written over.
+  if (bound_blocks_ < kBoundWindowBlocks ||
+      bound_blocks_ % kBoundPartBlocks != 0) {
+    return;
+  }
+  const int oldest = bound_blocks_ % kBoundWindowBlocks;
+  double quietest_capture = std::numeric_limits<double>::max();
+  for (int part = 0; part < kBoundParts; ++part) {
+    double energy = 0.0;
+    for (int b = 0; b < kBoundPartBlocks; ++b) {
+      energy += bound_capture_energy_[(oldest + part * kBoundPartBlocks + b) %
+                                      kBoundWindowBlocks];
+    }
+    quietest_capture = std::min(quietest_capture, energy);
+  }
+  double render_window = 0.0;
+  double quietest_render = std::numeric_limits<double>::max();
+  for (int part = 0; part < kBoundParts; part += kPauseParts) {
+    double energy = 0.0;
+    for (int b = 0; b < kPauseParts * kBoundPartBlocks; ++b) {
+      energy += bound_render_energy_[(oldest + part * kBoundPartBlocks + b) %
+                                     kBoundWindowBlocks];
+    }
+    render_window += energy;
+    quietest_render = std::min(quietest_render, energy);
+  }
+  render_without_pauses_ =
+      quietest_render >=
+      keep_echo_model_pauses_ * render_window * kPauseParts / kBoundParts;
+
+  const double active_render_energy =
+      static_cast<double>(config_.render_levels.active_render_limit) *
+      config_.render_levels.active_render_limit * kBlockSize *
+      (kBoundWindowBlocks - kBoundLagBlocks) / 4;
+  if (bound_render_sum_ <= active_render_energy) {
+    return;
+  }
+  const float bound = static_cast<float>(keep_echo_model_margin_ *
+                                         quietest_capture * kBoundParts /
+                                         bound_render_sum_);
+  echo_path_gain_bound_ = echo_path_gain_bound_ > 0.f
+                              ? std::min(echo_path_gain_bound_, bound)
+                              : std::max(bound, 1e-10f);
+}
+
+void ResidualEchoEstimator::KeepEchoModelWhileErleIsLow(
+    const AecState& aec_state,
+    const RenderBuffer& render_buffer,
+    std::span<std::array<float, kFftLengthBy2Plus1>> R2,
+    std::span<std::array<float, kFftLengthBy2Plus1>> R2_unbounded) {
+  if (keep_echo_model_margin_ <= 0.f || linear_filter_took_echo_away_ ||
+      echo_path_gain_bound_ <= 0.f || !render_without_pauses_) {
+    return;
+  }
+  const float gain =
+      std::min(GetEchoPathGain(aec_state, /*gain_for_early_reflections=*/true),
+               echo_path_gain_bound_);
+  // As the non-linear branch models the echo.
+  std::array<float, kFftLengthBy2Plus1> X2;
+  EchoGeneratingPower(num_render_channels_, render_buffer.GetSpectrumBuffer(),
+                      config_.echo_model, aec_state.MinDirectPathFilterDelay(),
+                      X2);
+  if (!aec_state.UseStationarityProperties()) {
+    ApplyNoiseGate(config_.echo_model, X2);
+  }
+  for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+    X2[k] -= config_.echo_model.stationary_gate_slope * X2_noise_floor_[k];
+    X2[k] = std::max(0.f, X2[k]) * gain;
+  }
+  for (size_t ch = 0; ch < R2.size(); ++ch) {
+    for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+      R2[ch][k] = std::max(R2[ch][k], X2[k]);
+      R2_unbounded[ch][k] = std::max(R2_unbounded[ch][k], X2[k]);
+    }
+  }
 }
 
