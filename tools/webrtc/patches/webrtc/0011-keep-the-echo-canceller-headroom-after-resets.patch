+        filter_delay_blocks < sane_filter_delay_limit_blocks_) {
       sane_filter_observed_ = true;
       active_blocks_since_sane_filter_ = 0;
     } else if (active_render) {
@@ -216,6 +221,7 @@ class LegacyTransparentModeImpl : public TransparentMode {
 
