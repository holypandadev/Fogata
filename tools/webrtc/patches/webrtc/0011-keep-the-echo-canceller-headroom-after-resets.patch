+        // Fogata: a filter whose direct path lies within 5 blocks of where the
+        // headroom puts the echo, as stock AEC3 with its 2 ms of headroom.
+        sane_filter_delay_limit_blocks_(
+            5 + static_cast<int>(config.delay.delay_headroom_samples / kBlockSize)),
         active_blocks_since_sane_filter_(kBlocksSinceConsistentEstimateInit),
         non_converged_sequence_size_(kBlocksSinceConvergencedFilterInit) {}
 
@@ -155,7 +159,8 @@ class LegacyTransparentModeImpl : public TransparentMode {
     strong_not_saturated_render_blocks_ +=
         active_render && !saturated_capture ? 1 : 0;
 
-    if (any_filter_consistent && filter_delay_blocks < 5) {
