+namespace {
+
+// Fogata: lags (before the headroom of 8 is taken off) two and four blocks
+// after it, reported as 32 and 64 down-sampled samples.
+constexpr size_t kSettledLag = 40;
+constexpr size_t kJumpedLag = 80;
+constexpr size_t kSettledDelay = 32;
+constexpr size_t kJumpedDelay = 64;
+
+std::optional<DelayEstimate> AggregateLag(
+    MatchedFilterLagAggregator& aggregator,
+    size_t lag) {
+  return aggregator.Aggregate(
+      MatchedFilter::LagEstimate(/*lag=*/lag, /*pre_echo_lag=*/lag));
+}
+
+}  // namespace
+
+// Fogata: a settled estimate follows a jump of the echo's delay that nothing
+// marked after kFastJumpEstimates estimates at the new delay, not after the 126
+// it takes to win the histogram.
+TEST(MatchedFilterLagAggregator, SettledEstimateFollowsAnUnmarkedJumpAtOnce) {
+  ApmDataDumper data_dumper(0);
+  EchoCanceller3Config config;
+  MatchedFilterLagAggregator aggregator(&data_dumper, /*max_filter_lag=*/100,
+                                        config.delay);
+  std::optional<DelayEstimate> aggregated_lag;
+  for (int k = 0; k < MatchedFilterLagAggregator::kFastJumpHoldOffBlocks; ++k) {
+    aggregated_lag = AggregateLag(aggregator, kSettledLag);
+  }
+  ASSERT_TRUE(aggregated_lag);
+  EXPECT_EQ(kSettledDelay, aggregated_lag->delay);
+  EXPECT_EQ(DelayEstimate::Quality::kRefined, aggregated_lag->quality);
+
+  for (size_t k = 1; k < MatchedFilterLagAggregator::kFastJumpEstimates; ++k) {
+    aggregated_lag = AggregateLag(aggregator, kJumpedLag + k % 3);
+    ASSERT_TRUE(aggregated_lag);
+    EXPECT_EQ(kSettledDelay, aggregated_lag->delay);
+  }
+  aggregated_lag = AggregateLag(aggregator, kJumpedLag);
+  ASSERT_TRUE(aggregated_lag);
+  EXPECT_EQ(kJumpedDelay, aggregated_lag->delay);
+  EXPECT_EQ(DelayEstimate::Quality::kRefined, aggregated_lag->quality);
+
+  for (int k = 0; k < 300; ++k) {
+    aggregated_lag = AggregateLag(aggregator, kJumpedLag);
+    ASSERT_TRUE(aggregated_lag);
+    EXPECT_EQ(kJumpedDelay, aggregated_lag->delay);
+  }
+}
+
+// Fogata: after a hard reset (a realign for a change of devices) the estimate
+// follows a jump as before until the hold-off has passed.
+TEST(MatchedFilterLagAggregator, NoJumpAtOnceRightAfterAHardReset) {
+  ApmDataDumper data_dumper(0);
+  EchoCanceller3Config config;
+  MatchedFilterLagAggregator aggregator(&data_dumper, /*max_filter_lag=*/100,
+                                        config.delay);
+  for (int k = 0; k < MatchedFilterLagAggregator::kFastJumpHoldOffBlocks; ++k) {
+    AggregateLag(aggregator, kSettledLag);
+  }
+  aggregator.Reset(/*hard_reset=*/true);
+  std::optional<DelayEstimate> aggregated_lag;
+  for (int k = 0; k < 400; ++k) {
+    aggregated_lag = AggregateLag(aggregator, kSettledLag);
+  }
+  ASSERT_TRUE(aggregated_lag);
+  EXPECT_EQ(kSettledDelay, aggregated_lag->delay);
+
+  for (size_t k = 0; k < 3 * MatchedFilterLagAggregator::kFastJumpEstimates;
