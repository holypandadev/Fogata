+// Fogata: an echo whose delay jumps with nothing marked (a device's glitch, a
+// sound server's own buffering) took 126 lag estimates at the new delay to win
+// the 250 of the old one in the histogram (half a second at the least, longer
+// with speech, which gives no estimate in its pauses), the other side's voice
+// coming back meanwhile through filters aligned to the old delay. Once
+// the estimate is settled (a refined candidate, and kFastJumpHoldOffBlocks
+// since the last hard reset), kFastJumpEstimates estimates in a row more than
+// two blocks from the candidate and within a block of each other, with none
+// near the candidate between them, move it there at once: the histograms start
+// over from those estimates, at the lag most of them gave, enough for a refined
+// estimate (the render delay buffer then aligns to it as to any new delay).
+// Around a marked change of devices nothing changes: the realign there resets
+// the estimator hard, and the delays a new device settles through are followed
+// as before for the hold-off.
+bool MatchedFilterLagAggregator::JumpedToNewDelay(const HeadroomLags& lags) {
+  const int candidate = highest_peak_aggregator_.candidate();
+  if (!significant_candidate_found_ || candidate < 0 ||
+      blocks_since_hard_reset_ < kFastJumpHoldOffBlocks ||
+      std::abs(lags.lag - candidate) <= 2 * block_lags_) {
+    jump_lags_.clear();
+    return false;
+  }
+  if (!jump_lags_.empty() &&
+      std::abs(lags.lag - jump_lags_.front().lag) > block_lags_) {
+    jump_lags_.clear();
+  }
+  jump_lags_.push_back(lags);
+  if (jump_lags_.size() < kFastJumpEstimates) {
+    return false;
+  }
+  // The matched filters' peak moves by a lag or two from one estimate to the
+  // next: the histogram starts over at the lag most of them gave, so that the
+  // new delay is refined at once rather than spread over a few lags.
+  int most_given_lag = jump_lags_.front().lag;
+  int most_given_count = 0;
+  for (const HeadroomLags& jump : jump_lags_) {
+    const int count = static_cast<int>(std::count_if(
+        jump_lags_.begin(), jump_lags_.end(),
+        [&](const HeadroomLags& other) { return other.lag == jump.lag; }));
+    if (count > most_given_count) {
+      most_given_lag = jump.lag;
+      most_given_count = count;
+    }
+  }
+  highest_peak_aggregator_.Reset();
+  if (pre_echo_lag_aggregator_ != nullptr) {
+    pre_echo_lag_aggregator_->Reset();
+  }
+  for (const HeadroomLags& jump : jump_lags_) {
+    if (pre_echo_lag_aggregator_ != nullptr) {
+      pre_echo_lag_aggregator_->Aggregate(jump.pre_echo_lag);
+    }
+    highest_peak_aggregator_.Aggregate(most_given_lag);
+  }
+  RTC_LOG(LS_INFO) << "AEC3: echo delay jumped from lag " << candidate << " to "
+                   << highest_peak_aggregator_.candidate()
+                   << " with nothing marked, estimate moved at once";
+  jump_lags_.clear();
+  return true;
 }
 
