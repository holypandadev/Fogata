+// Fogata, patch 0016: as RestartEchoControllerForRecording, after a change of
+// audio devices (EchoControl::RestartForOtherDevices).
+void AudioProcessingImpl::RestartEchoControllerForOtherDevices() {
+  MutexLock lock_render(&mutex_render_);
+  MutexLock lock_capture(&mutex_capture_);
+  device_restarts_seen_ = AudioDeviceRestartsCount().load();
+  devices_seen_ = AudioDevicesChangedCount().load();
+  // With no echo controller and none wanted (the echo canceller off), nothing is
+  // made, as for a device's own restart.
+  if (!submodules_.echo_controller &&
+      !NeedEchoController(config_, !!echo_control_factory_)) {
+    return;
+  }
+  if (submodules_.echo_controller &&
+      submodules_.echo_controller->RestartForOtherDevices()) {
+    RTC_LOG(LS_INFO)
+        << "AudioProcessing: echo controller aligned anew for other devices";
+    return;
+  }
+  RTC_LOG(LS_INFO) << "AudioProcessing: echo controller made anew";
+  InitializeEchoController();
+}
