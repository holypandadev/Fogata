 void AudioState::StartRecordingForCall() {
+  // Fogata, patch 0011: and with the same devices: any change of them seen since
+  // recording last started (MarkAudioDevicesChanged) may have changed the room (a
+  // headset taken off for speakers), and makes it anew.
+  // Fogata, patch 0016: read before recording starts: its first recorded block may
+  // follow a restart the device marked while recording was stopped (patch 0015: a
+  // stream moved), and take the change as handled before this reads it. Read
+  // first, the change counts here, and the restart for other devices follows the
+  // realign; if it comes first, it takes the counts as seen.
+  const uint64_t devices = AudioDevicesChangedCount().load();
+  const uint64_t handled = AudioDevicesHandledCount().load();
   if (config_.audio_device_module->StartRecording() != 0) {
     return;
   }
   const bool same_call = stopped_in_call_;
   stopped_in_call_ = false;
-  // Fogata, patch 0011: and with the same devices: any change of them seen since
-  // recording last started (MarkAudioDevicesChanged) may have changed the room (a
-  // headset taken off for speakers), and makes it anew.
-  const uint64_t devices = AudioDevicesChangedCount().load();
-  const bool same_devices = devices == devices_seen_;
+  // Fogata, patch 0016: a change a device's own restart already handled while
+  // recording ran (patch 0014) is not taken again: the echo controller has heard
+  // the new devices since.
+  const bool same_devices = devices == devices_seen_ || devices == handled;
   devices_seen_ = devices;
   if (!config_.audio_processing) {
     return;
   }
+  // Fogata, patch 0016: after a change of devices, aligned again too, forgetting
+  // only whether there was any echo (AEC3's transparent mode), in place of 0011's
+  // new echo controller, which let the other side through for seconds while it
+  // learned the room and held a headset's microphone down meanwhile.
   if (same_call && same_devices) {
     config_.audio_processing->RestartEchoControllerForRecording();
+  } else if (same_call) {
+    RTC_LOG(LS_INFO) << "AudioState: audio devices changed since recording "
+                        "last started";
+    config_.audio_processing->RestartEchoControllerForOtherDevices();
   } else {
-    if (same_call) {
-      RTC_LOG(LS_INFO) << "AudioState: audio devices changed since recording "
-                          "last started";
-    }
     config_.audio_processing->RestartEchoController();
   }
 }
