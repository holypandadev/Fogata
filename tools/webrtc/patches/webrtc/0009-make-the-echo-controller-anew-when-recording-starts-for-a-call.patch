       }
@@ -189,6 +189,28 @@ void AudioState::UpdateAudioTransportWithSendingStreams() {
                                       max_sample_rate_hz, max_num_channels);
 }
 
+// Fogata: the audio device stops recording when the last stream sending sound
+// goes (the end of a call) and starts again with the first one of the next call,
+// but the audio processing and its echo controller stay. AEC3 kept the last call's
+// alignment of what was played with what is recorded (its render buffer and delay
+// estimate), and playout starting before recording piled played blocks up in it:
+// the other side's first second or two of speech went back to them, until AEC3
+// saw too many played blocks (it checks once a second,
+// buffering.excess_render_detection_interval_blocks) and aligned again. Made anew
+// as recording starts, AEC3 aligns from the delay the audio device reports when
+// the first recorded block reaches it, as at the first call. Only here: a stream
+// added while recording runs (a second connection, a shared screen's sound),
+// muting or replacing a track, and the device itself starting again (a device
+// chosen, a sound server back) leave it as it is.
+void AudioState::StartRecordingForCall() {
+  if (config_.audio_device_module->StartRecording() != 0) {
+    return;
+  }
+  if (config_.audio_processing) {
+    config_.audio_processing->RestartEchoController();
+  }
+}
