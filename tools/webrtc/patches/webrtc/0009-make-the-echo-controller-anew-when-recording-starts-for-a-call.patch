+void AudioProcessingImpl::RestartEchoController() {
+  MutexLock lock_render(&mutex_render_);
+  MutexLock lock_capture(&mutex_capture_);
+  RTC_LOG(LS_INFO) << "AudioProcessing: echo controller made anew";
+  InitializeEchoController();
+}
