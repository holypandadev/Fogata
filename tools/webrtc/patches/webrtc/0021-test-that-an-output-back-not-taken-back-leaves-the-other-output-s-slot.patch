Test that an output back at a moved delay, not taken back, leaves the other output's slot

B, then A (kept at 10 blocks), then A restarted with its echo changed 4 blocks later so its kept
filters fit nowhere and are not taken back, then B: A's filters are kept in A's slot, B's slot
still holds B at its delay, and B is taken back.

diff --git a/modules/audio_processing/aec3/block_processor_unittest.cc b/modules/audio_processing/aec3/block_processor_unittest.cc
index 0c7b737..91fa5ec 100644
--- a/modules/audio_processing/aec3/block_processor_unittest.cc
+++ b/modules/audio_processing/aec3/block_processor_unittest.cc
@@ -682,6 +682,51 @@ TEST(BlockProcessor, OtherOutputFiltersSurviveAnOutputBackAtAnotherDelay) {
   EXPECT_EQ(0, echo_remover.take_backs()[2].shift_samples);
 }
 
+// Fogata: output A restarts and comes back 4 blocks later with its echo changed
+// (in the fake, filters of another echo path: A's kept filters fit nowhere), so
+// nothing is taken back, and the output then changes to B. The filters A
+// learnt anew are kept in A's slot: those of B, kept in the other slot, stay
+// as they are, at their delay, and are taken back for B.
+TEST(BlockProcessor, OtherOutputFiltersSurviveAnOutputBackNotTakenBack) {
+  constexpr int kOutputA = 1;
+  constexpr int kOutputB = 2;
+  // A after the restart: its echo changed, its kept filters do not fit.
+  constexpr int kOutputAChanged = 3;
+  constexpr int kBlocks = 600;
+  KeptFiltersBlockProcessor processor;
+  const FakeKeptFiltersEchoRemover& echo_remover = processor.echo_remover();
+
+  // B, then A: B's filters are kept.
+  processor.SetOutput(kOutputB, 20 * kBlock, 20);
+  processor.Run(kBlocks);
+  processor.Restart(kOutputA, 10 * kBlock, 10);
+  processor.Run(kBlocks);
+  ASSERT_EQ(1u, echo_remover.keeps().size());
+  const size_t slot_b = echo_remover.keeps()[0];
+
+  // A restarts 4 blocks later with its echo changed: its filters are kept in
+  // the other slot, at 10, and are not taken back, at 10 or at 14.
+  processor.Restart(kOutputAChanged, 14 * kBlock, 14);
+  processor.Run(kBlocks);
+  ASSERT_EQ(2u, echo_remover.keeps().size());
+  const size_t slot_a = echo_remover.keeps()[1];
+  ASSERT_NE(slot_a, slot_b);
+  ASSERT_TRUE(echo_remover.take_backs().empty());
+
+  // B: the filters of A are kept in A's slot, and B's, intact at their delay,
+  // are taken back.
+  processor.Restart(kOutputB, 20 * kBlock, 20);
+  processor.Run(kBlocks);
+  ASSERT_EQ(3u, echo_remover.keeps().size());
+  EXPECT_EQ(slot_a, echo_remover.keeps()[2]);
+  ASSERT_TRUE(echo_remover.slot(slot_b));
+  EXPECT_EQ(kOutputB, echo_remover.slot(slot_b)->output);
+  EXPECT_TRUE(processor.TestedAtTheirDelay(slot_b, 20));
+  ASSERT_EQ(1u, echo_remover.take_backs().size());
+  EXPECT_EQ(slot_b, echo_remover.take_backs()[0].slot);
+  EXPECT_EQ(0, echo_remover.take_backs()[0].shift_samples);
+}
+
