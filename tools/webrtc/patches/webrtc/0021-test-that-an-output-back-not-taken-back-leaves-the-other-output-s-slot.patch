+// Fogata: output A restarts and comes back 4 blocks later, its kept filters
+// fitting nowhere (they are not taken back, at the delay they were kept at or
+// at the delay found), and the output then changes to B. The filters A learnt
+// anew are kept in A's slot: those of B, kept in the other slot, stay as they
+// are, at their delay, and are taken back for B.
+TEST(BlockProcessor, OtherOutputFiltersSurviveAnOutputBackNotTakenBack) {
+  constexpr int kOutputA = 1;
+  constexpr int kOutputB = 2;
+  constexpr int kBlocks = 600;
+  KeptFiltersBlockProcessor processor;
+  const FakeKeptFiltersEchoRemover& echo_remover = processor.echo_remover();
+
+  // B, then A: B's filters are kept.
+  processor.SetOutput(kOutputB, 20 * kBlock, 20);
+  processor.Run(kBlocks);
+  processor.Restart(kOutputA, 10 * kBlock, 10);
+  processor.Run(kBlocks);
+  ASSERT_EQ(1u, echo_remover.keeps().size());
+  const size_t slot_b = echo_remover.keeps()[0];
+
+  // A restarts 4 blocks later: its filters are kept in the other slot, at 10,
+  // and do not fit, at 10 or at 14: they are not taken back.
+  processor.world().kept_filters_fit = false;
+  processor.Restart(kOutputA, 14 * kBlock, 14);
+  processor.Run(kBlocks);
+  processor.world().kept_filters_fit = true;
+  ASSERT_EQ(2u, echo_remover.keeps().size());
+  const size_t slot_a = echo_remover.keeps()[1];
+  ASSERT_NE(slot_a, slot_b);
+  ASSERT_TRUE(echo_remover.take_backs().empty());
+
+  // B: the filters of A are kept in A's slot, and B's, intact at their delay,
+  // are taken back.
+  processor.Restart(kOutputB, 20 * kBlock, 20);
+  processor.Run(kBlocks);
+  ASSERT_EQ(3u, echo_remover.keeps().size());
+  EXPECT_EQ(slot_a, echo_remover.keeps()[2]);
+  ASSERT_TRUE(echo_remover.slot(slot_b));
+  EXPECT_EQ(kOutputB, echo_remover.slot(slot_b)->output);
+  EXPECT_TRUE(processor.TestedAtTheirDelay(slot_b, 20));
+  ASSERT_EQ(1u, echo_remover.take_backs().size());
+  EXPECT_EQ(slot_b, echo_remover.take_backs()[0].slot);
+  EXPECT_EQ(0, echo_remover.take_backs()[0].shift_samples);
+}
+
