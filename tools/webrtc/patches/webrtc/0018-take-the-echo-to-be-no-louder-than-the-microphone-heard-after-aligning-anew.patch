+// Fogata: how much louder than the microphone heard, against the render, the
+// echo model may still take the echo to be after the render buffer is aligned
+// anew (energy ratio, 4: 6 dB). Fogata-Aec3EchoPathGainCapAfterAligningAnew/<x>/
+// sets it, from 0 (no cap, stock AEC3) to 100; a value beyond that keeps the
+// default.
+float EchoPathGainCapMargin(const FieldTrialsView& field_trials) {
+  constexpr double kDefault = 4.0;
+  FieldTrialParameter<double> margin(/*key=*/"", kDefault);
+  ParseFieldTrial({&margin}, field_trials.Lookup(
+                                 "Fogata-Aec3EchoPathGainCapAfterAligningAnew"));
+  const double value = margin.Get();
+  return static_cast<float>(value >= 0.0 && value <= 100.0 ? value : kDefault);
+}
+
+// Fogata: how long the capture and render are measured after an alignment
+// anew before the cap holds (0.4 s), and how much render they need: at least
+// as much as active render on average.
+constexpr size_t kEchoPathGainCapBlocks = 2 * kNumBlocksPerSecond / 5;
+
