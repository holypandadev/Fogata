+      echo_path_gain_cap_(std::numeric_limits<float>::max()) {
   Reset();
 }
 
+void ResidualEchoEstimator::HandleAlignedAnew() {
+  blocks_since_aligned_anew_ = 0;
+  capture_energy_since_aligned_anew_ = 0.0;
+  render_energy_since_aligned_anew_ = 0.0;
+  echo_path_gain_cap_ = std::numeric_limits<float>::max();
+}
+
+void ResidualEchoEstimator::UpdateEchoPathGainCap(
+    const AecState& aec_state,
+    const RenderBuffer& render_buffer,
+    std::span<const std::array<float, kFftLengthBy2>> capture) {
+  if (echo_path_gain_cap_margin_ <= 0.f || !aec_state.AligningAnew()) {
+    echo_path_gain_cap_ = std::numeric_limits<float>::max();
+    return;
+  }
+  const Block& render = render_buffer.GetBlock(0);
+  double render_energy = 0.0;
+  for (int ch = 0; ch < render.NumChannels(); ++ch) {
+    for (float x : render.View(/*band=*/0, ch)) {
+      render_energy += x * x;
+    }
+  }
+  double capture_energy = 0.0;
+  for (const auto& y : capture) {
+    double energy = 0.0;
+    for (float v : y) {
+      energy += v * v;
+    }
+    capture_energy = std::max(capture_energy, energy);
+  }
+  ++blocks_since_aligned_anew_;
+  render_energy_since_aligned_anew_ += render_energy;
+  capture_energy_since_aligned_anew_ += capture_energy;
+  const double active_render_energy =
+      static_cast<double>(config_.render_levels.active_render_limit) *
+      config_.render_levels.active_render_limit * kBlockSize *
+      blocks_since_aligned_anew_;
+  if (blocks_since_aligned_anew_ >= kEchoPathGainCapBlocks &&
+      render_energy_since_aligned_anew_ >= active_render_energy) {
+    const double cap = echo_path_gain_cap_margin_ *
+                       capture_energy_since_aligned_anew_ /
+                       render_energy_since_aligned_anew_;
+    echo_path_gain_cap_ =
+        std::min(echo_path_gain_cap_, static_cast<float>(cap));
+  }
+}
+
