+void EchoRemoverImpl::ProcessReference(
+    const EchoPathVariability& echo_path_variability,
+    bool audio_path_changed,
+    bool capture_signal_saturation,
+    const std::optional<DelayEstimate>& external_delay,
+    const RenderBuffer& render_buffer,
+    const Block& x,
+    const Block& y,
+    std::span<const FftData> Y,
+    std::span<const std::array<float, kFftLengthBy2Plus1>> Y2,
+    std::span<const std::array<float, kFftLengthBy2>> y_current,
+    bool clock_drift) {
+  RTC_DCHECK(reference_);
+  RTC_DCHECK_EQ(1, num_capture_channels_);
+  ReferenceChain& r = *reference_;
+
+  r.aec_state.UpdateCaptureSaturation(capture_signal_saturation);
+
+  if (audio_path_changed) {
+    r.subtractor.HandleEchoPathChange(echo_path_variability);
+    r.aec_state.HandleEchoPathChange(echo_path_variability);
+
+    if (echo_path_variability.delay_change !=
+        EchoPathVariability::DelayAdjustment::kNone) {
+      r.suppression_gain.SetInitialState(true);
+    }
+  }
+
+  // Analyze the render signal.
+  r.render_signal_analyzer.Update(render_buffer,
+                                  r.aec_state.MinDirectPathFilterDelay());
+
+  // State transition.
+  if (r.aec_state.TransitionTriggered()) {
+    r.subtractor.ExitInitialState();
+    r.suppression_gain.SetInitialState(false);
+  }
+
+  // Perform linear echo cancellation.
+  r.subtractor.Process(render_buffer, y, r.render_signal_analyzer, r.aec_state,
+                       r.subtractor_output);
+
+  const bool ml_ree_is_active = r.residual_echo_estimator.IsMlReeActive();
+
+  // Compute spectra.
+  bool use_refined_output = true;
+  if (use_coarse_filter_output_ && !ml_ree_is_active) {
+    use_refined_output = UseRefinedOutput(r.subtractor_output[0]);
+  }
+  FormLinearFilterOutput(r.refined_filter_output_last_selected,
+                         use_refined_output, r.subtractor_output[0], r.e[0]);
+  WindowedPaddedFft(fft_, r.e[0], r.e_old[0], &r.E[0]);
+  LinearEchoPower(r.E[0], Y[0], &r.S2_linear[0]);
+  r.E[0].Spectrum(optimization_, r.E2[0]);
+  r.refined_filter_output_last_selected = use_refined_output;
+  const std::span<const std::array<float, kFftLengthBy2Plus1>>
+      nearend_spectrum =
+          r.aec_state.UsableLinearEstimate()
+              ? std::span<const std::array<float, kFftLengthBy2Plus1>>(r.E2)
+              : Y2;
+
+  // Update the AEC state information.
+  r.aec_state.Update(external_delay, r.subtractor.FilterFrequencyResponses(),
+                     r.subtractor.FilterImpulseResponses(), render_buffer,
+                     r.E2, Y2, r.subtractor_output);
+
+  // Choose the linear output.
+  r.use_linear_filter_output = r.aec_state.UseLinearFilterOutput();
+
+  // Estimate the comfort noise.
+  r.cng.Compute(r.aec_state.SaturatedCapture(), nearend_spectrum,
+                r.comfort_noise, r.high_band_comfort_noise);
+
+  // The reference's linear error, as the suppressor gets it.
+  const bool usable_linear_estimate = r.aec_state.UsableLinearEstimate();
+  for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+    const float e2 = usable_linear_estimate ? std::min(r.E2[0][k], Y2[0][k])
+                                            : r.E2[0][k];
+    r.em[k] += kMixErrorSmoothing * (e2 - r.em[k]);
+  }
+
+  if (!capture_output_used_) {
+    r.G.fill(0.f);
+    r.high_bands_gain = 0.f;
+    return;
+  }
+
+  // Estimate the residual echo power.
+  r.residual_echo_estimator.Estimate(
+      r.aec_state, render_buffer, y_current, r.e_old, r.S2_linear, Y2, r.E2,
+      r.suppression_gain.IsDominantNearend(), r.R2, r.R2_unbounded);
+
+  // Suppressor nearend estimate.
+  if (r.aec_state.UsableLinearEstimate()) {
+    // E2 is bound by Y2.
+    std::transform(r.E2[0].begin(), r.E2[0].end(), Y2[0].begin(),
+                   r.E2[0].begin(),
+                   [](float a, float b) { return std::min(a, b); });
+  }
+
+  // Suppressor echo estimate.
+  const std::span<const std::array<float, kFftLengthBy2Plus1>> echo_spectrum =
+      r.aec_state.UsableLinearEstimate()
+          ? std::span<const std::array<float, kFftLengthBy2Plus1>>(r.S2_linear)
+          : std::span<const std::array<float, kFftLengthBy2Plus1>>(r.R2);
+
+  // No neural residual echo estimator: the configured suppressor.
+  const bool config_changed = (ml_ree_is_active != r.ml_ree_was_active);
+  r.ml_ree_was_active = ml_ree_is_active;
+
+  // Compute preferred gains.
+  r.suppression_gain.GetGain(config_.suppressor, config_changed,
+                             nearend_spectrum, echo_spectrum, r.R2,
+                             r.R2_unbounded, r.cng.NoiseSpectrum(),
+                             r.render_signal_analyzer, r.aec_state, x,
+                             clock_drift, &r.high_bands_gain, &r.G);
+}
+
+void EchoRemoverImpl::MixWithReference(
+    const FftData& S,
+    const FftData& comfort_noise,
+    const FftData& high_band_comfort_noise,
+    const FftData& Y,
+    std::array<float, kFftLengthBy2Plus1>* G,
+    float* high_bands_gain) {
+  RTC_DCHECK(reference_);
+  ReferenceChain& r = *reference_;
+  // What the reference chain would output: its gains on its linear output or
+  // on the capture.
+  const FftData& S_ref = r.use_linear_filter_output ? r.E[0] : Y;
+  FftData& S_mix = r.mixed_spectrum[0];
+  FftData& N_mix = r.mixed_comfort_noise[0];
+
+  for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+    const float g = (*G)[k];
+    const float g_ref = r.G[k];
+    const float p = g * g * (S.re[k] * S.re[k] + S.im[k] * S.im[k]);
+    const float p_ref =
+        g_ref * g_ref * (S_ref.re[k] * S_ref.re[k] + S_ref.im[k] * S_ref.im[k]);
+
+    bool use_new;
+    float g_mix = g;
+    if (r.ev[k] > kMixReferenceRatio * r.em[k]) {
+      // This chain's filter is clearly worse: the reference's output.
+      use_new = false;
+    } else if (r.ev[k] > kMixHigherRatio * r.em[k]) {
+      // Alike: the higher of the two, this chain's capped.
+      use_new = p > p_ref;
+      if (use_new && p > kMixNewPowerCap * p_ref) {
+        g_mix = g * std::sqrt(kMixNewPowerCap * p_ref / p);
+      }
+    } else {
+      // This chain's filter is clearly better: the lower of the two.
+      use_new = p < p_ref;
+    }
+
+    if (use_new) {
+      S_mix.re[k] = S.re[k];
+      S_mix.im[k] = S.im[k];
+      N_mix.re[k] = comfort_noise.re[k];
+      N_mix.im[k] = comfort_noise.im[k];
+      (*G)[k] = g_mix;
+    } else {
+      S_mix.re[k] = S_ref.re[k];
+      S_mix.im[k] = S_ref.im[k];
+      N_mix.re[k] = r.comfort_noise[0].re[k];
+      N_mix.im[k] = r.comfort_noise[0].im[k];
+      (*G)[k] = g_ref;
+    }
+  }
+
+  // The high bands, from the errors of bins 1 to 15.
+  float ev_sum = 0.f;
+  float em_sum = 0.f;
+  for (size_t k = kMixHighBandsFirstBin; k <= kMixHighBandsLastBin; ++k) {
+    ev_sum += r.ev[k];
+    em_sum += r.em[k];
+  }
+  bool use_new_high_bands;
+  if (ev_sum > kMixReferenceRatio * em_sum) {
+    use_new_high_bands = false;
+  } else if (ev_sum > kMixHigherRatio * em_sum) {
+    use_new_high_bands = *high_bands_gain > r.high_bands_gain;
+  } else {
+    use_new_high_bands = *high_bands_gain < r.high_bands_gain;
+  }
+  if (use_new_high_bands) {
+    r.mixed_high_band_comfort_noise[0].Assign(high_band_comfort_noise);
+  } else {
+    *high_bands_gain = r.high_bands_gain;
+    r.mixed_high_band_comfort_noise[0].Assign(r.high_band_comfort_noise[0]);
+  }
+}
