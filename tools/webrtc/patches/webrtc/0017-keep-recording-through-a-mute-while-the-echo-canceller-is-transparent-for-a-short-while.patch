+// Fogata, patch 0017: begins keeping recording through a mute
+// (RemoveSendingStream). Everything about the hold is done on this thread,
+// where every other call to the audio device module is made: the checks only
+// read the audio processing's atomic, written by the capture thread after each
+// frame, and the count of device changes. Nothing is added to the capture path.
+// The cap is time on this thread's clock, not recorded frames: it ends the hold
+// even when the device delivers nothing.
+void AudioState::HoldRecording() {
+  RTC_DCHECK(!recording_held_);
+  RTC_DCHECK_GT(hold_ms_, 0);
+  recording_held_ = true;
+  const uint64_t id = ++hold_id_;
+  hold_start_ms_ = TimeMillis();
+  devices_at_hold_ = AudioDevicesChangedCount().load();
+  RTC_LOG(LS_INFO) << "AudioState: recording held: the echo controller is "
+                      "transparent; for up to "
+                   << hold_ms_ << " ms";
+  PostRecordingHoldPoll(id);
+  TaskQueueBase::Current()->PostDelayedTask(
+      SafeTask(hold_safety_.flag(),
+               [this, id] {
+                 RTC_DCHECK_RUN_ON(&worker_thread_checker_);
+                 CapRecordingHold(id);
+               }),
+      TimeDelta::Millis(hold_ms_));
+}
+
+void AudioState::PostRecordingHoldPoll(uint64_t id) {
+  TaskQueueBase::Current()->PostDelayedTask(
+      SafeTask(hold_safety_.flag(),
+               [this, id] {
+                 RTC_DCHECK_RUN_ON(&worker_thread_checker_);
+                 PollRecordingHold(id);
+               }),
+      TimeDelta::Millis(10));
+}
+
+// The hold `id` is the one going on, with nothing sending.
+bool AudioState::RecordingHoldGoesOn(uint64_t id) const {
+  return id == hold_id_ && recording_held_ && sending_streams_.empty();
+}
+
+// Fogata, patch 0017: every 10 ms (a recorded frame) while recording is held:
+// it stops, as recording stopped at the mute before, once the echo controller
+// is no longer transparent (an echo path found: speakers; or the controller
+// made anew) or the audio devices change, after which the unmute takes the
+// devices as changed (patch 0016).
+void AudioState::PollRecordingHold(uint64_t id) {
+  if (!RecordingHoldGoesOn(id)) {
+    return;
+  }
+  if (AudioDevicesChangedCount().load() != devices_at_hold_) {
+    StopHeldRecording("audio devices changed");
+    return;
+  }
+  if (!config_.audio_processing ||
+      !config_.audio_processing->EchoControllerTransparent()) {
+    StopHeldRecording("not transparent");
+    return;
+  }
+  PostRecordingHoldPoll(id);
+}
+
+// Fogata, patch 0017: FOGATA_A1_HOLD_MS after the hold began.
+void AudioState::CapRecordingHold(uint64_t id) {
+  if (!RecordingHoldGoesOn(id)) {
+    return;
+  }
+  StopHeldRecording("cap");
+}
+
+// Fogata, patch 0017: recording stops as at the mute without a hold
+// (RemoveSendingStream): the unmute starts it again in the same call.
+void AudioState::StopHeldRecording(const char* why) {
+  RTC_DCHECK(recording_held_);
+  EndRecordingHold(why, /*stop_recording=*/true);
+  stopped_in_call_ = true;
+}
+
+// Fogata, patch 0017: ends the hold, once, and logs it: its tasks still posted
+// do nothing (hold_id_ moved on). Recording stops here when `stop_recording`;
+// otherwise the caller stops it or keeps it. A change of audio devices since
+// the hold began, even one marked after its last poll, counts at the next
+// start of recording in the call (StartRecordingForCall).
+void AudioState::EndRecordingHold(const char* why, bool stop_recording) {
+  if (!recording_held_) {
+    return;
+  }
+  recording_held_ = false;
+  ++hold_id_;
+  if (AudioDevicesChangedCount().load() != devices_at_hold_) {
+    devices_changed_in_hold_ = true;
+  }
+  if (stop_recording) {
+    config_.audio_device_module->StopRecording();
+  }
+  RTC_LOG(LS_INFO) << "AudioState: held recording "
+                   << (stop_recording ? "stopped" : "ended") << " (" << why
+                   << ") " << TimeMillis() - hold_start_ms_ << " ms";
+}
