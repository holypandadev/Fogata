+// is no longer transparent (an echo path found: speakers; or the controller
+// made anew) or the audio devices change, after which the unmute takes the
+// devices as changed (patch 0016).
+void AudioState::PollRecordingHold(uint64_t id) {
+  if (!RecordingHoldGoesOn(id)) {
+    return;
+  }
+  if (AudioDevicesChangedCount().load() != devices_at_hold_) {
+    StopHeldRecording("audio devices changed");
