+// Fogata, patch 0017: recording kept through a mute while the echo
+// controller is transparent (FOGATA_A1_HOLD_MS). The worker is a task queue of
+// a simulated clock: the hold's 10 ms poll and its cap run in simulated time,
+// and the audio device's StartRecording and StopRecording are counted.
+class TransparentAudioProcessing : public MockAudioProcessing {
+ public:
+  bool EchoControllerTransparent() const override { return transparent; }
+  bool transparent = false;
+};
+
+class AudioStateRecordingHoldTest : public ::testing::Test {
+ protected:
+  AudioStateRecordingHoldTest()
+      : time_(Timestamp::Seconds(1000)),
+        worker_(time_.GetTaskQueueFactory()->CreateTaskQueue(
+            "worker",
+            TaskQueueFactory::Priority::NORMAL)),
+        helper_(ConfigHelper::Params({false, false})),
+        apm_(make_ref_counted<NiceMock<TransparentAudioProcessing>>()) {
+    helper_.config().audio_processing = apm_;
+    adm_ = static_cast<MockAudioDeviceModule*>(
+        helper_.config().audio_device_module.get());
+    ON_CALL(*adm_, StartRecording()).WillByDefault([this] {
+      ++starts_;
+      recording_ = true;
+      return 0;
+    });
+    ON_CALL(*adm_, StopRecording()).WillByDefault([this] {
+      ++stops_;
+      recording_ = false;
+      return 0;
+    });
+    ON_CALL(*adm_, Recording()).WillByDefault([this] { return recording_; });
+    // Read once, as the AudioState is made.
+    const char* old = std::getenv("FOGATA_A1_HOLD_MS");
+    const bool had_old = old != nullptr;
+    const std::string old_value = had_old ? old : "";
+    setenv("FOGATA_A1_HOLD_MS", "200", /*overwrite=*/1);
+    audio_state_ = make_ref_counted<internal::AudioState>(helper_.config());
+    if (had_old) {
+      setenv("FOGATA_A1_HOLD_MS", old_value.c_str(), /*overwrite=*/1);
+    } else {
+      unsetenv("FOGATA_A1_HOLD_MS");
+    }
+  }
+
+  ~AudioStateRecordingHoldTest() override {
+    apm_->transparent = false;
+    OnWorker([this] {
+      if (sending_) {
+        audio_state_->RemoveSendingStream(&send_stream_);
+      }
+      audio_state_->RemoveReceivingStream(&receive_stream_);
+      audio_state_ = nullptr;
+    });
+  }
+
+  // Runs `task` on the worker, now in simulated time.
+  void OnWorker(absl::AnyInvocable<void() &&> task) {
+    worker_->PostTask(std::move(task));
+    time_.AdvanceTime(TimeDelta::Zero());
+  }
+  void AdvanceMs(int ms) { time_.AdvanceTime(TimeDelta::Millis(ms)); }
+
+  // A call that plays and records, then the microphone turned off in it while
+  // the echo controller is transparent: the hold begins, recording goes on.
+  void StartCallAndMuteTransparent() {
+    OnWorker([this] {
+      audio_state_->AddReceivingStream(&receive_stream_);
+      audio_state_->AddSendingStream(&send_stream_, kSampleRate,
+                                     kNumberOfChannels);
+    });
+    sending_ = true;
+    ASSERT_EQ(starts_, 1);
+    ASSERT_TRUE(recording_);
+    apm_->transparent = true;
+    OnWorker([this] { audio_state_->RemoveSendingStream(&send_stream_); });
+    sending_ = false;
+    ASSERT_EQ(stops_, 0) << "the mute stopped recording: no hold";
+    ASSERT_TRUE(recording_);
+  }
+
+  void Unmute() {
+    OnWorker([this] {
+      audio_state_->AddSendingStream(&send_stream_, kSampleRate,
+                                     kNumberOfChannels);
+    });
+    sending_ = true;
+  }
+
+  GlobalSimulatedTimeController time_;
+  std::unique_ptr<TaskQueueBase, TaskQueueDeleter> worker_;
+  ConfigHelper helper_;
+  scoped_refptr<NiceMock<TransparentAudioProcessing>> apm_;
+  MockAudioDeviceModule* adm_ = nullptr;
+  MockAudioReceiveStream receive_stream_;
+  MockAudioSendStream send_stream_;
+  scoped_refptr<internal::AudioState> audio_state_;
+  bool sending_ = false;
+  bool recording_ = false;
+  int starts_ = 0;
+  int stops_ = 0;
+};
+
+TEST_F(AudioStateRecordingHoldTest, CapStopsRecordingOnceAtHoldMs) {
+  StartCallAndMuteTransparent();
+  AdvanceMs(199);
+  EXPECT_EQ(stops_, 0);
+  EXPECT_TRUE(recording_);
+  AdvanceMs(1);
+  EXPECT_EQ(stops_, 1);
+  EXPECT_FALSE(recording_);
+  AdvanceMs(1000);
+  EXPECT_EQ(stops_, 1);
+  EXPECT_EQ(starts_, 1);
+}
+
+TEST_F(AudioStateRecordingHoldTest, UnmuteDuringHoldKeepsRecording) {
+  StartCallAndMuteTransparent();
+  AdvanceMs(150);
+  ASSERT_EQ(stops_, 0);
+  // The unmute restarts the echo controller as any unmute in the call does,
+  // and touches nothing of the audio device.
+  EXPECT_CALL(*apm_, RestartEchoControllerForRecording()).Times(1);
+  Unmute();
+  EXPECT_EQ(stops_, 0);
+  EXPECT_EQ(starts_, 1);
+  EXPECT_TRUE(recording_);
+  // The cap posted for the hold, at 200 ms, finds it over.
+  AdvanceMs(1050);
+  EXPECT_EQ(stops_, 0);
+  EXPECT_EQ(starts_, 1);
+  EXPECT_TRUE(recording_);
+}
+
+TEST_F(AudioStateRecordingHoldTest, PollStopsRecordingWhenNotTransparent) {
+  StartCallAndMuteTransparent();
+  AdvanceMs(50);
+  ASSERT_EQ(stops_, 0);
+  apm_->transparent = false;
+  // The next poll, 10 ms at most.
+  AdvanceMs(10);
+  EXPECT_EQ(stops_, 1);
+  EXPECT_FALSE(recording_);
+  AdvanceMs(1000);
+  EXPECT_EQ(stops_, 1);
+  EXPECT_EQ(starts_, 1);
+}
+
 }  // namespace test
 }  // namespace webrtc
