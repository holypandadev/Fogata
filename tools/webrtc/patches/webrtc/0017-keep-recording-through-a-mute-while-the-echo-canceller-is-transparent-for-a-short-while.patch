+void AudioState::PostRecordingHoldPoll(uint64_t id) {
+  TaskQueueBase::Current()->PostDelayedTask(
+      SafeTask(hold_safety_.flag(),
+               [this, id] {
+                 RTC_DCHECK_RUN_ON(&worker_thread_checker_);
+                 PollRecordingHold(id);
+               }),
+      TimeDelta::Millis(10));
