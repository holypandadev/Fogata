+void AecState::SetFilterReusedAfterRestart(bool reused) {
+  if (reused == filter_reused_) {
+    return;
+  }
+  // Fogata, patch 0017: what the reused filter shows is counted from the block
+  // it comes in use.
+  filter_reused_ = reused;
+  erle_from_before_restart_active_ = false;
+  for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+    reused_filter_y2_[ch].fill(0.f);
+    reused_filter_e2_[ch].fill(0.f);
+    reused_filter_blocks_[ch] = 0;
+  }
+}
+
+void AecState::UpdateErleFromBeforeRestart(
+    std::span<const std::array<float, kFftLengthBy2Plus1>> E2,
+    std::span<const std::array<float, kFftLengthBy2Plus1>> Y2) {
+  // Fogata, patch 0017: blocks the reused filter cancels at least half of
+  // count, each band's power forgotten by kForgetting at each such block; from
+  // kMinBlocks of them on, the ERLE is max(estimator, min(at restart, y2/e2)).
+  constexpr float kMaxResidual = 0.5f;
+  constexpr float kForgetting = 0.98f;
+  constexpr int kMinBlocks = 5;
+  erle_from_before_restart_active_ = false;
+  if (!filter_reused_ || !erle_saved_at_restart_) {
+    return;
+  }
+  RTC_DCHECK_EQ(num_capture_channels_, E2.size());
+  RTC_DCHECK_EQ(num_capture_channels_, Y2.size());
+  for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+    const float e2 = std::accumulate(E2[ch].begin(), E2[ch].end(), 0.f);
+    const float y2 = std::accumulate(Y2[ch].begin(), Y2[ch].end(), 0.f);
+    if (y2 > 0.f && e2 <= kMaxResidual * y2) {
+      for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+        reused_filter_y2_[ch][k] =
+            kForgetting * reused_filter_y2_[ch][k] + Y2[ch][k];
+        reused_filter_e2_[ch][k] =
+            kForgetting * reused_filter_e2_[ch][k] + E2[ch][k];
+      }
+      ++reused_filter_blocks_[ch];
+    }
+    erle_from_before_restart_active_ =
+        erle_from_before_restart_active_ ||
+        reused_filter_blocks_[ch] >= kMinBlocks;
+  }
+  if (!erle_from_before_restart_active_) {
+    return;
+  }
+  const auto erle = erle_estimator_.Erle(/*onset_compensated=*/false);
+  const auto erle_onset_compensated =
+      erle_estimator_.Erle(/*onset_compensated=*/true);
+  const auto erle_unbounded = erle_estimator_.ErleUnbounded();
+  for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+    const bool shown = reused_filter_blocks_[ch] >= kMinBlocks;
+    for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+      const auto from_before = [&](float estimate, float at_restart) {
+        if (!shown) {
+          return estimate;
+        }
+        const float measured =
+            reused_filter_e2_[ch][k] > 0.f
+                ? reused_filter_y2_[ch][k] / reused_filter_e2_[ch][k]
+                : at_restart;
+        return std::max(estimate, std::min(at_restart, measured));
+      };
+      erle_from_before_restart_[ch][k] =
+          from_before(erle[ch][k], erle_at_restart_[ch][k]);
+      erle_onset_compensated_from_before_restart_[ch][k] =
+          from_before(erle_onset_compensated[ch][k],
+                      erle_onset_compensated_at_restart_[ch][k]);
+      erle_unbounded_from_before_restart_[ch][k] =
+          from_before(erle_unbounded[ch][k], erle_unbounded_at_restart_[ch][k]);
+    }
+  }
+}
