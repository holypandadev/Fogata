+// Fogata, patch 0017: a copy of the first `size` partitions of `H` in which
+// partition p is partition p + shift of `H`, zero where that is outside them.
+std::vector<std::vector<FftData>> ShiftedPartitions(
+    const std::vector<std::vector<FftData>>& H,
+    size_t size,
+    int shift) {
+  std::vector<std::vector<FftData>> shifted(H.size(),
+                                            std::vector<FftData>(H[0].size()));
+  for (auto& H_p : shifted) {
+    for (auto& H_p_ch : H_p) {
+      H_p_ch.Clear();
+    }
+  }
+  const int num_partitions = static_cast<int>(std::min(size, H.size()));
+  for (int p = 0; p < num_partitions; ++p) {
+    const int source = p + shift;
+    if (source >= 0 && source < num_partitions) {
+      shifted[p] = H[source];
+    }
+  }
+  return shifted;
+}
