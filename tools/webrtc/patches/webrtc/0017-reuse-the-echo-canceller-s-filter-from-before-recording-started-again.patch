+void Subtractor::StartFilterReuseTrial() {
+  RTC_DCHECK_EQ(saved_filters_.size(), num_capture_channels_);
+  reuse_candidates_.clear();
+  reuse_candidates_.resize(2 * kReuseMaxShiftPartitions + 1);
+  for (int k = 0; k < static_cast<int>(reuse_candidates_.size()); ++k) {
+    ReuseCandidate& candidate = reuse_candidates_[k];
+    candidate.shift = k - kReuseMaxShiftPartitions;
+    candidate.H.resize(num_capture_channels_);
+    for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+      candidate.H[ch] = ShiftedPartitions(
+          saved_filters_[ch], saved_size_partitions_, candidate.shift);
+    }
+    candidate.sy.assign(num_capture_channels_, 0.f);
+    candidate.ss.assign(num_capture_channels_, 0.f);
+  }
+  reuse_trial_yy_.assign(num_capture_channels_, 0.f);
+  reuse_trial_blocks_ = 0;
+  reuse_trial_active_ = true;
+}
+
+void Subtractor::UpdateFilterReuseTrial(const RenderBuffer& render_buffer,
+                                        const Block& capture) {
+  if (!reuse_trial_active_) {
+    return;
+  }
+  // Only blocks with enough capture count.
+  float y2 = 0.f;
+  for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+    std::span<const float> y = capture.View(/*band=*/0, ch);
+    for (float y_k : y) {
+      y2 += y_k * y_k;
+    }
+  }
+  if (y2 <= kReuseMinTrialPower) {
+    return;
+  }
+
+  // Each candidate's echo estimate, and its sums against the capture.
+  constexpr float kScale = 1.0f / kFftLengthBy2;
+  std::array<float, kFftLength> s;
+  FftData S;
+  for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+    std::span<const float> y = capture.View(/*band=*/0, ch);
+    for (float y_k : y) {
+      reuse_trial_yy_[ch] += y_k * y_k;
+    }
+    for (ReuseCandidate& candidate : reuse_candidates_) {
+      ApplyFilter(render_buffer, saved_size_partitions_, candidate.H[ch], &S);
+      fft_.Ifft(S, &s);
+      for (size_t k = 0; k < kBlockSize; ++k) {
+        const float s_k = kScale * s[k + kFftLengthBy2];
+        candidate.sy[ch] += s_k * y[k];
+        candidate.ss[ch] += s_k * s_k;
+      }
+    }
+  }
+  if (++reuse_trial_blocks_ < kReuseTrialBlocks) {
+    return;
+  }
+  reuse_trial_active_ = false;
+
+  // The candidate leaving the least of the capture, each channel's estimate
+  // scaled by its gain (sy/ss, clamped to +-kReuseMaxTrialGain).
+  const auto gain = [](float sy, float ss) {
+    return ss > 0.f
+               ? SafeClamp(sy / ss, -kReuseMaxTrialGain, kReuseMaxTrialGain)
+               : 0.f;
+  };
+  float yy = 0.f;
+  for (float yy_ch : reuse_trial_yy_) {
+    yy += yy_ch;
+  }
+  const ReuseCandidate* best = nullptr;
+  float best_residual = 0.f;
+  for (const ReuseCandidate& candidate : reuse_candidates_) {
+    float e2 = 0.f;
+    for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+      const float g = gain(candidate.sy[ch], candidate.ss[ch]);
+      e2 += std::max(reuse_trial_yy_[ch] - 2.f * g * candidate.sy[ch] +
+                         g * g * candidate.ss[ch],
+                     0.f);
+    }
+    const float residual = yy > 0.f ? e2 / yy : 1.f;
+    if (!best || residual < best_residual) {
+      best = &candidate;
+      best_residual = residual;
+    }
+  }
+  RTC_DCHECK(best);
+  bool reuse = best_residual < kReuseMaxResidual;
+  for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+    const float g = gain(best->sy[ch], best->ss[ch]);
+    reuse = reuse && g >= 1.f / kReuseMaxGain && g <= kReuseMaxGain;
+  }
+  if (reuse) {
+    // In use from this block on: both filters take it, scaled.
+    for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+      const float g = gain(best->sy[ch], best->ss[ch]);
+      refined_filters_[ch]->SetSizePartitions(saved_size_partitions_, true);
+      refined_filters_[ch]->SetFilter(saved_size_partitions_, best->H[ch]);
+      refined_filters_[ch]->ScaleFilter(g);
+      coarse_filter_[ch]->SetFilter(saved_size_partitions_, best->H[ch]);
+      coarse_filter_[ch]->ScaleFilter(g);
+      UpdateRefinedImpulseResponse(ch);
+      filter_misadjustment_estimators_[ch].Reset();
+      poor_coarse_filter_counters_[ch] = 0;
+    }
+    filter_reused_ = true;
+    RTC_LOG(LS_INFO) << "AEC3: filter from before recording started again "
+                        "reused, shifted by "
+                     << best->shift << " partitions, gain "
+                     << gain(best->sy[0], best->ss[0]) << ", residual "
+                     << best_residual << ", "
+                     << blocks_since_restart_ << " blocks after the restart";
+  }
+  reuse_candidates_.clear();
+  reuse_trial_yy_.clear();
+}
+
+void Subtractor::EndFilterReuse(bool forget) {
+  filter_reused_ = false;
+  reuse_trial_active_ = false;
+  reuse_candidates_.clear();
+  reuse_trial_yy_.clear();
+  if (forget) {
+    saved_filters_.clear();
+    saved_size_partitions_ = 0;
+  }
+}
+
+void Subtractor::ShiftFilters(int shift) {
+  for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+    const size_t refined_size = refined_filters_[ch]->SizePartitions();
+    refined_filters_[ch]->SetFilter(
+        refined_size,
+        ShiftedPartitions(refined_filters_[ch]->GetFilter(), refined_size,
+                          shift));
+    const size_t coarse_size = coarse_filter_[ch]->SizePartitions();
+    coarse_filter_[ch]->SetFilter(
+        coarse_size, ShiftedPartitions(coarse_filter_[ch]->GetFilter(),
+                                       coarse_size, shift));
+    UpdateRefinedImpulseResponse(ch);
+  }
+}
+
+void Subtractor::UpdateRefinedImpulseResponse(size_t ch) {
+  const size_t size = refined_filters_[ch]->SizePartitions();
+  const std::vector<std::vector<FftData>>& H =
+      refined_filters_[ch]->GetFilter();
+  std::vector<float>& h = refined_impulse_responses_[ch];
+  h.resize(GetTimeDomainLength(static_cast<int>(size)));
+  std::fill(h.begin(), h.end(), 0.f);
+  constexpr float kScale = 1.0f / kFftLengthBy2;
+  std::array<float, kFftLength> h_p;
+  for (size_t p = 0; p < size; ++p) {
+    for (size_t render_ch = 0; render_ch < H[p].size(); ++render_ch) {
+      fft_.Ifft(H[p][render_ch], &h_p);
+      for (size_t k = 0, j = p * kFftLengthBy2; k < kFftLengthBy2; ++k, ++j) {
+        const float h_k = kScale * h_p[k];
+        if (render_ch == 0 || std::fabs(h[j]) < std::fabs(h_k)) {
+          h[j] = h_k;
+        }
+      }
+    }
+  }
+}
