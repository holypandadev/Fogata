+
+PulseWaitLimit::PulseWaitLimit(pa_threaded_mainloop* mainloop, int seconds)
+    : mainloop_(mainloop),
+      api_(LATE(pa_threaded_mainloop_get_api)(mainloop)) {
+  struct timeval when;
+  gettimeofday(&when, nullptr);
+  when.tv_sec += seconds;
+  if (api_ != nullptr) {
+    event_ = api_->time_new(api_, &when, &PulseWaitLimit::OnTime, this);
+  }
+}
+
+PulseWaitLimit::~PulseWaitLimit() {
+  if (event_ != nullptr) {
+    api_->time_free(event_);
+  }
+}
+
+void PulseWaitLimit::OnTime(pa_mainloop_api* /*api*/,
+                            pa_time_event* /*event*/,
+                            const struct timeval* /*when*/,
+                            void* data) {
+  auto* limit = static_cast<PulseWaitLimit*>(data);
+  limit->expired_ = true;
+  LATE(pa_threaded_mainloop_signal)(limit->mainloop_, 0);
+}
+
+bool WaitForPulseOperation(pa_threaded_mainloop* mainloop,
+                           pa_operation* operation,
+                           int timeout_seconds) {
+  if (operation == nullptr) {
+    return false;
+  }
+  bool done = true;
+  {
+    PulseWaitLimit limit(mainloop, timeout_seconds);
+    while (LATE(pa_operation_get_state)(operation) == PA_OPERATION_RUNNING) {
+      if (limit.Expired()) {
+        done = false;
+        break;
+      }
+      LATE(pa_threaded_mainloop_wait)(mainloop);
+    }
+  }
+  if (!done) {
+    RTC_LOG(LS_ERROR) << "PulseAudio did not answer in " << timeout_seconds
+                      << " s";
+    // No callback of it runs after this.
+    LATE(pa_operation_cancel)(operation);
+  }
+  LATE(pa_operation_unref)(operation);
+  return done;
+}
