+// ============================================================================
+//                 Fogata: a sound server that goes away and comes back
+// ============================================================================
+//
+// PipeWire's PulseAudio service, or PulseAudio, restarted while the device runs (as
+// after a system update) left the device's context dead for good: its lists held only
+// the default, and nothing played or recorded until the application restarted. Now:
+// - PulseAudio's mainloop thread sees the context fail (PaContextStateCallbackHandler)
+//   and only posts to the worker thread, where everything else below runs, as every
+//   call of the voice engine does;
+// - LoseServer stops playout and recording, keeping what the voice engine had asked
+//   for (play_wanted_, rec_wanted_), lists no device at all meanwhile, tells the
+//   observer, and tries again;
+// - each try (Reconnect) makes a new context on the same mainloop and connects it
+//   without waiting: 0.5 s after the loss, then after 1, 2 and 4 s, then every 5 s; a
+//   server that takes the connection and does not answer within 5 s is tried again
+//   the same way;
+// - once a context is ready (ServerBack), the chosen output and input are taken
+//   again by their names where they are still listed, else the default, playout and
+//   recording start again as they were, and the observer is told (the application
+//   reads the lists again). What does not start (no device listed yet) is tried again
+//   every second for 5 s, then every 5 s, while the server stays.
+// The worker thread never waits for the server longer than one question (5 s).
+
+int32_t AudioDeviceLinuxPulse::SetObserver(AudioDeviceObserver* observer) {
+  MutexLock lock(&observer_mutex_);
+  observer_ = observer;
+  return 0;
+}
+
+void AudioDeviceLinuxPulse::TellDevicesUpdated() {
+  // Under the lock, so an observer going away (SetObserver(nullptr)) waits for it.
+  MutexLock lock(&observer_mutex_);
+  if (observer_ != nullptr) {
+    observer_->OnDevicesUpdated();
+  }
+}
+
+void AudioDeviceLinuxPulse::PostToWorker(absl::AnyInvocable<void() &&> task,
+                                         TimeDelta delay) {
+  if (worker_ == nullptr) {
+    return;
+  }
+  absl::AnyInvocable<void() &&> safe =
+      SafeTask(task_safety_.flag(), std::move(task));
+  if (delay.IsZero()) {
+    worker_->PostTask(std::move(safe));
+  } else {
+    worker_->PostDelayedTask(std::move(safe), delay);
+  }
+}
+
+void AudioDeviceLinuxPulse::OnContextState() {
+  RTC_DCHECK(thread_checker_.IsCurrent());
+  if (!_initialized || _paMainloop == nullptr || _paContext == nullptr) {
+    return;
+  }
+  PaLock();
+  const pa_context_state_t state = LATE(pa_context_get_state)(_paContext);
+  PaUnLock();
+  if (connected_) {
+    if (!PA_CONTEXT_IS_GOOD(state)) {
+      LoseServer();
+    }
+    return;
+  }
+  if (state == PA_CONTEXT_READY) {
+    ServerBack();
+  } else if (!PA_CONTEXT_IS_GOOD(state)) {
+    // No server there yet.
+    TryAgainLater();
+  }
+}
+
+void AudioDeviceLinuxPulse::LoseServer() {
+  RTC_DCHECK(thread_checker_.IsCurrent());
+  RTC_LOG(LS_WARNING) << "PulseAudio sound server lost: connecting again";
+  connected_ = false;
+  reconnect_tries_ = 0;
+  // Stopped by the device itself: what the voice engine asked for stays wanted.
+  restoring_ = true;
+  StopPlayout();
+  StopRecording();
+  restoring_ = false;
+  // The server's own indices of the devices mean nothing to the next one.
+  _mixerManager.CloseSpeaker();
+  _mixerManager.CloseMicrophone();
+  TryAgainLater();
+  TellDevicesUpdated();
+}
+
+void AudioDeviceLinuxPulse::TryAgainLater() {
+  RTC_DCHECK(thread_checker_.IsCurrent());
+  // A try still under way, and its time limit, no longer count.
+  const int attempt = ++connection_;
+  const TimeDelta delay = ReconnectDelay(reconnect_tries_++);
+  RTC_LOG(LS_INFO) << "PulseAudio: trying again in " << delay.ms() << " ms";
+  PostToWorker([this, attempt] { Reconnect(attempt); }, delay);
+}
+
+void AudioDeviceLinuxPulse::Reconnect(int attempt) {
+  RTC_DCHECK(thread_checker_.IsCurrent());
+  if (attempt != connection_ || !_initialized || connected_) {
+    return;
+  }
+  PaLock();
+  pa_context* fresh =
+      LATE(pa_context_new)(_paMainloopApi, "WEBRTC VoiceEngine");
+  if (fresh != nullptr) {
+    // Nothing holds the dead context any more: its streams went in LoseServer, and
+    // the mixer is given the new one below. Its own disconnect tells nothing.
+    if (_paContext != nullptr) {
+      LATE(pa_context_set_state_callback)(_paContext, nullptr, nullptr);
+      LATE(pa_context_disconnect)(_paContext);
+      LATE(pa_context_unref)(_paContext);
+    }
+    _paContext = fresh;
+    _paStateChanged = false;
+    LATE(pa_context_set_state_callback)(_paContext, PaContextStateCallback,
+                                        this);
+    // Never starts a server of its own. Connecting does not wait for the server:
+    // the state callback tells how it went.
+    if (LATE(pa_context_connect)(_paContext, nullptr, PA_CONTEXT_NOAUTOSPAWN,
+                                 nullptr) != PA_OK) {
+      RTC_LOG(LS_INFO) << "PulseAudio: no server to connect to yet";
+    }
+  }
+  PaUnLock();
+  if (fresh == nullptr) {
+    RTC_LOG(LS_ERROR) << "could not create context";
+    TryAgainLater();
+    return;
+  }
+  _mixerManager.SetPulseAudioObjects(_paMainloop, _paContext);
+  // A server that takes the connection and does not answer is tried again.
+  PostToWorker(
+      [this, attempt] {
+        if (attempt != connection_ || !_initialized || connected_) {
+          return;
+        }
+        RTC_LOG(LS_WARNING) << "PulseAudio sound server did not answer in "
+                            << kPulseConnectTimeoutSec << " s";
+        TryAgainLater();
+      },
+      TimeDelta::Seconds(kPulseConnectTimeoutSec));
+}
+
+void AudioDeviceLinuxPulse::ServerBack() {
+  RTC_DCHECK(thread_checker_.IsCurrent());
+  // The try's time limit no longer counts.
+  ++connection_;
+  connected_ = true;
+  reconnect_tries_ = 0;
+  RTC_LOG(LS_INFO) << "PulseAudio sound server back";
+  _mixerManager.SetPulseAudioObjects(_paMainloop, _paContext);
+  // Another server may run at another rate.
+  InitSamplingFrequency();
+  Restore(0);
+  TellDevicesUpdated();
+}
+
+void AudioDeviceLinuxPulse::Restore(int round) {
+  RTC_DCHECK(thread_checker_.IsCurrent());
+  if (!_initialized || !connected_) {
+    return;
+  }
+  bool failed = false;
+  restoring_ = true;
+  if (play_wanted_ != Wanted::kNo && !_playing) {
+    // The chosen output where it is still listed, else the default.
+    _outputDeviceIndex =
+        play_name_.empty() ? uint16_t{0} : DeviceIndexOf(false, play_name_);
+    if (InitPlayout() != 0 ||
+        (play_wanted_ == Wanted::kStarted && StartPlayout() != 0)) {
+      failed = true;
+    }
+  }
+  if (rec_wanted_ != Wanted::kNo && !_recording) {
+    _inputDeviceIndex =
+        rec_name_.empty() ? uint16_t{0} : DeviceIndexOf(true, rec_name_);
+    if (InitRecording() != 0 ||
+        (rec_wanted_ == Wanted::kStarted && StartRecording() != 0)) {
+      failed = true;
+    }
+  }
+  restoring_ = false;
+  if (failed) {
+    const TimeDelta delay = RestoreDelay(round);
+    RTC_LOG(LS_WARNING) << "PulseAudio: playout or recording did not start "
+                           "again; trying in "
+                        << delay.ms() << " ms";
+    const int connection = connection_;
+    PostToWorker(
+        [this, connection, round] {
+          if (connection == connection_) {
+            Restore(round + 1);
+          }
+        },
+        delay);
+  }
+}
+
+std::string AudioDeviceLinuxPulse::DeviceNameAt(bool recDevice,
+                                                uint16_t index) {
+  if (index == 0) {
+    return std::string();
+  }
+  char name[kAdmMaxDeviceNameSize] = {0};
+  // The list's callbacks copy the name of the device at _deviceIndex into
+  // _recDeviceName or _playDeviceName, which the audio threads also use (with the
+  // lock held) as they start.
+  MutexLock lock(&mutex_);
+  char*& wanted = recDevice ? _recDeviceName : _playDeviceName;
+  char* const kept = wanted;
+  wanted = name;
+  _deviceIndex = index;
+  if (recDevice) {
+    RecordingDevices();
+  } else {
+    PlayoutDevices();
+  }
+  _deviceIndex = -1;
+  wanted = kept;
+  return std::string(name);
+}
+
+uint16_t AudioDeviceLinuxPulse::DeviceIndexOf(bool recDevice,
+                                              const std::string& name) {
+  const int16_t count = recDevice ? RecordingDevices() : PlayoutDevices();
+  for (int16_t i = 1; i < count; ++i) {
+    if (DeviceNameAt(recDevice, static_cast<uint16_t>(i)) == name) {
+      return static_cast<uint16_t>(i);
+    }
+  }
+  return 0;
+}
