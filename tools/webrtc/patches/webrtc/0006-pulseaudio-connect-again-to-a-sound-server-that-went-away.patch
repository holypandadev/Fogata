 namespace webrtc {
 
+// Fogata: a time limit for a wait on a PulseAudio threaded mainloop. Made and freed
+// with the mainloop's lock held: it wakes the waiting thread once `seconds` have
+// passed, and Expired() then says so (read with the lock held). A limit that could
+// not be armed counts as expired.
+class PulseWaitLimit {
+ public:
+  PulseWaitLimit(pa_threaded_mainloop* mainloop, int seconds);
+  ~PulseWaitLimit();
+
+  PulseWaitLimit(const PulseWaitLimit&) = delete;
+  PulseWaitLimit& operator=(const PulseWaitLimit&) = delete;
+
+  bool Expired() const { return expired_ || event_ == nullptr; }
+
+ private:
+  static void OnTime(pa_mainloop_api* api,
+                     pa_time_event* event,
+                     const struct timeval* when,
+                     void* data);
+
+  pa_threaded_mainloop* const mainloop_;
+  pa_mainloop_api* const api_;
+  pa_time_event* event_ = nullptr;
+  bool expired_ = false;
+};
+
+// Fogata: waits on `mainloop`, whose lock the caller holds, until `operation` is
+// done or `timeout_seconds` have passed, then lets go of it (cancelled first if it
+// still runs). A sound server that took the connection and stopped answering held
+// the waiting thread (WebRTC's worker thread, or an audio thread holding the
+// device's lock) for as long as libpulse waits for a reply. A null operation (asked
+// of a context that is not connected) is not waited for. True if it finished.
+bool WaitForPulseOperation(pa_threaded_mainloop* mainloop,
+                           pa_operation* operation,
+                           int timeout_seconds);
