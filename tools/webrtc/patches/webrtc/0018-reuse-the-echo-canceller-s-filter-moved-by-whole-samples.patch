+// Fogata, patch 0018: a copy of the first `size` partitions of `H` whose
+// impulse response is moved by `shift_samples` (0 to kBlockSize - 1): sample n
+// is sample n + shift_samples of `H`'s, zero past its end; with 0, `H` as it
+// is. Each partition holds the 128-point FFT of its 64 taps followed by 64
+// zeros (AdaptiveFirFilter::Constrain), so the response is the first 64
+// samples of each partition's inverse FFT, scaled by 1/64, and the copy's
+// partitions are made back the same way.
+std::vector<std::vector<FftData>> SampleShiftedFilter(
+    const Aec3Fft& fft,
+    const std::vector<std::vector<FftData>>& H,
+    size_t size,
+    int shift_samples) {
+  RTC_DCHECK_GE(shift_samples, 0);
+  RTC_DCHECK_LT(shift_samples, static_cast<int>(kBlockSize));
+  if (shift_samples == 0) {
+    return H;
+  }
+  std::vector<std::vector<FftData>> shifted(H.size(),
+                                            std::vector<FftData>(H[0].size()));
+  for (auto& H_p : shifted) {
+    for (auto& H_p_ch : H_p) {
+      H_p_ch.Clear();
+    }
+  }
+  const size_t num_partitions = std::min(size, H.size());
+  const size_t length = num_partitions * kFftLengthBy2;
+  constexpr float kScale = 1.0f / kFftLengthBy2;
+  std::vector<float> h(length);
+  std::array<float, kFftLength> h_p;
+  for (size_t ch = 0; ch < H[0].size(); ++ch) {
+    for (size_t p = 0; p < num_partitions; ++p) {
+      fft.Ifft(H[p][ch], &h_p);
+      for (size_t k = 0; k < kFftLengthBy2; ++k) {
+        h[p * kFftLengthBy2 + k] = kScale * h_p[k];
+      }
+    }
+    for (size_t p = 0; p < num_partitions; ++p) {
+      for (size_t k = 0; k < kFftLengthBy2; ++k) {
+        const size_t source = p * kFftLengthBy2 + k + shift_samples;
+        h_p[k] = source < length ? h[source] : 0.f;
+      }
+      std::fill(h_p.begin() + kFftLengthBy2, h_p.end(), 0.f);
+      fft.Fft(&h_p, &shifted[p][ch]);
+    }
+  }
+  return shifted;
+}
