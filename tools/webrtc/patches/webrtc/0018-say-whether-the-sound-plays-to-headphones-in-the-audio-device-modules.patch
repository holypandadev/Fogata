+
+void AudioDeviceLinuxPulse::AskPlayoutSink() {
+  // Under the mainloop's lock, or on its thread: the answer comes on that thread
+  // (PaPlayoutSinkCallback), and nothing waits for it.
+  if (playout_sink_stream_ == nullptr) {
+    return;
+  }
+  const uint32_t index =
+      LATE(pa_stream_get_device_index)(playout_sink_stream_);
+  if (index == PA_INVALID_INDEX) {
+    return;
+  }
+  pa_operation* op = LATE(pa_context_get_sink_info_by_index)(
+      _paContext, index, PaPlayoutSinkCallback, this);
+  if (op != nullptr) {
+    LATE(pa_operation_unref)(op);
+  }
+}
+
+void AudioDeviceLinuxPulse::PaPlayoutSinkCallback(pa_context* /*c*/,
+                                                  const pa_sink_info* i,
+                                                  int eol,
+                                                  void* pThis) {
+  if (eol == 0 && i != nullptr) {
+    static_cast<AudioDeviceLinuxPulse*>(pThis)->NotePlayoutSink(i);
+  }
+}
+
+void AudioDeviceLinuxPulse::NotePlayoutSink(const pa_sink_info* i) {
+  // On the mainloop thread. Only the sink the playout plays on now: an answer
+  // about the one it left, or after playout stopped, changes nothing.
+  if (playout_sink_stream_ == nullptr ||
+      LATE(pa_stream_get_device_index)(playout_sink_stream_) != i->index) {
+    return;
+  }
+  const char* port = i->active_port != nullptr && i->active_port->name != nullptr
+                         ? i->active_port->name
+                         : "";
+  int type = -1;  // Not known.
+#if PA_CHECK_VERSION(14, 0, 0)
+  if (i->active_port != nullptr && PortTypesKnown()) {
+    type = static_cast<int>(i->active_port->type);
+  }
+#endif
+  const char* form = i->proplist != nullptr
+                         ? LATE(pa_proplist_gets)(i->proplist,
+                                                  PA_PROP_DEVICE_FORM_FACTOR)
+                         : nullptr;
+  const std::string form_factor = form != nullptr ? form : "";
+  bool headphones = form_factor == "headphone" || form_factor == "headset";
+#if PA_CHECK_VERSION(14, 0, 0)
+  headphones = headphones || type == PA_DEVICE_PORT_TYPE_HEADPHONES ||
+               type == PA_DEVICE_PORT_TYPE_HEADSET;
+#endif
+  PlayoutToHeadphones().store(headphones, std::memory_order_relaxed);
+  // Logged when it is new: at a start of playout, a move, a change of the sink's
+  // port; not again for the sink's other changes (its volume).
+  std::string note = std::string(i->name != nullptr ? i->name : "") + "|" +
+                     std::to_string(i->index) + "|" + port + "|" +
+                     std::to_string(type) + "|" + form_factor + "|" +
+                     (headphones ? "1" : "0");
+  if (note == playout_sink_note_) {
+    return;
+  }
+  playout_sink_note_ = std::move(note);
+  RTC_LOG(LS_INFO) << "PulseAudio: playout on sink "
+                   << (i->name != nullptr ? i->name : "") << " (" << i->index
+                   << "), port " << (*port != '\0' ? port : "none")
+                   << " (type "
+                   << (type >= 0 ? std::to_string(type) : std::string("unknown"))
+                   << "), form factor "
+                   << (form_factor.empty() ? "none" : form_factor)
+                   << ": sound to headphones " << (headphones ? "yes" : "no");
 }
 
