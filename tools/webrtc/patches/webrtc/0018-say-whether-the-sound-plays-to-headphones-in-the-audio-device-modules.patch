+// Fogata: whether the render endpoint `device` is headphones or a headset, by its
+// form factor (PKEY_AudioEndpoint_FormFactor: Headphones or Headset); false when
+// it says something else or nothing. Sets PlayoutToHeadphones and logs it.
+void NotePlayoutFormFactor(IMMDevice* device, const char* why) {
+  std::string name = "unknown";
+  std::string form = "unknown";
+  bool headphones = false;
+  IPropertyStore* props = nullptr;
+  if (device != nullptr &&
+      SUCCEEDED(device->OpenPropertyStore(STGM_READ, &props))) {
+    PROPVARIANT value;
+    PropVariantInit(&value);
+    if (SUCCEEDED(props->GetValue(PKEY_Device_FriendlyName, &value)) &&
+        value.vt == VT_LPWSTR && value.pwszVal != nullptr) {
+      name = ToUtf8(value.pwszVal);
+    }
+    PropVariantClear(&value);
+    if (SUCCEEDED(props->GetValue(PKEY_AudioEndpoint_FormFactor, &value)) &&
+        value.vt == VT_UI4) {
+      const ULONG factor = value.ulVal;
+      headphones = factor == static_cast<ULONG>(Headphones) ||
+                   factor == static_cast<ULONG>(Headset);
+      form = std::to_string(factor);
+      if (factor == static_cast<ULONG>(Speakers)) {
+        form += " (speakers)";
+      } else if (factor == static_cast<ULONG>(Headphones)) {
+        form += " (headphones)";
+      } else if (factor == static_cast<ULONG>(Headset)) {
+        form += " (headset)";
+      }
+    }
+    PropVariantClear(&value);
+    props->Release();
+  }
+  PlayoutToHeadphones().store(headphones, std::memory_order_relaxed);
+  RTC_LOG(LS_INFO) << "Core Audio: playout on endpoint " << name
+                   << ", form factor " << form << " (" << why
+                   << "): sound to headphones " << (headphones ? "yes" : "no");
+}
 }  // namespace
 
