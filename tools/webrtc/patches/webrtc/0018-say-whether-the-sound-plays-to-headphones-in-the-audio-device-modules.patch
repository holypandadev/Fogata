+AudioDeviceWindowsCore::DeviceStateListener::~DeviceStateListener() {
+  MutexLock lock(&playout_mutex_);
+  SAFE_RELEASE(playout_endpoint_);
+}
+
+void AudioDeviceWindowsCore::DeviceStateListener::SetPlayoutEndpoint(
+    IMMDevice* device) {
+  MutexLock lock(&playout_mutex_);
+  const bool was_playing = playout_endpoint_ != nullptr;
+  SAFE_RELEASE(playout_endpoint_);
+  playout_endpoint_id_.clear();
+  if (device == nullptr) {
+    PlayoutToHeadphones().store(false, std::memory_order_relaxed);
+    if (was_playing) {
+      RTC_LOG(LS_INFO) << "Core Audio: playout stopped: sound to headphones no";
+    }
+    return;
+  }
+  device->AddRef();
+  playout_endpoint_ = device;
+  LPWSTR id = nullptr;
+  if (SUCCEEDED(device->GetId(&id)) && id != nullptr) {
+    playout_endpoint_id_ = id;
+  }
+  CoTaskMemFree(id);
+  NotePlayoutFormFactor(device, "playout started");
+}
