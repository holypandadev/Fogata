 HRESULT AudioDeviceWindowsCore::DeviceStateListener::OnDeviceStateChanged(LPCWSTR pwstrDeviceId, DWORD dwNewState) {
   RTC_DLOG(LS_INFO) << "AudioDeviceWindowsCore::OnDeviceStateChanged => " << pwstrDeviceId << ", NewState => " << dwNewState;
   // Fogata, patch 0011: an endpoint came, went or changed its state.
   MarkAudioDevicesChanged();
+  // Fogata: the playout's endpoint changed its state: its form factor again, or
+  // no sound to headphones while it is not active (unplugged, disabled).
+  {
+    MutexLock lock(&playout_mutex_);
+    if (playout_endpoint_ != nullptr && pwstrDeviceId != nullptr &&
+        _wcsicmp(pwstrDeviceId, playout_endpoint_id_.c_str()) == 0) {
+      if (dwNewState == DEVICE_STATE_ACTIVE) {
+        NotePlayoutFormFactor(playout_endpoint_, "endpoint active again");
+      } else {
+        PlayoutToHeadphones().store(false, std::memory_order_relaxed);
+        RTC_LOG(LS_INFO) << "Core Audio: the playout's endpoint is not active "
+                            "(state "
+                         << dwNewState << "): sound to headphones no";
+      }
+    }
+  }
   if(callback_) callback_->OnDevicesUpdated();
   return S_OK;
 }
