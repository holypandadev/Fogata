 class MatchedFilterTest : public ::testing::TestWithParam<bool> {};
@@ -500,6 +590,60 @@ TEST_P(MatchedFilterTest, LagNotUpdatedForLowLevelRender) {
 
 INSTANTIATE_TEST_SUITE_P(_, MatchedFilterTest, testing::Values(true, false));
 
+// Fogata: once the search's delay is reliable, a capture 7 dB over the lowest
+// fifth of the capture to render ratios of the last 2 s is no longer taken for
+// the near end's talk, while 9 dB still is; before the delay is found, 7 dB
+// still is (more than 6 dB).
+TEST(MatchedFilter, ReliableDelayTakesNearTalkOnlyOverEightDb) {
+  ExactLevelNearTalk call;
+  const float seven_db = ExactLevelNearTalk::kPauseAmplitude *
+                         std::pow(10.f, 7.f / 20.f);
+  const float nine_db = ExactLevelNearTalk::kPauseAmplitude *
+                        std::pow(10.f, 9.f / 20.f);
+
+  // 8 s of talk and pauses with no delay found: past 5 s of render, with the
+  // filters never matching, the hold starts. The talk, 20 dB over the pauses,
+  // is then taken for talk, which shows every other condition met: the hold
+  // is on, 2 s of ratios are in, the capture has pauses (20 dB between its
+  // lowest and highest fifths) and does not follow the render (whose level
+  // never changes).
+  ExactLevelNearTalk::TalkSeen seen =
+      call.TalkAndPauses(2000, /*delay_found=*/false);
+  ASSERT_FALSE(call.filter().GetBestLagEstimate());
+  ASSERT_TRUE(call.filter().NearTalkHeld());
+  ASSERT_TRUE(seen.in_talk);
+  ASSERT_FALSE(seen.in_pause);
+
+  // Before the delay is found, 7 dB over the pauses is talk.
+  for (int k = 0; k < 4; ++k) {
+    call.Step(seven_db, /*delay_found=*/false);
+  }
+  ASSERT_TRUE(call.filter().NearTalkNow());
+
+  // The delay is now reliable; talk 20 dB over the pauses is still talk, and
+  // the pauses are not.
+  seen = call.TalkAndPauses(500, /*delay_found=*/true);
+  ASSERT_TRUE(seen.in_talk);
+  ASSERT_FALSE(seen.in_pause);
+
+  // 7 dB over the pauses is not talk, at any of the 4 sub-blocks it takes to
+  // fill the capture's level.
+  for (int k = 0; k < 4; ++k) {
+    call.Step(seven_db, /*delay_found=*/true);
+    EXPECT_FALSE(call.filter().NearTalkNow()) << "sub-block " << k;
+  }
+  for (int k = 0; k < 40; ++k) {
+    call.Step(ExactLevelNearTalk::kPauseAmplitude, /*delay_found=*/true);
+  }
+  ASSERT_FALSE(call.filter().NearTalkNow());
+
+  // 9 dB over them is.
+  for (int k = 0; k < 4; ++k) {
+    call.Step(nine_db, /*delay_found=*/true);
+  }
+  EXPECT_TRUE(call.filter().NearTalkNow());
+}
