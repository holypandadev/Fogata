+// Fogata: feeds a matched filter, set up as the second search for the echo's
+// delay is (EchoPathDelayEstimator), a render and a capture of exact levels
+// with no echo of the render in the capture. Every render sample is
+// +-kRenderAmplitude, so the loudest render of 4 sub-blocks within the
+// filters' reach is always the same; every capture sample is +-the amplitude
+// given, so once a level has lasted 4 sub-blocks the capture to render ratio
+// the filter sees is (amplitude / kRenderAmplitude)^2, whatever the kernels.
+// The signs are random, so the filters never match the capture.
+class ExactLevelNearTalk {
+ public:
+  static constexpr size_t kDownSamplingFactor = 4;
+  static constexpr size_t kSubBlockSize = kBlockSize / kDownSamplingFactor;
+  static constexpr float kRenderAmplitude = 1000.f;
+  // 40 dB under the render: the room in the near end's pauses, the lowest
+  // fifth of the ratios.
+  static constexpr float kPauseAmplitude = 10.f;
+  // 20 dB over the pauses.
+  static constexpr float kTalkAmplitude = 100.f;
+
+  ExactLevelNearTalk()
+      : render_buffer_(GetDownSampledBufferSize(kDownSamplingFactor,
+                                                config_.delay.num_filters)),
+        filter_(&data_dumper_,
+                DetectOptimization(),
+                kSubBlockSize,
+                kMatchedFilterWindowSizeSubBlocks,
+                config_.delay.num_filters,
+                kMatchedFilterAlignmentShiftSizeSubBlocks,
+                config_.render_levels.poor_excitation_render_limit,
+                config_.delay.delay_estimate_smoothing,
+                config_.delay.delay_estimate_smoothing_delay_found,
+                config_.delay.delay_candidate_detection_threshold,
+                config_.delay.detect_pre_echo) {
+    for (float& x : render_buffer_.buffer) {
+      x = RandomSign() * kRenderAmplitude;
+    }
+  }
+
+  // One sub-block of render and of capture at `capture_amplitude`;
+  // `delay_found` is what the search's aggregator says of its delay
+  // (MatchedFilterLagAggregator::ReliableDelayFound).
+  void Step(float capture_amplitude, bool delay_found) {
+    for (size_t k = 0; k < kSubBlockSize; ++k) {
+      render_buffer_.DecWriteIndex();
+      render_buffer_.buffer[render_buffer_.write] =
+          RandomSign() * kRenderAmplitude;
+    }
+    render_buffer_.read = render_buffer_.write;
+    std::array<float, kSubBlockSize> capture;
+    for (float& y : capture) {
+      y = RandomSign() * capture_amplitude;
+    }
+    filter_.Update(render_buffer_, capture, delay_found);
+  }
+
+  // The near end talks for 60 sub-blocks and pauses for 40, `num_steps`
+  // sub-blocks in all; returns whether the filter took the capture for talk
+  // at the end of the last talk and of the last pause.
+  struct TalkSeen {
+    bool in_talk = false;
+    bool in_pause = true;
+  };
+  TalkSeen TalkAndPauses(int num_steps, bool delay_found) {
+    TalkSeen seen;
+    for (int k = 0; k < num_steps; ++k) {
+      const bool talk = k % 100 < 60;
+      Step(talk ? kTalkAmplitude : kPauseAmplitude, delay_found);
+      if (k % 100 == 59) {
+        seen.in_talk = filter_.NearTalkNow();
+      } else if (k % 100 == 99) {
+        seen.in_pause = filter_.NearTalkNow();
+      }
+    }
+    return seen;
+  }
+
+  const MatchedFilter& filter() const { return filter_; }
+
+ private:
+  float RandomSign() { return random_generator_.Rand(0, 1) ? 1.f : -1.f; }
+
+  const EchoCanceller3Config config_;
+  ApmDataDumper data_dumper_{0};
+  Random random_generator_{42U};
+  DownsampledRenderBuffer render_buffer_;
+  MatchedFilter filter_;
+};
