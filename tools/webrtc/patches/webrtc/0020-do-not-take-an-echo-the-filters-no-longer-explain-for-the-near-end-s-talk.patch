@@ -412,9 +412,41 @@ void SuppressionGain::GetGain(
           ? residual_echo_spectrum_unbounded
           : residual_echo_spectrum;
 
+  // Fogata: when the echo path changes in a call, the filters no longer fit
+  // it and the refined filter adds energy, while the residual echo estimate,
+  // scaled by an ERLE learnt before the change, falls far below the echo left
+  // in the nearend signal. The dominant nearend detector then takes that echo
+  // for the nearend's talk and lets it through. When the refined filter adds
+  // energy and the linear echo estimate says more echo than the nearend holds
+  // in the detector's bands, in a good share of the latest blocks (in double
+  // talk this comes in single blocks), the echo is not counted as nearend: an
+  // echo as strong as the nearend neither starts nor ends the nearend state.
+  bool unexplained_echo = false;
+  if (refined_filter_adds_energy_) {
+    for (size_t ch = 0; ch < nearend_spectrum.size(); ++ch) {
+      const float echo_sum = std::accumulate(echo_spectrum[ch].begin() + 1,
+                                             echo_spectrum[ch].begin() + 16, 0.f);
+      const float nearend_sum =
+          std::accumulate(nearend_spectrum[ch].begin() + 1,
+                          nearend_spectrum[ch].begin() + 16, 0.f);
+      unexplained_echo = unexplained_echo || echo_sum > nearend_sum;
+    }
+  }
+  constexpr float kUnexplainedEchoShareRate = 1.f / 16.f;
+  constexpr float kUnexplainedEchoShareThreshold = 0.15f;
+  unexplained_echo_share_ +=
+      ((unexplained_echo ? 1.f : 0.f) - unexplained_echo_share_) *
+      kUnexplainedEchoShareRate;
+
   // Update the nearend state selection.
-  dominant_nearend_detector_->Update(nearend_spectrum, echo,
-                                     comfort_noise_spectrum, initial_state_);
+  if (unexplained_echo &&
+      unexplained_echo_share_ >= kUnexplainedEchoShareThreshold) {
+    dominant_nearend_detector_->Update(nearend_spectrum, nearend_spectrum,
+                                       comfort_noise_spectrum, initial_state_);
+  } else {
+    dominant_nearend_detector_->Update(nearend_spectrum, echo,
+                                       comfort_noise_spectrum, initial_state_);
