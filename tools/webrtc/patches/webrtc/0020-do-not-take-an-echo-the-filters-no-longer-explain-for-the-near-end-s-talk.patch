+namespace {
+
+// Runs `num_blocks` blocks of a strong nearend (E2) with a weak residual echo
+// estimate, a linear echo estimate (S2) above the nearend, and the refined
+// filter adding energy in the blocks `adds_energy` says, and returns whether
+// the suppressor ends in the dominant nearend state.
+bool EndsInNearendState(int num_blocks,
+                        bool (*adds_energy)(int block)) {
+  constexpr size_t kNumRenderChannels = 1;
+  constexpr size_t kNumCaptureChannels = 1;
+  constexpr int kSampleRateHz = 16000;
+  constexpr size_t kNumBands = NumBandsForRate(kSampleRateHz);
+  EchoCanceller3Config config;
+  SuppressionGain suppression_gain(config, DetectOptimization(), kSampleRateHz,
+                                   kNumCaptureChannels);
+  RenderSignalAnalyzer analyzer(config);
+  AecState aec_state(CreateTestEnvironment(), config, kNumCaptureChannels);
+  Block x(kNumBands, kNumRenderChannels);
+  std::vector<std::array<float, kFftLengthBy2Plus1>> E2(kNumCaptureChannels);
+  std::vector<std::array<float, kFftLengthBy2Plus1>> S2(kNumCaptureChannels);
+  std::vector<std::array<float, kFftLengthBy2Plus1>> R2(kNumCaptureChannels);
+  std::vector<std::array<float, kFftLengthBy2Plus1>> R2_unbounded(
+      kNumCaptureChannels);
+  std::vector<std::array<float, kFftLengthBy2Plus1>> N2(kNumCaptureChannels);
+  E2[0].fill(100.f);
+  S2[0].fill(1000.f);
+  R2[0].fill(0.1f);
+  R2_unbounded[0].fill(0.1f);
+  N2[0].fill(0.f);
+  float high_bands_gain;
+  std::array<float, kFftLengthBy2Plus1> g;
+  for (int k = 0; k < num_blocks; ++k) {
+    suppression_gain.SetRefinedFilterAddsEnergy(adds_energy(k));
+    suppression_gain.GetGain(config.suppressor, /*config_changed=*/false, E2,
+                             S2, R2, R2_unbounded, N2, analyzer, aec_state, x,
+                             /*clock_drift=*/false, &high_bands_gain, &g);
+  }
+  return suppression_gain.IsDominantNearend();
+}
+
+}  // namespace
+
+// Verifies that a strong signal over a weak residual echo estimate is taken for
+// the nearend's talk while the refined filter does not add energy.
+TEST(SuppressionGainTest, NearendDetectedWhileTheRefinedFilterAddsNoEnergy) {
+  EXPECT_TRUE(EndsInNearendState(100, [](int) { return false; }));
+}
+
+// Verifies that the echo left when the refined filter adds energy and the
+// linear echo estimate says more echo than the nearend holds, block after
+// block as after a change of the echo path, is not taken for the nearend.
+TEST(SuppressionGainTest, UnexplainedEchoAfterAnEchoPathChangeIsNoNearend) {
+  EXPECT_FALSE(EndsInNearendState(100, [](int) { return true; }));
+}
+
+// Verifies that single blocks where the refined filter adds energy, as in
+// double talk, leave the nearend detection as it is.
+TEST(SuppressionGainTest, SingleBlocksOfUnexplainedEchoKeepTheNearend) {
+  EXPECT_TRUE(EndsInNearendState(100, [](int k) { return k % 10 == 0; }));
+}
+
+// Verifies that the nearend state ends once the echo is unexplained for long
+// and comes back once the refined filter no longer adds energy.
+TEST(SuppressionGainTest, NearendDetectionComesBackAfterUnexplainedEcho) {
+  EXPECT_TRUE(
+      EndsInNearendState(300, [](int k) { return k >= 100 && k < 200; }));
+}
+
 }  // namespace webrtc
