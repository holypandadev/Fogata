+// Fogata: with the echo's delay jumped J blocks from the delay the render
+// buffer is aligned to, the echo is estimated from the frequency responses kept
+// at the jump's first block applied to the render spectra J - 1, J and J + 1
+// blocks away, E_j[k] = sum_p H2_p[k] * max_c X2_{p+j}[c][k], and the largest
+// of the three bounds S2_linear, R2 and R2_unbounded from below. In the
+// spectrum buffer the read position is the aligned block (offset 0), positive
+// offsets are older blocks (offset p for partition p), and the
+// (read - write + size) % size blocks newer than it, back to the newest written
+// at `write`, are negative offsets; offsets past those or the buffer's size are
+// skipped.
+void EchoRemoverImpl::RaiseForEchoJump(
+    const RenderBuffer& render_buffer,
+    std::span<std::array<float, kFftLengthBy2Plus1>> S2_linear,
+    std::span<std::array<float, kFftLengthBy2Plus1>> R2,
+    std::span<std::array<float, kFftLengthBy2Plus1>> R2_unbounded) const {
+  RTC_DCHECK(echo_jump_blocks_);
+  const SpectrumBuffer& spectrum_buffer = render_buffer.GetSpectrumBuffer();
+  const int size = spectrum_buffer.size;
+  const int num_newer =
+      (spectrum_buffer.read - spectrum_buffer.write + size) % size;
+  const int jump = *echo_jump_blocks_;
+  for (size_t ch = 0; ch < num_capture_channels_; ++ch) {
+    std::array<float, kFftLengthBy2Plus1> r;
+    r.fill(0.f);
+    for (int j = jump - 1; j <= jump + 1; ++j) {
+      std::array<float, kFftLengthBy2Plus1> E_j;
+      E_j.fill(0.f);
+      for (size_t p = 0; p < echo_jump_num_partitions_[ch]; ++p) {
+        const int offset = static_cast<int>(p) + j;
+        // Older than the oldest block kept: offset size - num_newer is the
+        // newest block again (write), so the range ends there.
+        if (offset < -num_newer || offset >= size - num_newer) {
+          continue;
+        }
+        const auto X2 = render_buffer.Spectrum(offset);
+        const auto& H2_p = echo_jump_H2_[ch][p];
+        for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+          float X2_max = 0.f;
+          for (const auto& X2_c : X2) {
+            X2_max = std::max(X2_max, X2_c[k]);
+          }
+          E_j[k] += H2_p[k] * X2_max;
+        }
+      }
+      for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+        r[k] = std::max(r[k], E_j[k]);
+      }
+    }
+    for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+      S2_linear[ch][k] = std::max(S2_linear[ch][k], r[k]);
+      R2[ch][k] = std::max(R2[ch][k], r[k]);
+      R2_unbounded[ch][k] = std::max(R2_unbounded[ch][k], r[k]);
+    }
+  }
+}
