+// Fogata: the recent lags are taken as a jump of the echo's delay that nothing
+// marked when a delay has been reported, the estimate is settled (a
+// significant candidate, 5 s since a hard reset), the window is full, none of
+// its lags is within a block of the reported delay, at least 12 of them are
+// within a block of their median, and the median is more than 8 blocks away
+// from the reported delay.
+void MatchedFilterLagAggregator::UpdateEchoJump() {
+  echo_jump_lag_ = std::nullopt;
+  if (!significant_candidate_found_ || reported_lag_ < 0 ||
+      blocks_since_hard_reset_ < kEchoJumpMinBlocksSinceHardReset ||
+      num_recent_lags_ < kNumRecentLags) {
+    return;
+  }
+  std::array<int, kNumRecentLags> sorted = recent_lags_;
+  std::nth_element(sorted.begin(), sorted.begin() + kNumRecentLags / 2,
+                   sorted.end());
+  const int median = sorted[kNumRecentLags / 2];
+  if (std::abs(median - reported_lag_) <=
+      kEchoJumpMinDistanceBlocks * block_lag_) {
+    return;
+  }
+  int num_near_median = 0;
+  for (int lag : recent_lags_) {
+    if (std::abs(lag - reported_lag_) <= block_lag_) {
+      return;
+    }
+    if (std::abs(lag - median) <= block_lag_) {
+      ++num_near_median;
+    }
+  }
+  if (num_near_median >= kEchoJumpMinLagsNearMedian) {
+    echo_jump_lag_ = median;
+  }
 }
 
