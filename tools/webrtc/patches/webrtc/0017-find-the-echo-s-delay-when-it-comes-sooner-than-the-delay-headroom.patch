 std::optional<DelayEstimate> RenderDelayControllerImpl::GetDelay(
     const DownsampledRenderBuffer& render_buffer,
-    size_t /* render_delay_buffer_delay */,
+    size_t render_delay_buffer_delay,
     const Block& capture) {
   ++capture_call_counter_;
 
   auto delay_samples = delay_estimator_.EstimateDelay(render_buffer, capture);
 
+  // Fogata: a delay of 0 found from lags shorter than the headroom moves the
+  // buffer only when the echo comes before where the buffer stands now, out of
+  // the linear filter's reach; where the filter still reaches it, the buffer
+  // stays and the filter keeps what it learnt.
+  if (delay_samples && delay_estimator_.ShortDelayFound() &&
+      delay_estimator_.LastShortDelay() / static_cast<int>(kBlockSize) >=
+          static_cast<int>(render_delay_buffer_delay)) {
+    delay_samples = std::nullopt;
+  }
+
   if (delay_samples) {
