+void AdaptiveFirFilter::ShiftPartitions(int k) {
+  const int num_partitions = static_cast<int>(max_size_partitions_);
+  if (k > 0) {
+    for (int p = num_partitions - 1; p >= 0; --p) {
+      for (size_t ch = 0; ch < num_render_channels_; ++ch) {
+        if (p >= k) {
+          H_[p][ch] = H_[p - k][ch];
+        } else {
+          H_[p][ch].Clear();
+        }
+      }
+    }
+  } else if (k < 0) {
+    for (int p = 0; p < num_partitions; ++p) {
+      for (size_t ch = 0; ch < num_render_channels_; ++ch) {
+        if (p - k < num_partitions) {
+          H_[p][ch] = H_[p - k][ch];
+        } else {
+          H_[p][ch].Clear();
+        }
+      }
+    }
+  }
+}
