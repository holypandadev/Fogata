+void FilterAnalyzer::Shift(int k) {
+  const int shift = k * static_cast<int>(kBlockSize);
+  const size_t m = static_cast<size_t>(std::abs(shift));
+  for (size_t ch = 0; ch < h_highpass_.size(); ++ch) {
+    std::vector<float>& h = h_highpass_[ch];
+    if (m >= h.size()) {
+      std::fill(h.begin(), h.end(), 0.f);
+    } else if (shift > 0) {
+      std::copy_backward(h.begin(), h.end() - m, h.end());
+      std::fill(h.begin(), h.begin() + m, 0.f);
+    } else if (shift < 0) {
+      std::copy(h.begin() + m, h.end(), h.begin());
+      std::fill(h.end() - m, h.end(), 0.f);
+    }
+    FilterAnalysisState& st = filter_analysis_states_[ch];
+    const int peak = static_cast<int>(st.peak_index) + shift;
+    st.peak_index = h.empty() ? 0
+                              : static_cast<size_t>(std::clamp(
+                                    peak, 0, static_cast<int>(h.size()) - 1));
+    filter_delays_blocks_[ch] = st.peak_index >> kBlockSizeLog2;
+    st.consistent_filter_detector.Shift(k);
+  }
+  min_filter_delay_blocks_ = *std::min_element(filter_delays_blocks_.begin(),
+                                               filter_delays_blocks_.end());
+}
