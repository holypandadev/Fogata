+// Verifies that shifting the partitions moves each one by the number of blocks
+// given, later or sooner, and clears the partitions that nothing moves into.
+TEST(AdaptiveFirFilterTest, ShiftPartitions) {
+  ApmDataDumper data_dumper(42);
+  constexpr size_t kNumPartitions = 6;
+  constexpr size_t kNumRenderChannels = 2;
+  AdaptiveFirFilter filter(kNumPartitions, kNumPartitions, 250,
+                           kNumRenderChannels, DetectOptimization(),
+                           &data_dumper);
+  std::vector<std::vector<FftData>> H(
+      kNumPartitions, std::vector<FftData>(kNumRenderChannels));
+  for (size_t p = 0; p < kNumPartitions; ++p) {
+    for (size_t ch = 0; ch < kNumRenderChannels; ++ch) {
+      H[p][ch].re.fill(1.f + p + 10.f * ch);
+      H[p][ch].im.fill(-1.f - p - 10.f * ch);
+    }
+  }
+  const auto expect_partition = [&](size_t p, std::optional<size_t> from) {
+    for (size_t ch = 0; ch < kNumRenderChannels; ++ch) {
+      const FftData& h = filter.GetFilter()[p][ch];
+      const float re = from ? 1.f + *from + 10.f * ch : 0.f;
+      const float im = from ? -1.f - *from - 10.f * ch : 0.f;
+      for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+        EXPECT_EQ(re, h.re[k]);
+        EXPECT_EQ(im, h.im[k]);
+      }
+    }
+  };
+
+  filter.SetFilter(kNumPartitions, H);
+  filter.ShiftPartitions(2);
+  for (size_t p = 0; p < kNumPartitions; ++p) {
+    expect_partition(p, p >= 2 ? std::optional<size_t>(p - 2) : std::nullopt);
+  }
+
+  filter.SetFilter(kNumPartitions, H);
+  filter.ShiftPartitions(-3);
+  for (size_t p = 0; p < kNumPartitions; ++p) {
+    expect_partition(p, p + 3 < kNumPartitions
+                            ? std::optional<size_t>(p + 3)
+                            : std::nullopt);
+  }
+
+  filter.SetFilter(kNumPartitions, H);
+  filter.ShiftPartitions(0);
+  for (size_t p = 0; p < kNumPartitions; ++p) {
+    expect_partition(p, p);
+  }
+}
