+// Moves `x` by `samples` (later when positive), the samples left behind
+// starting from zero.
+void ShiftSamples(int samples, std::vector<float>& x) {
+  const size_t m = static_cast<size_t>(std::abs(samples));
+  if (m >= x.size()) {
+    std::fill(x.begin(), x.end(), 0.f);
+  } else if (samples > 0) {
+    std::copy_backward(x.begin(), x.end() - m, x.end());
+    std::fill(x.begin(), x.begin() + m, 0.f);
+  } else if (samples < 0) {
+    std::copy(x.begin() + m, x.end(), x.begin());
+    std::fill(x.end() - m, x.end(), 0.f);
+  }
+}
