+  if (kept.test_blocks < kKeptFiltersEarlyTestBlocks) {
+    return;
+  }
+  const auto correlation = [&](size_t j, size_t l) {
+    return kept.ys[j][l] / std::sqrt((kept.ss[j][l] + 1.0) * (kept.yy + 1.0));
+  };
+  // The lag at which the echo estimate correlates best with the capture.
+  size_t best = kKeptFiltersMaxLag;
+  for (size_t l = 0; l < kKeptFiltersLags; ++l) {
+    if (correlation(0, l) > correlation(0, best)) {
+      best = l;
+    }
+  }
+  kept.lag = static_cast<int>(best) - kKeptFiltersMaxLag;
+  const double scale = kept.ys[0][best] / (kept.ss[0][best] + 1.0);
+  const double echo_to_capture_db =
+      10.0 * std::log10((kept.ss[0][best] + 1.0) / (kept.yy + 1.0));
+  double max_other_correlation = 0.0;
+  for (size_t j = 1; j < kKeptFiltersTestEstimates; ++j) {
+    max_other_correlation =
+        std::max(max_other_correlation, std::fabs(correlation(j, best)));
+  }
+  double side_peak = 0.0;
+  for (size_t l = 0; l < kKeptFiltersLags; ++l) {
+    if (l + kKeptFiltersMinPeakDistance <= best ||
+        l >= best + kKeptFiltersMinPeakDistance) {
+      side_peak = std::max(side_peak, std::fabs(correlation(0, l)));
+    }
+  }
+  const bool fit =
+      scale >= kKeptFiltersMinScale && scale <= kKeptFiltersMaxScale &&
+      std::abs(kept.lag) <= kKeptFiltersMaxLag - kKeptFiltersEdgeLag &&
+      echo_to_capture_db >= kKeptFiltersMinEchoToCaptureDb &&
+      correlation(0, best) >=
+          kKeptFiltersMinCorrelationRatio * max_other_correlation &&
+      side_peak <= (kept.test_at_detected_delay
+                        ? kKeptFiltersMaxSidePeakRatioAtDetectedDelay
+                        : kKeptFiltersMaxSidePeakRatio) *
+                       correlation(0, best);
+  if (kept.test_blocks < kKeptFiltersTestBlocks &&
+      !(fit && correlation(0, best) >= kKeptFiltersMinEarlyCorrelation)) {
+    return;
+  }
+  kept.test = fit ? KeptFiltersTest::kFit : KeptFiltersTest::kNone;
+  RTC_LOG(LS_INFO) << "AEC3: kept filters tested, scale " << scale
+                   << ", echo to capture " << echo_to_capture_db
+                   << " dB, correlation " << correlation(0, best) << " at "
+                   << kept.lag << " samples (" << max_other_correlation
+                   << " at other delays, " << side_peak << " at other lags)"
+                   << (fit ? ", taken back" : "");
+}
