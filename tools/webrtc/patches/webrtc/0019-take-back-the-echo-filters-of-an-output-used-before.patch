+  // with long-lasting tones, such as music, fits at many, and a filter of
+  // another echo path can then fit it as well.
+  static constexpr std::array<int, 5> kKeptFiltersTestOffsets = {0, -6, -4, 4,
+                                                                 6};
+  static constexpr size_t kKeptFiltersTestEstimates =
+      kKeptFiltersTestOffsets.size();
+  // The lags, in samples, at which the test correlates the capture with each
+  // echo estimate: up to two blocks either way, as an output that comes back
+  // can be some milliseconds off. The windows of the offsets meet but do not
+  // overlap.
+  static constexpr int kKeptFiltersMaxLag =
+      kKeptFiltersMaxLagBlocks * static_cast<int>(kBlockSize);
+  static constexpr size_t kKeptFiltersLags = 2 * kKeptFiltersMaxLag + 1;
+  static constexpr size_t kKeptFiltersHistoryBlocks =
+      2 * kKeptFiltersMaxLagBlocks + 1;
+  // The test sums, over its blocks, the capture energy yy and, for the echo
+  // estimate s of the kept refined filter at each offset and each lag l (s
+  // delayed by l samples), s*s and y*s. It sums each block once the echo
+  // estimates of the blocks around it are there.
+  struct KeptFilters {
+    std::vector<std::vector<FftData>> refined;
+    std::vector<std::vector<FftData>> coarse;
+    std::vector<float> refined_impulse_response;
+    size_t refined_partitions = 0;
+    size_t coarse_partitions = 0;
+    KeptFiltersTest test = KeptFiltersTest::kNone;
+    int test_offset = 0;
+    bool test_at_detected_delay = false;
+    int test_blocks = 0;
+    int lag = 0;
+    double yy = 0.0;
+    std::array<std::array<double, kKeptFiltersLags>, kKeptFiltersTestEstimates>
+        ss = {};
+    std::array<std::array<double, kKeptFiltersLags>, kKeptFiltersTestEstimates>
+        ys = {};
+    // The last blocks of each echo estimate and of the capture, with whether
+    // the capture block counts, and how many blocks the test has seen.
+    std::array<std::array<float, kKeptFiltersHistoryBlocks * kBlockSize>,
+               kKeptFiltersTestEstimates>
+        s = {};
+    std::array<std::array<float, kBlockSize>, kKeptFiltersMaxLagBlocks + 1> y =
+        {};
+    std::array<bool, kKeptFiltersMaxLagBlocks + 1> y_counts = {};
+    int seen_blocks = 0;
+  };
+  void TestKeptFilters(const RenderBuffer& render_buffer,
+                       std::span<const float> y,
+                       KeptFilters& kept);
+  std::array<KeptFilters, kKeptFiltersSlots> kept_filters_;
 };
 
 }  // namespace webrtc
