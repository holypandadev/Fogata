+void AecState::InitialState::Exit() {
+  initial_state_ = false;
+  transition_triggered_ = false;
+  // The render counted until the end of the initial state is taken as seen,
+  // so that the next update does not bring the initial state back.
+  const size_t initial_state_blocks =
+      conservative_initial_phase_
+          ? 5 * kNumBlocksPerSecond
+          : static_cast<size_t>(
+                std::ceil(initial_state_seconds_ * kNumBlocksPerSecond));
+  strong_not_saturated_render_blocks_ =
+      std::max(strong_not_saturated_render_blocks_, initial_state_blocks);
+}
