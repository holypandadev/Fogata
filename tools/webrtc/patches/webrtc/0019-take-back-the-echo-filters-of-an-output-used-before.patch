+  RTC_LOG(LS_INFO) << "AEC3: kept filters of slot "
+                   << (&kept - &kept_filters_[0]) << " tested, scale " << scale
+                   << ", echo to capture " << echo_to_capture_db
+                   << " dB, correlation " << correlation(0, best) << " at "
+                   << kept.lag << " samples (" << max_other_correlation
+                   << " at other delays, " << side_peak << " at other lags)"
+                   << (fit ? ", fit" : ", do not fit");
