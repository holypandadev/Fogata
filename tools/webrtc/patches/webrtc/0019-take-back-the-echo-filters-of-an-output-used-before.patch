diff --git a/modules/audio_processing/aec3/aec_state_unittest.cc b/modules/audio_processing/aec3/aec_state_unittest.cc
index 807c45c..4832274 100644
--- a/modules/audio_processing/aec3/aec_state_unittest.cc
+++ b/modules/audio_processing/aec3/aec_state_unittest.cc
@@ -308,4 +308,102 @@ TEST(AecState, ConvergedFilterDelay) {
   }
 }
 
+// Fogata: a gain change on the block the ERLE is taken back with kept filters
+// (AecState::UseKeptErle, before HandleEchoPathChange in the echo remover)
+// keeps it; on a later block, it sets the ERLE back as before.
+TEST(AecState, GainChangeKeepsTheErleTakenBackOnItsBlock) {
+  constexpr int kSampleRateHz = 48000;
+  constexpr size_t kNumBands = NumBandsForRate(kSampleRateHz);
+  constexpr size_t kNumChannels = 1;
+  EchoCanceller3Config config;
+  AecState state(CreateTestEnvironment(), config, kNumChannels);
+  std::optional<DelayEstimate> delay_estimate =
+      DelayEstimate(DelayEstimate::Quality::kRefined, 10);
+  std::unique_ptr<RenderDelayBuffer> render_delay_buffer(
+      RenderDelayBuffer::Create(config, kSampleRateHz, kNumChannels));
+  std::vector<std::array<float, kFftLengthBy2Plus1>> E2_refined(kNumChannels);
+  std::vector<std::array<float, kFftLengthBy2Plus1>> Y2(kNumChannels);
+  Block x(kNumBands, kNumChannels);
+  std::array<float, kBlockSize> y;
+  y.fill(1000.f);
+  std::vector<SubtractorOutput> subtractor_output(kNumChannels);
+  subtractor_output[0].Reset();
+  subtractor_output[0].s_refined.fill(100.f);
+  subtractor_output[0].e_refined.fill(100.f);
+  E2_refined[0].fill(0.f);
+  Y2[0].fill(0.f);
+  std::vector<std::vector<std::array<float, kFftLengthBy2Plus1>>>
+      frequency_response(kNumChannels,
+                         std::vector<std::array<float, kFftLengthBy2Plus1>>(
+                             10));
+  for (auto& v : frequency_response[0]) {
+    v.fill(0.01f);
+  }
+  frequency_response[0][2].fill(100.f);
+  frequency_response[0][2][0] = 1.f;
+  std::vector<std::vector<float>> impulse_response(
+      kNumChannels,
+      std::vector<float>(
+          GetTimeDomainLength(config.filter.refined.length_blocks), 0.f));
+  auto update = [&]() {
+    subtractor_output[0].ComputeMetrics(y);
+    state.Update(delay_estimate, frequency_response, impulse_response,
+                 *render_delay_buffer->GetRenderBuffer(), E2_refined, Y2,
+                 subtractor_output);
+  };
+
+  // The ERLE is built up as in NormalUsage.
+  for (size_t band = 0; band < kNumBands; ++band) {
+    std::fill(x.begin(band, 0), x.end(band, 0), 101.f);
+  }
+  for (int k = 0; k < 3000; ++k) {
+    render_delay_buffer->Insert(x);
+    update();
+  }
+  for (int band = 0; band < x.NumBands(); ++band) {
+    std::fill(x.begin(band, 0), x.end(band, 0), 0.f);
+  }
+  x.View(/*band=*/0, /*channel=*/0)[0] = 5000.f;
+  for (size_t k = 0;
+       k < render_delay_buffer->GetRenderBuffer()->GetFftBuffer().size(); ++k) {
+    render_delay_buffer->Insert(x);
+    if (k == 0) {
+      render_delay_buffer->Reset();
+    }
+    render_delay_buffer->PrepareCaptureProcessing();
+  }
+  E2_refined[0].fill(1.f * 10000.f * 10000.f);
+  Y2[0].fill(10.f * E2_refined[0][0]);
+  for (int k = 0; k < 1000; ++k) {
+    update();
+  }
+  const std::array<float, kFftLengthBy2Plus1> erle_kept =
+      state.Erle(/*onset_compensated=*/true)[0];
+  ASSERT_NEAR(4.f, erle_kept[2], 0.1);
+
+  // Kept, set back by a flush, and taken back.
+  state.KeepErle(/*slot=*/0);
+  state.HandleEchoPathChange(EchoPathVariability(
+      false, EchoPathVariability::DelayAdjustment::kBufferFlush, false));
+  ASSERT_EQ(config.erle.min, state.Erle(/*onset_compensated=*/true)[0][2]);
+  state.UseKeptErle(/*slot=*/0);
+
+  // A gain change on the same block keeps it.
+  state.HandleEchoPathChange(EchoPathVariability(
+      true, EchoPathVariability::DelayAdjustment::kNone, false));
+  {
+    const auto& erle = state.Erle(/*onset_compensated=*/true)[0];
+    for (size_t k = 0; k < erle.size(); ++k) {
+      EXPECT_EQ(erle_kept[k], erle[k]) << "bin " << k;
+    }
+  }
+  update();
+  EXPECT_NEAR(4.f, state.Erle(/*onset_compensated=*/true)[0][2], 0.1);
+
+  // A gain change on a later block sets it back.
+  state.HandleEchoPathChange(EchoPathVariability(
+      true, EchoPathVariability::DelayAdjustment::kNone, false));
+  EXPECT_EQ(config.erle.min, state.Erle(/*onset_compensated=*/true)[0][2]);
+}
+
 }  // namespace webrtc
