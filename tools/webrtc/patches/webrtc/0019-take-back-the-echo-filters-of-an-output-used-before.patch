+void AecState::KeepErle(size_t slot) {
+  if (kept_erle_.size() <= slot) {
+    kept_erle_.resize(slot + 1);
+  }
+  kept_erle_[slot] = erle_estimator_.GetState();
+}
+
+void AecState::UseKeptErle(size_t slot) {
+  if (kept_erle_.size() <= slot || !kept_erle_[slot]) {
+    return;
+  }
+  erle_estimator_.SetState(*kept_erle_[slot]);
+  // The kept filters have converged on this echo path: nothing waits for them
+  // to converge again.
+  convergence_needed_since_flush_ = false;
+  initial_state_.Exit();
+}
