+// Fogata: delays the filter H of `partitions` partitions by `shift_samples`
+// (negative: makes it earlier), as its time-domain partitions laid end to end
+// (as AdaptiveFirFilter constrains them).
+void ShiftFilter(const Aec3Fft& fft,
+                 int shift_samples,
+                 size_t partitions,
+                 std::vector<std::vector<FftData>>& H) {
+  if (shift_samples == 0 || partitions == 0) {
+    return;
+  }
+  const int length = static_cast<int>(partitions * kFftLengthBy2);
+  std::vector<float> h(length);
+  std::array<float, kFftLength> tmp;
+  for (size_t ch = 0; ch < H[0].size(); ++ch) {
+    for (size_t p = 0; p < partitions; ++p) {
+      fft.Ifft(H[p][ch], &tmp);
+      for (size_t k = 0; k < kFftLengthBy2; ++k) {
+        h[p * kFftLengthBy2 + k] = tmp[k] / kFftLengthBy2;
+      }
+    }
+    for (size_t p = 0; p < partitions; ++p) {
+      tmp.fill(0.f);
+      for (size_t k = 0; k < kFftLengthBy2; ++k) {
+        const int n = static_cast<int>(p * kFftLengthBy2 + k) - shift_samples;
+        tmp[k] = n >= 0 && n < length ? h[n] : 0.f;
+      }
+      fft.Fft(&tmp, &H[p][ch]);
+    }
+  }
+}
+
+void ShiftImpulseResponse(int shift_samples, std::vector<float>& h) {
+  if (shift_samples == 0) {
+    return;
+  }
+  const std::vector<float> h_old = h;
+  const int length = static_cast<int>(h.size());
+  for (int k = 0; k < length; ++k) {
+    const int n = k - shift_samples;
+    h[k] = n >= 0 && n < length ? h_old[n] : 0.f;
+  }
+}
