+
+bool Subtractor::KeptFiltersMatch(size_t slot, int delay_blocks) const {
+  RTC_DCHECK_LT(slot, kKeptFiltersSlots);
+  const KeptFilters& kept = kept_filters_[slot];
+  if (num_capture_channels_ != 1 || kept.refined_partitions == 0) {
+    return false;
+  }
+  // The impulse responses can differ in length (a filter still at its initial
+  // size), and the echo can sit a little off the delays: they match at the
+  // best lag within those of the tests.
+  const std::vector<float>& h = refined_impulse_responses_[0];
+  const std::vector<float>& k = kept.refined_impulse_response;
+  const int h_size = static_cast<int>(h.size());
+  const int k_size = static_cast<int>(k.size());
+  double hh = 0.0, kk = 0.0;
+  for (float h_i : h) {
+    hh += h_i * h_i;
+  }
+  for (float k_i : k) {
+    kk += k_i * k_i;
+  }
+  if (hh <= 0.0 || kk <= 0.0) {
+    return false;
+  }
+  const int offset = delay_blocks * static_cast<int>(kBlockSize);
+  double best = 0.0;
+  for (int lag = offset - kKeptFiltersMaxLag;
+       lag <= offset + kKeptFiltersMaxLag; ++lag) {
+    double hk = 0.0;
+    for (int i = std::max(0, -lag); i < h_size && i + lag < k_size; ++i) {
+      hk += h[i] * k[i + lag];
