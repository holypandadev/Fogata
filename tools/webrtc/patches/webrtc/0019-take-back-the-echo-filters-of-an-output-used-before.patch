+
+  KeptFiltersWorld& world() { return world_; }
+  const FakeKeptFiltersEchoRemover& echo_remover() const {
+    return *echo_remover_;
+  }
+
+ private:
+  KeptFiltersWorld world_;
+  FakeKeptFiltersEchoRemover* echo_remover_ = nullptr;
+  std::unique_ptr<BlockProcessor> block_processor_;
+  Block render_block_;
+  Block capture_block_;
+  size_t tests_before_restart_ = 0;
