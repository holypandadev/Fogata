+void Subtractor::TestKeptFilters(const RenderBuffer& render_buffer,
+                                 std::span<const float> y,
+                                 KeptFilters& kept) {
+  const std::span<const std::vector<FftData>> X = render_buffer.GetFftBuffer();
+  const int size = static_cast<int>(X.size());
+  double capture_energy = 0.0;
+  for (float y_k : y) {
+    capture_energy += y_k * y_k;
+  }
+  double render_energy = 0.0;
+  for (size_t j = 0; j < kKeptFiltersTestEstimates; ++j) {
+    // The echo estimate of the kept refined filter at the tested delay plus
+    // the offset.
+    size_t index =
+        static_cast<size_t>(((static_cast<int>(render_buffer.Position()) +
+                              kept.test_offset + kKeptFiltersTestOffsets[j]) %
+                                 size +
+                             size) %
+                            size);
+    FftData S;
+    S.Clear();
+    for (size_t p = 0; p < kept.refined_partitions; ++p) {
+      for (size_t ch = 0; ch < X[index].size(); ++ch) {
+        const FftData& X_p = X[index][ch];
+        const FftData& H_p = kept.refined[p][ch];
+        for (size_t k = 0; k < kFftLengthBy2Plus1; ++k) {
+          S.re[k] += X_p.re[k] * H_p.re[k] - X_p.im[k] * H_p.im[k];
+          S.im[k] += X_p.re[k] * H_p.im[k] + X_p.im[k] * H_p.re[k];
+          if (j == 0 && p < 2) {
+            render_energy += X_p.re[k] * X_p.re[k] + X_p.im[k] * X_p.im[k];
+          }
+        }
+      }
+      index = index + 1 < X.size() ? index + 1 : 0;
+    }
+    std::array<float, kBlockSize> e;
+    std::array<float, kBlockSize> s;
+    PredictionError(fft_, S, y, &e, &s);
+    auto& s_j = kept.s[j];
+    std::copy(s_j.begin() + kBlockSize, s_j.end(), s_j.begin());
+    std::copy(s.begin(), s.end(), s_j.end() - kBlockSize);
+  }
+  std::copy(kept.y.begin() + 1, kept.y.end(), kept.y.begin());
+  std::copy(y.begin(), y.end(), kept.y.back().begin());
+  std::copy(kept.y_counts.begin() + 1, kept.y_counts.end(),
+            kept.y_counts.begin());
+  kept.y_counts.back() = capture_energy > kKeptFiltersTestMinCaptureEnergy &&
+                         render_energy > kKeptFiltersTestMinRenderEnergy;
+  ++kept.seen_blocks;
+
+  // The capture block kKeptFiltersMaxLagBlocks back, with the echo estimates
+  // of the blocks around it at hand, is summed at each lag.
+  if (kept.seen_blocks > 2 * kKeptFiltersMaxLagBlocks &&
+      kept.y_counts.front()) {
+    const std::array<float, kBlockSize>& y_old = kept.y.front();
+    ++kept.test_blocks;
+    for (float y_k : y_old) {
+      kept.yy += y_k * y_k;
+    }
+    for (size_t j = 0; j < kKeptFiltersTestEstimates; ++j) {
+      const auto& s_j = kept.s[j];
+      for (size_t l = 0; l < kKeptFiltersLags; ++l) {
+        // s delayed by l - kKeptFiltersMaxLag samples.
+        const size_t first = 2 * kKeptFiltersMaxLag - l;
+        double ys = 0.0;
+        double ss = 0.0;
+        for (size_t k = 0; k < kBlockSize; ++k) {
+          const float s_k = s_j[first + k];
+          ys += y_old[k] * s_k;
+          ss += s_k * s_k;
+        }
+        kept.ys[j][l] += ys;
+        kept.ss[j][l] += ss;
+      }
+    }
+  }
