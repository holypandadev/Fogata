+  const std::vector<size_t>& keeps() const { return keeps_; }
+  const std::vector<Test>& tests() const { return tests_; }
+  const std::vector<TakeBack>& take_backs() const { return take_backs_; }
+  const std::optional<FakeFilters>& slot(size_t slot) const {
+    return slots_[slot];
+  }
+  int delay_changes() const { return delay_changes_; }
+
+ private:
+  const KeptFiltersWorld* const world_;
+  FakeFilters in_use_;
+  std::array<std::optional<FakeFilters>, kKeptFiltersSlots> slots_;
+  std::array<std::optional<bool>, kKeptFiltersSlots> fit_;
+  std::array<int, kKeptFiltersSlots> lags_ = {};
+  std::vector<size_t> keeps_;
+  std::vector<Test> tests_;
+  std::vector<TakeBack> take_backs_;
+  int delay_changes_ = 0;
+};
