+// Fogata: the reuse of the filters of an output used before (see
+// EchoRemover::KeepFilters) on the real block processor, with a render buffer
+// and a delay estimator the test drives and an echo remover whose filters are
+// the echo path they were learnt on.
+constexpr int kBlock = static_cast<int>(kBlockSize);
+
+struct KeptFiltersWorld {
+  // The render buffer: the delay asked for last, and the delay it is aligned
+  // to, at most `end` (a delay beyond is aligned to it).
+  std::optional<size_t> requested_delay;
+  size_t delay = 0;
+  size_t end = 30;
+  size_t max_delay = 30;
+  // The delay the delay estimator finds.
+  size_t estimated_delay = 0;
+  // The output in use, and the samples its echo comes after the render.
+  int output = 0;
+  int echo_samples = 0;
+};
+
+// Filters of an output that estimate its echo `echo_samples` after the render
+// they are aligned to.
+struct FakeFilters {
+  int output = 0;
+  int echo_samples = 0;
+};
+
+class FakeKeptFiltersEchoRemover : public EchoRemover {
+ public:
+  struct TakeBack {
+    size_t slot;
+    int shift_samples;
+    bool shift_slot;
+  };
+  struct Test {
+    size_t slot;
+    size_t delay_blocks;
+    bool at_detected_delay;
+  };
+
+  explicit FakeKeptFiltersEchoRemover(const KeptFiltersWorld* world)
+      : world_(world) {}
+
+  void GetMetrics(EchoControl::Metrics* /* metrics */) const override {}
+  void ProcessCapture(EchoPathVariability echo_path_variability,
+                      bool /* capture_signal_saturation */,
+                      const std::optional<DelayEstimate>& /* external_delay */,
+                      RenderBuffer* /* render_buffer */,
+                      Block* /* linear_output */,
+                      Block* /* capture */) override {
+    if (echo_path_variability.delay_change !=
+        EchoPathVariability::DelayAdjustment::kNone) {
+      // The filters start anew and converge at once on the echo in use.
+      in_use_ = {world_->output, world_->echo_samples -
+                                     static_cast<int>(world_->delay) * kBlock};
+      ++delay_changes_;
+    }
+    if (echo_path_variability.delay_change ==
+        EchoPathVariability::DelayAdjustment::kBufferFlush) {
+      StopKeptFiltersTests();
+    }
+  }
+  void UpdateEchoLeakageStatus(bool /* leakage_detected */) override {}
+  void SetCaptureOutputUsage(bool /* capture_output_used */) override {}
+
+  bool FilterConvergenceSeen() const override { return true; }
+  bool KeptFiltersMatch(size_t slot, int delay_blocks) const override {
+    const std::optional<FakeFilters>& kept = slots_[slot];
+    return kept && kept->output == in_use_.output &&
+           std::abs(delay_blocks * kBlock + in_use_.echo_samples -
+                    kept->echo_samples) <= kKeptFiltersMaxLagBlocks * kBlock;
+  }
+  void KeepFilters(size_t slot) override {
+    slots_[slot] = in_use_;
+    fit_[slot].reset();
+    keeps_.push_back(slot);
+  }
+  // A test decides at once: the kept filters fit if they are those of the
+  // output in use and its echo is within the lags of the test (but those at
+  // its edge) from the one they estimate at that delay.
+  void StartKeptFiltersTest(size_t slot,
+                            size_t delay_blocks,
+                            int /* delay_offset_blocks */,
+                            bool at_detected_delay) override {
+    tests_.push_back({slot, delay_blocks, at_detected_delay});
+    const std::optional<FakeFilters>& kept = slots_[slot];
+    if (!kept) {
+      return;
+    }
+    const int lag = world_->echo_samples -
+                    (static_cast<int>(delay_blocks) * kBlock +
+                     kept->echo_samples);
+    fit_[slot] = kept->output == world_->output &&
+                 std::abs(lag) <= kKeptFiltersMaxLagBlocks * kBlock - 16;
+    lags_[slot] = *fit_[slot] ? lag : 0;
+  }
+  void StopKeptFiltersTests() override {
+    for (std::optional<bool>& fit : fit_) {
+      fit.reset();
+    }
+  }
+  bool KeptFiltersTestRunning() const override { return false; }
+  // As Subtractor::KeptFiltersFit, with tests that decide at once.
+  std::optional<size_t> KeptFiltersFit(
+      std::optional<size_t> slot_last) const override {
+    for (size_t slot = 0; slot < kKeptFiltersSlots; ++slot) {
+      if (slot != slot_last && fit_[slot].value_or(false)) {
+        return slot;
+      }
+    }
+    if (slot_last && fit_[*slot_last].value_or(false)) {
+      return slot_last;
+    }
+    return std::nullopt;
+  }
+  int KeptFiltersLag(size_t slot) const override { return lags_[slot]; }
+  // As Subtractor::UseKeptFilters, which shifts them by at most the lags of
+  // the tests.
+  void UseKeptFilters(size_t slot,
