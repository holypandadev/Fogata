+void AudioProcessingImpl::RestartEchoControllerForRecording() {
+  MutexLock lock_render(&mutex_render_);
+  MutexLock lock_capture(&mutex_capture_);
+  // Fogata: AEC3 aligns again and keeps what it learned of the room (patch
+  // 0010); another echo controller is made anew.
+  if (submodules_.echo_controller &&
+      submodules_.echo_controller->RestartForRecording()) {
+    RTC_LOG(LS_INFO) << "AudioProcessing: echo controller aligned anew";
+    return;
+  }
+  RTC_LOG(LS_INFO) << "AudioProcessing: echo controller made anew";
+  InitializeEchoController();
+}
