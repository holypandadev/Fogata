+// Fogata: the played sound queued while nothing was recorded is dropped, and the
+// block processor aligns again from the next recorded block on, as a new
+// EchoCanceller3 would; the echo remover's state is reset as at a delay change,
+// except whether the echo path was found to be absent (transparent mode), which
+// is the room's and not the alignment's: with a headset, a new echo canceller
+// held the microphone down while the other side talked until it had seen 6 s of
+// their sound without echo.
+// Called by AudioProcessingImpl::RestartEchoController with both its render and
+// capture locks held, so that neither side runs meanwhile.
+bool EchoCanceller3::RestartForRecording() {
+  RTC_DCHECK_RUNS_SERIALIZED(&capture_race_checker_);
+  // A scope of its own: each check declares a local of the same name.
+  {
+    RTC_DCHECK_RUNS_SERIALIZED(&render_race_checker_);
+    render_transfer_queue_.Clear();
+    block_processor_->RestartForRecording();
+  }
+  return true;
+}
