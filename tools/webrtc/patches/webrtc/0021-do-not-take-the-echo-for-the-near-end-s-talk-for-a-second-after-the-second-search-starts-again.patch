+  for (int k = 0; k < 100; ++k) {
+    call.Step(0.f, /*delay_found=*/true);
+  }
+  ASSERT_FALSE(call.filter().NearTalkNow());
+
+  call.Reset(/*full_reset=*/false);
+
+  // The far end talks again: its echo is not taken for talk.
+  for (int k = 0; k < 20; ++k) {
+    call.Step(echo, /*delay_found=*/true);
+    ASSERT_FALSE(call.filter().NearTalkNow()) << "echo, update " << k;
+  }
+  // The near end talks again, 10 dB over the echo: its capture's level is
+  // more than 6 dB over the echo's from the second sub-block of talk, which
+  // ends the second, and the talk is taken from then on.
+  call.Step(kTalk, /*delay_found=*/true);
+  ASSERT_FALSE(call.filter().NearTalkNow());
+  call.Step(kTalk, /*delay_found=*/true);
+  EXPECT_TRUE(call.filter().NearTalkNow());
+  for (int k = 0; k < 10; ++k) {
