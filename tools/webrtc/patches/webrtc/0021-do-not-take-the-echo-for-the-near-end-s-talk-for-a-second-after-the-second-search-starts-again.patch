+// Fogata: after the first partial reset (the second search's delay steady for
+// half a second) once the search's delay is reliable, the capture is not taken
+// for the near end's talk for 250 updates (1 s), and is again on the next one.
+// Updates left out of the ratios (a silent capture here) do not count. Before
+// the delay is reliable, a partial reset leaves the talk taken. The partial
+// resets that follow within 3 s of each other (the same stretch of echo alone)
+// do not start the second again; one that comes more than 3 s after the last
+// (another stretch) does, and so does the first after a full reset. A capture
+// more than 6 dB over the loudest of the half second before the reset (the
+// near end talking again) ends the second at once; 5 dB over it does not.
+TEST(MatchedFilter, PartialResetTakesNoNearTalkForASecondOnceDelayFound) {
+  constexpr float kTalk = ExactLevelNearTalk::kTalkAmplitude;
+  ExactLevelNearTalk call;
+
+  // As in ReliableDelayTakesNearTalkOnlyOverEightDb: 8 s with no delay found
+  // start the hold, and the talk is taken for talk, the pauses are not.
+  ExactLevelNearTalk::TalkSeen seen =
+      call.TalkAndPauses(2000, /*delay_found=*/false);
+  ASSERT_TRUE(call.filter().NearTalkHeld());
+  ASSERT_TRUE(seen.in_talk);
+  ASSERT_FALSE(seen.in_pause);
+
+  // Before the delay is reliable, a partial reset leaves the talk taken. (No
+  // check of whether the capture follows the render falls in these 8 updates:
+  // it comes every 125 ratios, and 2000 are in.)
+  for (int k = 0; k < 4; ++k) {
+    call.Step(kTalk, /*delay_found=*/false);
+  }
+  ASSERT_TRUE(call.filter().NearTalkNow());
+  call.Reset(/*full_reset=*/false);
+  for (int k = 0; k < 4; ++k) {
+    call.Step(kTalk, /*delay_found=*/false);
+    EXPECT_TRUE(call.filter().NearTalkNow()) << "update " << k;
+  }
+
+  // The delay is now reliable: 2 s of talk and pauses fill the ratios again
+  // (and use up what is left of the 250 updates); the talk, 20 dB over the
+  // pauses, is taken for talk. From here no check of whether the capture
+  // follows the render is made (only until a delay is found), and the hold,
+  // decided after 5 s of render, stays on whatever the filters match.
+  seen = call.TalkAndPauses(500, /*delay_found=*/true);
+  ASSERT_TRUE(seen.in_talk);
+  ASSERT_FALSE(seen.in_pause);
+  for (int k = 0; k < 4; ++k) {
+    call.Step(kTalk, /*delay_found=*/true);
+  }
+  ASSERT_TRUE(call.filter().NearTalkNow());
+
+  // 4 sub-blocks of digital silence: from the 4th, the capture's level holds
+  // none of the talk, and updates are left out of the ratios.
+  for (int k = 0; k < 4; ++k) {
+    call.Step(0.f, /*delay_found=*/true);
+  }
+  ASSERT_FALSE(call.filter().NearTalkNow());
+
+  call.Reset(/*full_reset=*/false);
+  ASSERT_TRUE(call.filter().NearTalkHeld());
+
+  // Silence after the reset does not count towards the 250 updates.
+  for (int k = 0; k < 20; ++k) {
+    call.Step(0.f, /*delay_found=*/true);
+    ASSERT_FALSE(call.filter().NearTalkNow()) << "silent update " << k;
+  }
+
+  // Talk for 250 updates is not taken for talk. Its ratio is at least 14 dB
+  // over the pauses' from the first update (one talk sub-block in 4), and the
+  // last 500 ratios keep more than a fifth of pauses (111) through the 251st,
+  // so it would be without the reset.
+  for (int k = 0; k < 250; ++k) {
+    call.Step(kTalk, /*delay_found=*/true);
+    ASSERT_FALSE(call.filter().NearTalkNow()) << "update " << k;
+  }
+  // The 251st is.
+  call.Step(kTalk, /*delay_found=*/true);
+  EXPECT_TRUE(call.filter().NearTalkNow());
+
+  // The partial resets that follow, every half second (125 updates) while the
+  // delay stays steady, do not start the second again: the talk going on at
+  // each is still taken. (1.2 s of talk and pauses first bring pauses back
+  // into the ratios; with talk for 60 sub-blocks, pauses for 40 and talk for
+  // 25 more, more than a fifth of the last 500 are on pauses. The first of
+  // these resets comes 696 updates after the one that started the second.)
+  seen = call.TalkAndPauses(300, /*delay_found=*/true);
+  ASSERT_FALSE(seen.in_pause);
+  for (int reset = 0; reset < 4; ++reset) {
+    seen = call.TalkAndPauses(125, /*delay_found=*/true);
+    ASSERT_TRUE(seen.in_talk);
+    ASSERT_FALSE(seen.in_pause);
+    ASSERT_TRUE(call.filter().NearTalkNow());
+    call.Reset(/*full_reset=*/false);
+    for (int k = 0; k < 10; ++k) {
+      call.Step(kTalk, /*delay_found=*/true);
+      EXPECT_TRUE(call.filter().NearTalkNow())
+          << "partial reset " << reset << ", update " << k;
+    }
+  }
+
+  // A partial reset 710 updates after the last (less than 3 s: the same
+  // stretch) does not start the second either.
+  seen = call.TalkAndPauses(700, /*delay_found=*/true);
+  ASSERT_FALSE(seen.in_pause);
+  call.Reset(/*full_reset=*/false);
+  for (int k = 0; k < 10; ++k) {
+    call.Step(kTalk, /*delay_found=*/true);
+    EXPECT_TRUE(call.filter().NearTalkNow()) << "same stretch, update " << k;
+  }
+
+  // Another stretch: the next partial reset comes 810 updates after that one
+  // (more than 3 s, the delay not steady meanwhile as the near end talked),
+  // and starts the second again.
+  seen = call.TalkAndPauses(800, /*delay_found=*/true);
+  ASSERT_TRUE(seen.in_talk);
+  ASSERT_FALSE(seen.in_pause);
+  call.Reset(/*full_reset=*/false);
+  for (int k = 0; k < 100; ++k) {
+    call.Step(kTalk, /*delay_found=*/true);
+    ASSERT_FALSE(call.filter().NearTalkNow())
+        << "another stretch, update " << k;
+  }
+  // 5 dB over the talk, the loudest of the half second before the reset, does
+  // not end the second.
+  const float five_db_over = kTalk * std::pow(10.f, 5.f / 20.f);
+  for (int k = 0; k < 4; ++k) {
+    call.Step(five_db_over, /*delay_found=*/true);
+    ASSERT_FALSE(call.filter().NearTalkNow()) << "5 dB over, update " << k;
+  }
+  for (int k = 104; k < 250; ++k) {
+    call.Step(kTalk, /*delay_found=*/true);
+    ASSERT_FALSE(call.filter().NearTalkNow())
+        << "another stretch, update " << k;
+  }
+  call.Step(kTalk, /*delay_found=*/true);
+  EXPECT_TRUE(call.filter().NearTalkNow());
+
+  // And a partial reset that follows it within 3 s does not.
+  seen = call.TalkAndPauses(400, /*delay_found=*/true);
+  ASSERT_TRUE(seen.in_talk);
+  call.Reset(/*full_reset=*/false);
+  for (int k = 0; k < 10; ++k) {
+    call.Step(kTalk, /*delay_found=*/true);
+    EXPECT_TRUE(call.filter().NearTalkNow())
+        << "after another stretch, update " << k;
+  }
+
+  // After a full reset (the echo path changed), the first partial reset once
+  // the delay is reliable again starts the second again.
+  call.Reset(/*full_reset=*/true);
+  ASSERT_FALSE(call.filter().NearTalkHeld());
+  seen = call.TalkAndPauses(2000, /*delay_found=*/false);
+  ASSERT_TRUE(call.filter().NearTalkHeld());
+  seen = call.TalkAndPauses(500, /*delay_found=*/true);
+  ASSERT_TRUE(seen.in_talk);
+  ASSERT_FALSE(seen.in_pause);
+  call.Reset(/*full_reset=*/false);
+  for (int k = 0; k < 100; ++k) {
+    call.Step(kTalk, /*delay_found=*/true);
+    ASSERT_FALSE(call.filter().NearTalkNow())
+        << "after full reset, update " << k;
+  }
+  // 10 dB over it ends the second as soon as the capture's level, over 4
+  // sub-blocks, is more than 6 dB over (at the second sub-block), and the
+  // talk is taken from then on.
+  const float ten_db_over = kTalk * std::pow(10.f, 10.f / 20.f);
+  call.Step(ten_db_over, /*delay_found=*/true);
+  ASSERT_FALSE(call.filter().NearTalkNow());
+  call.Step(ten_db_over, /*delay_found=*/true);
+  EXPECT_TRUE(call.filter().NearTalkNow());
+  for (int k = 0; k < 10; ++k) {
+    call.Step(kTalk, /*delay_found=*/true);
+    EXPECT_TRUE(call.filter().NearTalkNow()) << "talk again, update " << k;
+  }
+}
