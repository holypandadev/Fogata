+// Fogata: the first partial reset with the delay reliable starts the second;
+// the partial resets that follow come less than 3 s (750 updates) apart, the
+// delay not reliable at those but the last, with or without a full reset
+// 100 updates after the first. Returns how many of the first 10 updates of
+// talk after the last partial reset take the capture for the near end's talk.
+int TalkTakenAfterCloseResets(bool full_reset) {
+  ExactLevelNearTalk call;
+  call.TalkAndPauses(2000, /*delay_found=*/false);
+  call.TalkAndPauses(500, /*delay_found=*/true);
+  call.Reset(/*full_reset=*/false);
+  call.TalkAndPauses(100, /*delay_found=*/true);
+  if (full_reset) {
+    call.Reset(/*full_reset=*/true);
+    EXPECT_FALSE(call.filter().NearTalkHeld());
+  }
+  // A partial reset every 500 updates (the first 600 after the one that
+  // started the second). After the full reset, the 1500 updates bring the
+  // hold back (it starts after 5 s of render).
+  for (int k = 0; k < 3; ++k) {
+    call.TalkAndPauses(500, /*delay_found=*/false);
+    call.Reset(/*full_reset=*/false);
+  }
+  const ExactLevelNearTalk::TalkSeen seen =
+      call.TalkAndPauses(500, /*delay_found=*/true);
+  EXPECT_TRUE(call.filter().NearTalkHeld());
+  EXPECT_TRUE(seen.in_talk);
+  EXPECT_FALSE(seen.in_pause);
+  call.Reset(/*full_reset=*/false);
+  int taken = 0;
+  for (int k = 0; k < 10; ++k) {
+    call.Step(ExactLevelNearTalk::kTalkAmplitude, /*delay_found=*/true);
+    taken += call.filter().NearTalkNow() ? 1 : 0;
+  }
+  return taken;
