+// Fogata, patch 0017: begins keeping recording through a mute
+// (RemoveSendingStream). The check runs on this thread, where every other call
+// to the audio device module is made, every 10 ms (a recorded frame): it only
+// reads the audio processing's atomic, written by the capture thread after each
+// frame, and the count of device changes. Nothing is added to the capture path.
+void AudioState::HoldRecording() {
+  RTC_DCHECK(!recording_held_);
+  recording_hold_check_.Stop();
+  recording_held_ = true;
+  devices_at_hold_ = AudioDevicesChangedCount().load();
+  RTC_LOG(LS_INFO) << "AudioState: recording kept through the mute: the echo "
+                      "controller is transparent";
+  recording_hold_check_ = RepeatingTaskHandle::DelayedStart(
+      TaskQueueBase::Current(), TimeDelta::Millis(10), [this] {
+        RTC_DCHECK_RUN_ON(&worker_thread_checker_);
+        CheckRecordingHold();
+        return TimeDelta::Millis(10);
+      });
+}
+
+// Fogata, patch 0017: a recording kept through the mute stops, as recording
+// stopped at the mute before (stopped_in_call_ stays true), once the echo
+// controller is no longer transparent: an echo path found (speakers), or the
+// controller made anew. A change of audio devices stops it too, and the unmute
+// then takes the devices as changed (patch 0016).
+void AudioState::CheckRecordingHold() {
+  if (!recording_held_) {
+    return;
+  }
+  if (AudioDevicesChangedCount().load() != devices_at_hold_) {
+    devices_changed_in_hold_ = true;
+    EndRecordingHold(/*stop_recording=*/true, "audio devices changed");
+    return;
+  }
+  if (!config_.audio_processing ||
+      !config_.audio_processing->EchoControllerTransparent()) {
+    EndRecordingHold(/*stop_recording=*/true,
+                     "the echo controller is no longer transparent");
+  }
+}
+
+void AudioState::EndRecordingHold(bool stop_recording, const char* why) {
+  if (!recording_held_) {
+    return;
+  }
+  recording_held_ = false;
+  recording_hold_check_.Stop();
+  RTC_LOG(LS_INFO) << "AudioState: recording kept through the mute ends: "
+                   << why;
+  if (stop_recording) {
+    config_.audio_device_module->StopRecording();
+  }
+}
