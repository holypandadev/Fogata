+void AudioDeviceLinuxPulse::SubscribeToDevices() {
+  PaLock();
+  sink_ports_.clear();
+  source_ports_.clear();
+  defaults_known_ = false;
+  LATE(pa_context_set_subscribe_callback)(_paContext, PaSubscribeCallback, this);
+  pa_operation* ops[] = {
+      LATE(pa_context_subscribe)(
+          _paContext,
+          static_cast<pa_subscription_mask_t>(PA_SUBSCRIPTION_MASK_SINK |
+                                              PA_SUBSCRIPTION_MASK_SOURCE |
+                                              PA_SUBSCRIPTION_MASK_SERVER),
+          nullptr, nullptr),
+      // The ports and defaults as they are, to tell a change from them.
+      LATE(pa_context_get_sink_info_list)(_paContext, PaPortSinkCallback, this),
+      LATE(pa_context_get_source_info_list)(_paContext, PaPortSourceCallback,
+                                            this),
+      LATE(pa_context_get_server_info)(_paContext, PaDefaultsCallback, this)};
+  for (pa_operation* op : ops) {
+    if (op != nullptr) {
+      LATE(pa_operation_unref)(op);
+    }
+  }
+  PaUnLock();
+}
+
+void AudioDeviceLinuxPulse::NotePort(bool source,
+                                     uint32_t index,
+                                     const char* port) {
+  auto& ports = source ? source_ports_ : sink_ports_;
+  const std::string name = port != nullptr ? port : "";
+  auto known = ports.find(index);
+  if (known != ports.end() && known->second != name) {
+    RTC_LOG(LS_INFO) << "PulseAudio: a " << (source ? "source" : "sink")
+                     << "'s port changed to " << name
+                     << ": audio devices changed";
+    MarkAudioDevicesChanged();
+  }
+  ports[index] = name;
+}
+
+void AudioDeviceLinuxPulse::PaPortSinkCallback(pa_context* /*c*/,
+                                               const pa_sink_info* i,
+                                               int eol,
+                                               void* pThis) {
+  if (eol == 0 && i != nullptr) {
+    static_cast<AudioDeviceLinuxPulse*>(pThis)->NotePort(
+        false, i->index, i->active_port ? i->active_port->name : nullptr);
+  }
+}
+
+void AudioDeviceLinuxPulse::PaPortSourceCallback(pa_context* /*c*/,
+                                                 const pa_source_info* i,
+                                                 int eol,
+                                                 void* pThis) {
+  if (eol == 0 && i != nullptr) {
+    static_cast<AudioDeviceLinuxPulse*>(pThis)->NotePort(
+        true, i->index, i->active_port ? i->active_port->name : nullptr);
+  }
+}
+
+void AudioDeviceLinuxPulse::PaDefaultsCallback(pa_context* /*c*/,
+                                               const pa_server_info* i,
+                                               void* pThis) {
+  if (i == nullptr) {
+    return;
+  }
+  auto* self = static_cast<AudioDeviceLinuxPulse*>(pThis);
+  const std::string sink = i->default_sink_name ? i->default_sink_name : "";
+  const std::string source =
+      i->default_source_name ? i->default_source_name : "";
+  if (self->defaults_known_ &&
+      (sink != self->default_sink_ || source != self->default_source_)) {
+    RTC_LOG(LS_INFO) << "PulseAudio: the default output or input changed: "
+                        "audio devices changed";
+    MarkAudioDevicesChanged();
+  }
+  self->default_sink_ = sink;
+  self->default_source_ = source;
+  self->defaults_known_ = true;
+}
+
+void AudioDeviceLinuxPulse::PaStreamMovedCallback(pa_stream* /*p*/,
+                                                  void* /*pThis*/) {
+  RTC_LOG(LS_INFO) << "PulseAudio: a stream moved to another device: audio "
+                      "devices changed";
+  MarkAudioDevicesChanged();
+}
