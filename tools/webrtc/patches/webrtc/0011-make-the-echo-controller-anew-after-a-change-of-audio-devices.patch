+// Fogata: how many changes of audio devices were seen in the process: a device
+// chosen, one plugged in or out, the default or a device's port changed, a stream
+// moved by the sound server. Whatever learns of one calls MarkAudioDevicesChanged,
+// from any thread; AudioState reads the count each time recording starts, and a
+// microphone turned on again after a change makes the echo controller anew rather
+// than keeping what it learned of the room (patch 0011). One count for the library
+// (built as one binary), whatever its factories.
+inline std::atomic<uint64_t>& AudioDevicesChangedCount() {
+  static std::atomic<uint64_t> count{0};
+  return count;
+}
+inline void MarkAudioDevicesChanged() {
+  AudioDevicesChangedCount().fetch_add(1, std::memory_order_relaxed);
+}
