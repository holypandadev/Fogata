+  near_talk_held_ = near_talk_held_ || hold;
+  return hold;
+}
+
+bool MatchedFilter::CaptureHasPauses() {
+  if (num_ratios_ < kNearTalkMinRatios) {
+    return false;
+  }
+  std::copy(capture_energies_.begin(), capture_energies_.begin() + num_ratios_,
+            ratio_scratch_.begin());
+  const auto end = ratio_scratch_.begin() + num_ratios_;
+  const auto low = ratio_scratch_.begin() + num_ratios_ / 5;
+  const auto high = ratio_scratch_.begin() + num_ratios_ * 4 / 5;
+  std::nth_element(ratio_scratch_.begin(), low, end);
+  const float low_capture = *low;
+  std::nth_element(ratio_scratch_.begin(), high, end);
+  return *high > kNearTalkPauseSpread * low_capture;
+}
+
+bool MatchedFilter::CaptureFollowsRender() const {
+  const size_t window = capture_levels_.size();
+  const size_t num_render_levels = render_levels_.size();
+  if (num_levels_ < num_render_levels) {
+    return false;
+  }
+  const size_t start = num_levels_ - window;
+  double sum_c = 0.0;
+  double sum_cc = 0.0;
+  for (size_t k = 0; k < window; ++k) {
+    const double c = capture_levels_[(start + k) % window];
+    sum_c += c;
+    sum_cc += c * c;
+  }
+  const double var_c = sum_cc - sum_c * sum_c / window;
+  if (var_c <= 0.0) {
+    return false;
+  }
+  const double min_correlation2 =
+      kNearTalkEchoCorrelation * kNearTalkEchoCorrelation;
+  for (size_t lag = 0; lag + window <= num_render_levels; ++lag) {
+    double sum_r = 0.0;
+    double sum_rr = 0.0;
+    double sum_cr = 0.0;
+    for (size_t k = 0; k < window; ++k) {
+      const double c = capture_levels_[(start + k) % window];
+      const double r = render_levels_[(start + k - lag) % num_render_levels];
+      sum_r += r;
+      sum_rr += r * r;
+      sum_cr += c * r;
+    }
+    const double var_r = sum_rr - sum_r * sum_r / window;
+    const double cov = sum_cr - sum_c * sum_r / window;
+    if (var_r > 0.0 && cov > 0.0 &&
+        cov * cov >= min_correlation2 * var_c * var_r) {
+      return true;
+    }
+  }
+  return false;
+}
