+// Fogata: after half a second of a steady delay the second search starts its
+// filters again, as the usual one does. What they learnt of the near end's
+// talk stays: its delay is still the one given, and the near end's talk is
+// still reported, so that the suppressor's floor for it lasts.
+TEST(EchoPathDelayEstimator, NearTalkOutlastsTheSecondSearchsReset) {
+  ScopedPlayoutToHeadphones headphones(false);
+  NearTalkCall call;
+  std::optional<DelayEstimate> delay = call.FindDelayInQuietPause();
+  ASSERT_TRUE(delay);
+  ASSERT_TRUE(call.estimator().NearTalkHeld());
+
+  // The room stays quiet, and the second search gives the same delay block
+  // after block; on the 127th in a row it resets its filters.
+  constexpr int kBlocksToReset = kNumBlocksPerSecond / 2 + 2;
+  int steady_blocks = 1;
+  for (int k = 0; k < 400 && steady_blocks < kBlocksToReset; ++k) {
+    std::optional<DelayEstimate> next =
+        call.Step(NearTalkCall::Capture::kQuiet);
+    steady_blocks =
+        !next ? 0 : (delay && next->delay == delay->delay ? steady_blocks + 1
+                                                          : 1);
+    delay = next;
+  }
+  EXPECT_EQ(kBlocksToReset, steady_blocks);
+  EXPECT_TRUE(call.estimator().NearTalkHeld());
+
+  // The near end talks again, and is taken for talk.
+  bool near_talk_now = false;
+  for (int k = 0; k < 150 && !near_talk_now; ++k) {
+    call.Step(NearTalkCall::Capture::kTalk);
+    near_talk_now = call.estimator().NearTalkNow();
+  }
+  EXPECT_TRUE(near_talk_now);
+  EXPECT_TRUE(call.estimator().NearTalkHeld());
