+  EXPECT_FALSE(call.estimator().NearTalkHeld());
+  call.Step(NearTalkCall::Capture::kTalk);
+  EXPECT_FALSE(call.estimator().NearTalkNow());
+  EXPECT_FALSE(call.estimator().NearTalkHeld());
+
+  headphones.Set(false);
+  call.Step(NearTalkCall::Capture::kTalk);
+  EXPECT_TRUE(call.estimator().NearTalkNow());
+  EXPECT_TRUE(call.estimator().NearTalkHeld());
+}
