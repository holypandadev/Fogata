+// Fogata: a call where the near end talks from the start over a weak echo.
+// The render is white noise; its echo comes 800 samples (at 16 kHz) later and
+// 66 dB under it. The near end talks in stretches of 60 blocks, 19 dB over
+// the echo for the first 5 s and 50 dB over it after that, with pauses of 40
+// blocks where room noise, 6 dB over the echo, keeps either search from
+// matching it. The usual search, pulled off the echo by the talk, does not
+// find it; the second one learns it in the pauses and, once the room goes
+// quiet, finds it.
+class NearTalkCall {
+ public:
+  enum class Capture { kTalk, kRoomNoise, kQuiet };
+
+  NearTalkCall()
+      : data_dumper_(0),
+        render_delay_buffer_(
+            RenderDelayBuffer::Create(config_, kSampleRateHz, 1)),
+        estimator_(&data_dumper_, config_, 1) {}
+
+  // Processes one block of render and capture.
+  std::optional<DelayEstimate> Step(Capture kind) {
+    RandomizeSampleVector(&random_generator_,
+                          render_.View(/*band=*/0, /*channel=*/0));
+    std::span<float, kBlockSize> capture =
+        capture_.View(/*band=*/0, /*channel=*/0);
+    echo_delay_.Delay(render_.View(/*band=*/0, /*channel=*/0), capture);
+    for (float& y : capture) {
+      y *= kEchoGain;
+    }
+    if (kind != Capture::kQuiet) {
+      std::array<float, kBlockSize> near_end;
+      const float amplitude =
+          kind == Capture::kRoomNoise ? kRoomNoiseAmplitude
+          : num_blocks_ < 5 * kNumBlocksPerSecond ? kEarlyTalkAmplitude
+                                                  : kTalkAmplitude;
+      RandomizeSampleVector(&random_generator_, near_end, amplitude);
+      for (size_t k = 0; k < kBlockSize; ++k) {
+        capture[k] += near_end[k];
+      }
+    }
+    render_delay_buffer_->Insert(render_);
+    if (num_blocks_ == 0) {
+      render_delay_buffer_->Reset();
+    }
+    render_delay_buffer_->PrepareCaptureProcessing();
+    ++num_blocks_;
+    return estimator_.EstimateDelay(
+        render_delay_buffer_->GetDownsampledRenderBuffer(), capture_);
+  }
+
+  // Talk and pauses for 9 s, ending with talk, then the room goes quiet until
+  // a delay is given. Returns it, or nothing when one is given in the talk or
+  // none in the quiet.
+  std::optional<DelayEstimate> FindDelayInQuietPause() {
+    for (int k = 0; k < 9 * kNumBlocksPerSecond; ++k) {
+      if (Step((k + 10) % 100 < 60 ? Capture::kTalk : Capture::kRoomNoise)) {
+        return std::nullopt;
+      }
+    }
+    for (int k = 0; k < 300; ++k) {
+      std::optional<DelayEstimate> delay = Step(Capture::kQuiet);
+      if (delay) {
+        return delay;
+      }
+    }
+    return std::nullopt;
+  }
+
+  const EchoPathDelayEstimator& estimator() const { return estimator_; }
+
+ private:
+  static constexpr int kSampleRateHz = 48000;
+  static constexpr size_t kEchoDelaySamples = 800;
+  static constexpr float kEchoGain = 0.0005f;
+  static constexpr float kEarlyTalkAmplitude = 146.f;
+  static constexpr float kTalkAmplitude = 5000.f;
+  static constexpr float kRoomNoiseAmplitude = 33.f;
+
+  const EchoCanceller3Config config_;
+  ApmDataDumper data_dumper_;
+  Random random_generator_{42U};
+  Block render_{NumBandsForRate(kSampleRateHz), /*num_channels=*/1};
+  Block capture_{/*num_bands=*/1, /*num_channels=*/1};
+  DelayBuffer<float> echo_delay_{kEchoDelaySamples};
+  std::unique_ptr<RenderDelayBuffer> render_delay_buffer_;
+  EchoPathDelayEstimator estimator_;
+  int num_blocks_ = 0;
+};
+
