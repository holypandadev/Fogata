+    // then; where they match it often, the delay is on its way.
+    near_talk_hold_ = updates_with_render_ > kNearTalkHoldUpdates &&
+                      reliable_updates_ < kNearTalkMaxReliableUpdates;
+  }
+  const float ratio = capture_sum / max_render_sum;
+  capture_to_render_ratios_[ratio_index_] = ratio;
+  capture_energies_[ratio_index_] = capture_sum;
+  ratio_index_ = (ratio_index_ + 1) % kNearTalkRatios;
+  num_ratios_ = std::min(num_ratios_ + 1, kNearTalkRatios);
+  if (num_ratios_ >= kNearTalkMinRatios &&
+      ratio_index_ % kNearTalkLowRatioPeriod == 0) {
+    std::copy(capture_to_render_ratios_.begin(),
+              capture_to_render_ratios_.begin() + num_ratios_,
+              ratio_scratch_.begin());
+    const auto low = ratio_scratch_.begin() + num_ratios_ / 5;
+    std::nth_element(ratio_scratch_.begin(), low,
+                     ratio_scratch_.begin() + num_ratios_);
+    low_ratio_ = *low;
+    capture_has_pauses_ = CaptureHasPauses();
+  }
+  if (near_talk_hold_ && !delay_found &&
+      (!render_followed_checked_ ||
+       ratio_index_ % kNearTalkEchoCheckPeriod == 0)) {
+    capture_follows_render_ = CaptureFollowsRender();
+    render_followed_checked_ = true;
+  }
+
+  near_talk_now_ = near_talk_hold_ && capture_has_pauses_ &&
+                   !capture_follows_render_ &&
+                   num_ratios_ >= kNearTalkMinRatios &&
+                   ratio > kNearTalkRatioFactor * low_ratio_;
