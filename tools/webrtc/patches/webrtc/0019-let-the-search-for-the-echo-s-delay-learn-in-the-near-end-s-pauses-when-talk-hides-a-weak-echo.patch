+  render_energy_index_ =
+      (render_energy_index_ + 1) % render_sub_block_energies_.size();
+
+  float capture_energy = 0.f;
+  for (float y : capture) {
+    capture_energy += y * y;
+  }
+  capture_sub_block_energies_[capture_energy_index_] = capture_energy;
+  capture_energy_index_ =
+      (capture_energy_index_ + 1) % capture_sub_block_energies_.size();
+  float capture_sum = 0.f;
+  for (float e : capture_sub_block_energies_) {
+    capture_sum += e;
+  }
+
+  // Levels, in dB, of the last 4 sub-blocks of render and capture.
+  const size_t num_render_energies = render_sub_block_energies_.size();
+  float recent_render = 0.f;
+  for (size_t k = 1; k <= 4; ++k) {
+    recent_render += render_sub_block_energies_[(render_energy_index_ +
+                                                 num_render_energies - k) %
+                                                num_render_energies];
+  }
+  render_levels_[num_levels_ % render_levels_.size()] =
+      std::log10(recent_render + 1.f);
+  capture_levels_[num_levels_ % capture_levels_.size()] =
+      std::log10(capture_sum + 1.f);
+  ++num_levels_;
+
+  // The loudest render of 4 sub-blocks within the filters' reach.
+  const size_t num_energies = render_sub_block_energies_.size();
+  float max_render_sum = 0.f;
+  for (size_t k = 0; k + 3 < num_energies; ++k) {
+    max_render_sum =
+        std::max(max_render_sum, render_sub_block_energies_[k] +
+                                     render_sub_block_energies_[k + 1] +
+                                     render_sub_block_energies_[k + 2] +
+                                     render_sub_block_energies_[k + 3]);
+  }
+  // Leave out render too weak to adapt on (the filters' threshold, over their
+  // length, taken over 4 sub-blocks) and a capture that is digital silence (a
+  // muted microphone), which carry nothing of the echo.
+  if (max_render_sum * filters_[0].size() <=
+          x2_sum_threshold * 4.f * sub_block_size_ ||
+      capture_sum <= kNearTalkSilentCapture) {
