+bool MatchedFilter::NearTalkHoldsAdaptation(
+    const DownsampledRenderBuffer& render_buffer,
+    std::span<const float> capture,
+    bool delay_found,
+    float x2_sum_threshold) {
+  float render_energy = 0.f;
+  for (size_t k = 0; k < sub_block_size_; ++k) {
+    const float x = render_buffer.buffer[(render_buffer.read + k) %
+                                         render_buffer.buffer.size()];
+    render_energy += x * x;
+  }
+  render_sub_block_energies_[render_energy_index_] = render_energy;
+  render_energy_index_ =
+      (render_energy_index_ + 1) % render_sub_block_energies_.size();
+
+  float capture_energy = 0.f;
+  for (float y : capture) {
+    capture_energy += y * y;
+  }
+  capture_sub_block_energies_[capture_energy_index_] = capture_energy;
+  capture_energy_index_ =
+      (capture_energy_index_ + 1) % capture_sub_block_energies_.size();
+  float capture_sum = 0.f;
+  for (float e : capture_sub_block_energies_) {
+    capture_sum += e;
+  }
+
+  // The loudest render of 4 sub-blocks within the filters' reach.
+  const size_t num_energies = render_sub_block_energies_.size();
+  float max_render_sum = 0.f;
+  for (size_t k = 0; k + 3 < num_energies; ++k) {
+    max_render_sum = std::max(
+        max_render_sum,
+        render_sub_block_energies_[k] + render_sub_block_energies_[k + 1] +
+            render_sub_block_energies_[k + 2] +
+            render_sub_block_energies_[k + 3]);
+  }
+  // Leave out render too weak to adapt on and a capture that is digital
+  // silence (a muted microphone), which carry nothing of the echo.
+  if (max_render_sum <= 4.f * x2_sum_threshold ||
+      capture_sum <= kNearTalkSilentCapture) {
+    return false;
+  }
+
+  if (updates_with_render_ <= kNearTalkHoldUpdates) {
+    ++updates_with_render_;
+    // Hold only when the filters have almost never matched the capture by
+    // then; where they match it often, the delay is on its way.
+    near_talk_hold_ = updates_with_render_ > kNearTalkHoldUpdates &&
+                      reliable_updates_ < kNearTalkMaxReliableUpdates;
+  }
+  const float ratio = capture_sum / max_render_sum;
+  capture_to_render_ratios_[ratio_index_] = ratio;
+  capture_energies_[ratio_index_] = capture_sum;
+  ratio_index_ = (ratio_index_ + 1) % kNearTalkRatios;
+  num_ratios_ = std::min(num_ratios_ + 1, kNearTalkRatios);
+  if (num_ratios_ >= kNearTalkMinRatios &&
+      ratio_index_ % kNearTalkLowRatioPeriod == 0) {
+    std::copy(capture_to_render_ratios_.begin(),
+              capture_to_render_ratios_.begin() + num_ratios_,
+              ratio_scratch_.begin());
+    const auto low = ratio_scratch_.begin() + num_ratios_ / 5;
+    std::nth_element(ratio_scratch_.begin(), low,
+                     ratio_scratch_.begin() + num_ratios_);
+    low_ratio_ = *low;
+    capture_has_pauses_ = CaptureHasPauses();
+  }
+
+  return !delay_found && near_talk_hold_ && capture_has_pauses_ &&
+         num_ratios_ >= kNearTalkMinRatios &&
+         ratio > kNearTalkRatioFactor * low_ratio_;
+}
+
+bool MatchedFilter::CaptureHasPauses() {
+  if (num_ratios_ < kNearTalkMinRatios) {
+    return false;
+  }
+  std::copy(capture_energies_.begin(), capture_energies_.begin() + num_ratios_,
+            ratio_scratch_.begin());
+  const auto end = ratio_scratch_.begin() + num_ratios_;
+  const auto low = ratio_scratch_.begin() + num_ratios_ / 5;
+  const auto high = ratio_scratch_.begin() + num_ratios_ * 4 / 5;
+  std::nth_element(ratio_scratch_.begin(), low, end);
+  const float low_capture = *low;
+  std::nth_element(ratio_scratch_.begin(), high, end);
+  return *high > kNearTalkPauseSpread * low_capture;
+}
