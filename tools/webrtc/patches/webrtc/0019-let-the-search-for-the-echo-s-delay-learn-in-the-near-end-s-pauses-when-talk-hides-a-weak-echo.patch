+// Fogata: the suppressor's floor for the near end's talk, after a delay found
+// in that talk, ends for good once the delay in use is no longer reported as
+// found there (as while the sound plays to headphones), even when it is
+// reported so again later.
+TEST(AecState, NearTalkGainFloorEndsForGoodWhenNoLongerFoundInNearTalk) {
+  constexpr size_t kNumCaptureChannels = 1;
+  EchoCanceller3Config config;
+  AecState state(CreateTestEnvironment(), config, kNumCaptureChannels);
+  std::unique_ptr<RenderDelayBuffer> render_delay_buffer(
+      RenderDelayBuffer::Create(config, 48000, 1));
+  std::vector<std::array<float, kFftLengthBy2Plus1>> E2_refined(
+      kNumCaptureChannels);
+  std::vector<std::array<float, kFftLengthBy2Plus1>> Y2(kNumCaptureChannels);
+  std::vector<SubtractorOutput> subtractor_output(kNumCaptureChannels);
+  for (auto& output : subtractor_output) {
+    output.Reset();
+  }
+  std::array<float, kBlockSize> y;
+  y.fill(0.f);
+  std::vector<std::vector<std::array<float, kFftLengthBy2Plus1>>>
+      frequency_response(
+          kNumCaptureChannels,
+          std::vector<std::array<float, kFftLengthBy2Plus1>>(
+              config.filter.refined.length_blocks));
+  for (auto& v_ch : frequency_response) {
+    for (auto& v : v_ch) {
+      v.fill(0.f);
+    }
+  }
+  std::vector<std::vector<float>> impulse_response(
+      kNumCaptureChannels,
+      std::vector<float>(
+          GetTimeDomainLength(config.filter.refined.length_blocks), 0.f));
+
+  auto update = [&](bool found_in_near_talk) {
+    DelayEstimate delay(DelayEstimate::Quality::kRefined, 50);
+    delay.found_in_near_talk = found_in_near_talk;
+    delay.near_talk_now = true;
+    std::optional<DelayEstimate> delay_estimate = delay;
+    subtractor_output[0].ComputeMetrics(y);
+    state.Update(delay_estimate, frequency_response, impulse_response,
+                 *render_delay_buffer->GetRenderBuffer(), E2_refined, Y2,
+                 subtractor_output);
+  };
+
+  // A delay found in the near end's talk: the floor is on while it talks.
+  for (int k = 0; k < 10; ++k) {
+    update(/*found_in_near_talk=*/true);
+  }
+  EXPECT_GT(state.NearTalkGainFloor(), 0.f);
+
+  // No longer reported as found in that talk (headphones): gone at once.
+  update(/*found_in_near_talk=*/false);
+  EXPECT_EQ(state.NearTalkGainFloor(), 0.f);
+
+  // Reported so again, at the same delay: it does not come back.
+  for (int k = 0; k < 10; ++k) {
+    update(/*found_in_near_talk=*/true);
+    EXPECT_EQ(state.NearTalkGainFloor(), 0.f);
+  }
+}
