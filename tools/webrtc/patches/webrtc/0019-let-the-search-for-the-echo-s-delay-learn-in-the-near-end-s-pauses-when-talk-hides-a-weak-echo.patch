+bool MatchedFilter::NearTalkHoldsAdaptation(
+    const DownsampledRenderBuffer& render_buffer,
+    std::span<const float> capture,
+    bool delay_found,
+    float x2_sum_threshold) {
+  float render_energy = 0.f;
+  for (size_t k = 0; k < sub_block_size_; ++k) {
+    const float x =
+        render_buffer
+            .buffer[(render_buffer.read + k) % render_buffer.buffer.size()];
+    render_energy += x * x;
+  }
