+void AudioProcessingImpl::FollowAudioDeviceRestarts() {
+  if (AudioDeviceRestartsCount().load() == device_restarts_seen_.load()) {
+    return;
+  }
+  MutexLock lock_render(&mutex_render_);
+  MutexLock lock_capture(&mutex_capture_);
+  // Decided again under the locks: a start of recording asked for by the audio
+  // state may have restarted the echo controller meanwhile, taking the count as
+  // seen, and is not followed by another.
+  const uint64_t restarts = AudioDeviceRestartsCount().load();
+  if (restarts == device_restarts_seen_.load()) {
+    return;
+  }
+  // Fogata, patch 0014: the audio device started recording again by itself in a
+  // call (another device chosen, the default device changed, a device back): what
+  // it plays may now reach what it records sooner or later than the echo
+  // controller's alignment says, and the other side's voice went back to them for
+  // up to 2 s until AEC3 found the new delay. Aligned again as at a microphone
+  // turned on again (patch 0010), also after a change of devices: an echo
+  // controller made anew in the middle of the other side's speech let it through
+  // for seconds while it learned the room, where the one kept found the new path
+  // at once. The next microphone turned on again after a change of devices still
+  // makes it anew (patch 0011).
+  const bool same_devices =
+      AudioDevicesChangedCount().load() == devices_seen_.load();
+  device_restarts_seen_ = restarts;
+  devices_seen_ = AudioDevicesChangedCount().load();
+  // With no echo controller and none wanted (the echo canceller off), there is
+  // nothing to align: the count is taken as seen.
+  if (!submodules_.echo_controller &&
+      !NeedEchoController(config_, !!echo_control_factory_)) {
+    return;
+  }
+  RTC_LOG(LS_INFO) << "AudioProcessing: the audio device started recording "
+                      "again by itself"
+                   << (same_devices ? "" : ", with other devices");
+  if (submodules_.echo_controller &&
+      submodules_.echo_controller->RestartForRecording()) {
+    RTC_LOG(LS_INFO) << "AudioProcessing: echo controller aligned anew";
+    return;
+  }
+  RTC_LOG(LS_INFO) << "AudioProcessing: echo controller made anew";
+  InitializeEchoController();
+}
