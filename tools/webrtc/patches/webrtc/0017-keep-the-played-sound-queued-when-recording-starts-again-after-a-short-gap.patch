+size_t RenderDelayBufferImpl::SkipLostCaptureBlocks(size_t num_blocks) {
+  size_t skipped = 0;
+  while (skipped < num_blocks && BufferLatency() > 1) {
+    IncrementLowRateReadIndices();
+    IncrementReadIndices();
+    ++capture_call_counter_;
+    ++skipped;
