 namespace libwebrtc {
 
+namespace {
+
+// Fogata: room for an echo that comes earlier than the one the echo canceller has
+// found. When the sound server misses its deadlines (PipeWire, a busy computer) it can
+// leave out some of what was played or recorded, and the echo then reaches the
+// microphone up to tens of milliseconds earlier than before. With WebRTC's default
+// headroom (32 samples at 16 kHz: 2 ms) the linear filter cannot reach such an echo, and
+// a whole turn of the other's voice went back to them until the delay estimator found the
+// echo again, a second or more later. 256 samples (4 blocks, 16 ms) cover the moves
+// measured on an idle computer (5 to 11 ms); the filters are 4 blocks longer so that they
+// still reach as far after the echo as before.
+constexpr size_t kDelayHeadroomSamples = 256;
+constexpr size_t kExtraFilterBlocks = 4;
+
+webrtc::EchoCanceller3Config WithEarlierEchoRoom(webrtc::EchoCanceller3Config config) {
+  config.delay.delay_headroom_samples = kDelayHeadroomSamples;
+  config.filter.refined.length_blocks += kExtraFilterBlocks;
+  config.filter.coarse.length_blocks += kExtraFilterBlocks;
+  return config;
+}
+
+}  // namespace
+
 class CustomProcessingAdapter : public webrtc::CustomProcessing {
  public:
   CustomProcessingAdapter() = default;
@@ -84,6 +108,10 @@ RTCAudioProcessingImpl::RTCAudioProcessingImpl(const webrtc::Environment& env) {
       render_pre_processor_);
 
   apm_ = webrtc::BuiltinAudioProcessingBuilder()
+             .SetEchoCancellerConfig(
+                 WithEarlierEchoRoom(webrtc::EchoCanceller3Config()),
+                 WithEarlierEchoRoom(
+                     webrtc::EchoCanceller3Config::CreateDefaultMultichannelConfig()))
              .SetCapturePostProcessing(std::move(capture_post_processor))
              .SetRenderPreProcessing(std::move(render_pre_processor))
              .Build(env);
