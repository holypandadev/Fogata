 bool VcmCapturer::StartCapture() {
+  // Fogata: a picture of an earlier start is not this one's.
+  got_picture_ = false;
+  first_picture_.Reset();
   int32_t result = capture_thread_->BlockingCall(
       [&] { return vcm_->StartCapture(capability_); });
 
@@ -125,7 +131,47 @@ void VcmCapturer::Destroy() {
 
 VcmCapturer::~VcmCapturer() { Destroy(); }
 
+int VcmCapturer::WaitForStart(int timeout_ms, std::string& why) {
+  why.clear();
+  if (!waits_for_start_) return 0;
+  const int64_t end = webrtc::TimeMillis() + timeout_ms;
+  while (true) {
+    const int64_t left = end - webrtc::TimeMillis();
+    if (first_picture_.Wait(
+            webrtc::TimeDelta::Millis(std::max<int64_t>(
+                0, std::min<int64_t>(left, 50))))) {
+      return 0;
+    }
+    const bool last = webrtc::TimeMillis() >= end;
+    bool running = false;
+    const bool failed = capture_thread_->BlockingCall([&] {
+      if (!vcm_) {
+        why = "the camera was let go";
+        return true;
+      }
+      if (vcm_->CaptureFailed(why)) return true;
+      running = last && vcm_->CaptureStarted();
+      return false;
+    });
+    if (failed) {
+      RTC_LOG(LS_WARNING) << "The camera did not start: " << why;
+      return 1;
+    }
+    if (last) {
+      RTC_LOG(LS_WARNING) << "No picture from the camera in " << timeout_ms
+                          << " ms: " << why;
+      if (running) {
+        why = "no picture yet, the stream runs";
+        return 0;
+      }
+      return 2;
+    }
+  }
+}
+
 void VcmCapturer::OnFrame(const VideoFrame& frame) {
+  // Fogata: the first picture of a start, for WaitForStart.
+  if (!got_picture_.exchange(true)) first_picture_.Set();
   VideoCapturer::OnFrame(frame);
 }
 
