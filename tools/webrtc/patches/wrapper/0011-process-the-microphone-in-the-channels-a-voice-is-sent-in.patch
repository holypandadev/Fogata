diff --git a/test/custom_audio_transport.test.cc b/test/custom_audio_transport.test.cc
new file mode 100644
index 0000000..b0b4256
--- /dev/null
+++ b/test/custom_audio_transport.test.cc
@@ -0,0 +1,67 @@
+#include "src/internal/custom_audio_transport_impl.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+#include "api/audio/audio_frame.h"
+#include "call/audio_sender.h"
+#include "modules/audio_mixer/audio_mixer_impl.h"
+#include "test/gtest.h"
+
+namespace {
+
+// Keeps how many channels the last frame it was given had.
+class Sender : public webrtc::AudioSender {
+ public:
+  void SendAudioData(std::unique_ptr<webrtc::AudioFrame> frame) override {
+    channels = frame->num_channels();
+    ++frames;
+  }
+
+  size_t channels = 0;
+  int frames = 0;
+};
+
+// 10 ms of two channels at 48 kHz, as the audio device records a microphone that
+// can record stereo.
+void Record(webrtc::CustomAudioTransportImpl& transport) {
+  std::vector<int16_t> samples(480 * 2, 1000);
+  uint32_t new_level = 0;
+  transport.RecordedDataIsAvailable(samples.data(), 480, 4, 2, 48000, 0, 0, 0,
+                                    false, new_level);
+}
+
+// The microphone is processed in the channels a voice is sent in, whatever the
+// other channels of sound send: a screen's sound starting to go out in stereo made
+// it two channels, and the audio processing started over each time.
+TEST(CustomAudioTransport, MicrophoneStaysInOneChannelWhileStereoSends) {
+  auto mixer = webrtc::AudioMixerImpl::Create();
+  webrtc::CustomAudioTransportImpl transport(mixer.get(), nullptr, nullptr);
+  // The microphone's own source, which the transport feeds.
+  Sender microphone;
+  transport.AddAudioSender(&microphone);
+  // The streams sending, as AudioState gives them: the voice, then a screen's
+  // sound too.
+  Sender voice;
+  Sender screen;
+
+  transport.UpdateAudioSenders({&voice}, 48000, 1);
+  Record(transport);
+  EXPECT_EQ(microphone.frames, 1);
+  EXPECT_EQ(microphone.channels, 1u);
+
+  transport.UpdateAudioSenders({&voice, &screen}, 48000, 2);
+  Record(transport);
+  EXPECT_EQ(microphone.frames, 2);
+  EXPECT_EQ(microphone.channels, 1u);
+
+  // What the microphone records reaches only its own source.
+  EXPECT_EQ(voice.frames, 0);
+  EXPECT_EQ(screen.frames, 0);
+
+  transport.RemoveAudioSender(&microphone);
+}
+
+}  // namespace
