+#include <vector>
+
+#include "base/portable.h"
+#include "rtc_types.h"
+#include "test/gtest.h"
+
+namespace {
+
+// Every array the vectors under test make, through the library's own functions,
+// which every vector uses: each made and freed exactly once.
+struct Arrays {
+  std::set<void*> live;
+  int made = 0;
+  int freed = 0;
+};
+Arrays arrays;
+
+struct CountedArrays {
+  static void* allocate(size_t count, size_t size) {
+    void* array = portable::allocate_array(count, size);
+    EXPECT_NE(nullptr, array);
+    EXPECT_TRUE(arrays.live.insert(array).second);
+    ++arrays.made;
+    return array;
+  }
+  static void release(void* array) {
+    EXPECT_EQ(1u, arrays.live.erase(array))
+        << "an array freed twice, or one never made";
+    ++arrays.freed;
+    portable::free_array(array);
+  }
+};
+
+// An element that knows which of its kind are alive: each constructed once and
+// destroyed once, never copied from nor assigned to when not alive. It has no
+// default constructor, so a vector never makes elements it was not given.
+class Element {
+ public:
+  explicit Element(int value) : value_(value) { Born(); }
+  Element(const Element& o) : value_(o.value()) { Born(); }
+  Element& operator=(const Element& o) {
+    EXPECT_TRUE(Alive()) << "assigned to while not alive";
+    value_ = o.value();
+    return *this;
+  }
+  ~Element() {
+    EXPECT_EQ(1u, Live().erase(this))
+        << "destroyed twice, or never constructed";
+  }
+
+  int value() const {
+    EXPECT_TRUE(Alive()) << "read while not alive";
+    return value_;
+  }
+
+  static size_t Count() { return Live().size(); }
+
+ private:
+  static std::set<const Element*>& Live() {
+    static std::set<const Element*> live;
+    return live;
+  }
+  void Born() { EXPECT_TRUE(Live().insert(this).second); }
+  bool Alive() const { return Live().count(this) == 1; }
+
+  int value_;
+};
+
+using Vector = portable::vector<Element, CountedArrays>;
+
+std::vector<Element> Elements(std::initializer_list<int> values) {
+  std::vector<Element> elements;
+  elements.reserve(values.size());
+  for (int value : values) {
+    elements.emplace_back(value);
+  }
+  return elements;
+}
+
+Vector Make(std::initializer_list<int> values) {
+  return Vector(Elements(values));
+}
+
+std::vector<int> Values(const Vector& v) {
+  std::vector<int> values;
+  for (size_t i = 0; i < v.size(); ++i) {
+    values.push_back(v[i].value());
+  }
+  return values;
+}
+
+// Each test starts with no array and no element, and must end so.
+class PortableVector : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    arrays = Arrays();
+    ASSERT_EQ(0u, Element::Count());
+  }
+
+  void TearDown() override {
+    EXPECT_EQ(0u, Element::Count()) << "elements left alive";
+    EXPECT_TRUE(arrays.live.empty()) << "arrays never freed";
+    EXPECT_EQ(arrays.made, arrays.freed);
+  }
+};
+
