+  Vector a = Make({1, 2, 3});
+  const Element* array = a.data();
+  Vector b(a.move());
+  EXPECT_EQ(array, b.data());
+  EXPECT_EQ(0u, a.size());
+  EXPECT_EQ(nullptr, a.data());
+
+  Vector c = Make({4, 5});
+  c = b.move();
+  EXPECT_EQ(array, c.data());
+  EXPECT_EQ((std::vector<int>{1, 2, 3}), Values(c));
+  EXPECT_EQ(0u, b.size());
+
+  c = c.move();
+  EXPECT_EQ(array, c.data());
+  EXPECT_EQ(3u, Element::Count());
+  EXPECT_EQ(2, arrays.made);
+  EXPECT_EQ(1, arrays.freed);
+}
+
+TEST_F(PortableVector, ClearFreesOnce) {
+  Vector a = Make({1, 2, 3});
+  a.clear();
+  EXPECT_EQ(0u, a.size());
+  EXPECT_EQ(nullptr, a.data());
+  EXPECT_EQ(0u, Element::Count());
+  EXPECT_EQ(1, arrays.freed);
+  a.clear();
+  EXPECT_EQ(1, arrays.freed);
+}
+
+TEST_F(PortableVector, CopiesAnArrayItIsGiven) {
+  std::vector<Element> elements = Elements({1, 2});
+  {
+    Vector v(elements.data(), elements.size());
+    const Element* constant = elements.data();
+    Vector w(constant, elements.size());
+    EXPECT_NE(elements.data(), v.data());
+    EXPECT_EQ((std::vector<int>{1, 2}), Values(v));
+    EXPECT_EQ((std::vector<int>{1, 2}), Values(w));
+  }
+  EXPECT_EQ(2u, Element::Count());
+  EXPECT_EQ(2, arrays.freed);
+}
+
+TEST_F(PortableVector, ConvertsWhatItIsGiven) {
+  Vector v(std::vector<int>{1, 2, 3}, [](int i) { return Element(i * 10); });
+  EXPECT_EQ((std::vector<int>{10, 20, 30}), Values(v));
+  EXPECT_EQ(3u, Element::Count());
+}
+
+TEST_F(PortableVector, GivesAStdVector) {
+  Vector v = Make({1, 2});
+  std::vector<Element> copy = v.std_vector();
+  ASSERT_EQ(2u, copy.size());
+  EXPECT_EQ(2, copy[1].value());
+  EXPECT_EQ(4u, Element::Count());
+}
+
+// The library's own arrays, as every vector takes them.
+TEST_F(PortableVector, LibraryArrays) {
+  EXPECT_EQ(nullptr, portable::allocate_array(0, sizeof(Element)));
+  portable::free_array(nullptr);
+  void* array = portable::allocate_array(3, 24);
+  ASSERT_NE(nullptr, array);
+  EXPECT_EQ(0u, reinterpret_cast<uintptr_t>(array) % alignof(std::max_align_t));
+  portable::free_array(array);
+  {
+    portable::vector<Element> v(Elements({1, 2, 3}));
+    portable::vector<Element> w(v);
+    w = v;
+    w.clear();
+    w = v;
+    EXPECT_EQ(3, w[2].value());
+    EXPECT_EQ(6u, Element::Count());
+  }
+}
+
+// Strings longer than a string holds in itself, copied and assigned in vectors, and
+// a string given itself.
+TEST_F(PortableVector, Strings) {
+  const std::string long_text(100, 'x');
+  libwebrtc::vector<libwebrtc::string> v(std::vector<std::string>{long_text, "short"});
+  libwebrtc::vector<libwebrtc::string> w;
+  w = v;
+  ASSERT_EQ(2u, w.size());
+  EXPECT_EQ(long_text, w[0].std_string());
+  EXPECT_EQ("short", w[1].std_string());
+  libwebrtc::string s(long_text);
+  libwebrtc::string& same = s;
+  s = same;
+  EXPECT_EQ(long_text, s.std_string());
+}
+
+TEST_F(PortableVector, Map) {
+  std::map<int, Element> elements;
+  elements.emplace(1, Element(10));
+  elements.emplace(2, Element(20));
+  {
+    portable::map<int, Element> m(elements);
+    ASSERT_EQ(2u, m.size());
+    EXPECT_EQ(1, m.data()[0].key);
+    EXPECT_EQ(20, m.data()[1].value.value());
+    portable::map<int, Element> copy(m);
+    portable::map<int, Element> taken(copy.move());
+    EXPECT_EQ(0u, copy.size());
+    ASSERT_EQ(2u, taken.size());
+    EXPECT_EQ(10, taken.data()[0].value.value());
+    copy = m;
+    EXPECT_EQ(2u, copy.size());
+    EXPECT_EQ(8u, Element::Count());
+  }
+  EXPECT_EQ(2u, Element::Count());
+}
+
+}  // namespace
diff --git a/test/stats_callback.test.cc b/test/stats_callback.test.cc
new file mode 100644
index 0000000..146fa1d
--- /dev/null
+++ b/test/stats_callback.test.cc
@@ -0,0 +1,82 @@
+#include <cstddef>
+#include <memory>
+
+#include "api/units/time_delta.h"
+#include "libwebrtc.h"
+#include "rtc_base/event.h"
+#include "rtc_mediaconstraints.h"
+#include "rtc_peerconnection.h"
+#include "rtc_peerconnection_factory.h"
+#include "test/gtest.h"
+
+using libwebrtc::LibWebRTC;
+using libwebrtc::MediaRTCStats;
+using libwebrtc::scoped_refptr;
+
+namespace {
+
+constexpr webrtc::TimeDelta kWait = webrtc::TimeDelta::Seconds(10);
+
+// A statistics read lets go of its callback, and of whatever its closures hold,
+// once the report was delivered and the caller let go: the callback kept one more
+// reference than WebRTC gave back, so every read kept its closures for good (in the
+// plugin, the method's result and the shared pointer to it).
+TEST(StatsCallback, LetGoOfOnceTheReportIsDelivered) {
+  ASSERT_TRUE(LibWebRTC::Initialize());
+  scoped_refptr<libwebrtc::RTCPeerConnectionFactory> factory =
+      LibWebRTC::CreateRTCPeerConnectionFactory();
+  ASSERT_TRUE(factory.get() != nullptr);
+  ASSERT_TRUE(factory->Initialize());
+  libwebrtc::RTCConfiguration config{};
+  scoped_refptr<libwebrtc::RTCPeerConnection> pc =
+      factory->Create(config, libwebrtc::RTCMediaConstraints::Create());
+  ASSERT_TRUE(pc.get() != nullptr);
+
+  // Captured by both closures, as the plugin captures its result.
+  auto held = std::make_shared<int>(0);
+  std::weak_ptr<int> watched = held;
+  webrtc::Event delivered;
+  size_t reports = 0;
+  size_t members = 0;
+  pc->GetStats(
+      [held, &delivered, &reports, &members](
+          const libwebrtc::vector<scoped_refptr<MediaRTCStats>> stats) {
+        reports = stats.size();
+        for (size_t i = 0; i < stats.size(); ++i) {
+          members += stats[i]->Members().size();
+        }
+        delivered.Set();
+      },
+      [held, &delivered](const char* error) {
+        ADD_FAILURE() << error;
+        delivered.Set();
+      });
+  held.reset();
+  ASSERT_TRUE(delivered.Wait(kWait));
+  EXPECT_GT(reports, 0u);
+  EXPECT_GT(members, 0u);
+
+  // The first report is delivered by a task on the signalling thread, which lets
+  // go of the request (and its callback) as it ends; the second read is delivered
+  // by a later task on that thread, so the first callback is gone by then.
+  webrtc::Event second;
+  pc->GetStats(
+      [&second](const libwebrtc::vector<scoped_refptr<MediaRTCStats>>) {
+        second.Set();
+      },
+      [&second](const char* error) {
+        ADD_FAILURE() << error;
+        second.Set();
+      });
+  ASSERT_TRUE(second.Wait(kWait));
+  EXPECT_TRUE(watched.expired())
+      << "the first read's callback and its closures are still held";
+
+  factory->Delete(pc);
+  pc = nullptr;
+  factory->Terminate();
+  factory = nullptr;
+  LibWebRTC::Terminate();
+}
+
+}  // namespace
