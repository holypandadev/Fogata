@@ -101,7 +101,7 @@ bool RTCPeerConnectionFactoryImpl::Initialize() {
 
   if (!audio_processing_impl_) {
     worker_thread_->BlockingCall([this] {
-      audio_processing_impl_ = new RefCountedObject<RTCAudioProcessingImpl>();
+      audio_processing_impl_ = new RefCountedObject<RTCAudioProcessingImpl>(env_);
