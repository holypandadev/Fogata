List and tell audio devices from safe threads

The audio device module's lists were read on whichever thread asked (the plugin's
platform thread), while every other call reached the module on the worker thread: on
Linux the module now connects again there to a sound server that went away, which
changes what the lists are read from, so the counts are read there too. The module tells
its observer (OnDevicesUpdated) from its own threads: the listener is now set and called
under a lock, and a null listener stops it, so its owner can let go of it; the observer
itself is taken off the module when it goes, as the module outlives it.

diff --git a/src/rtc_audio_device_impl.cc b/src/rtc_audio_device_impl.cc
index bd3e338..32e3ed1 100644
--- a/src/rtc_audio_device_impl.cc
+++ b/src/rtc_audio_device_impl.cc
@@ -13,14 +13,26 @@ AudioDeviceImpl::AudioDeviceImpl(
 
 AudioDeviceImpl::~AudioDeviceImpl() {
   RTC_LOG(LS_INFO) << __FUNCTION__ << ": dtor ";
+  // Fogata: the audio device module outlives this object (the voice engine holds
+  // it), and tells its observer from its own threads: not this one once gone.
+  audio_device_module_->SetObserver(nullptr);
 }
 
+// Fogata: on the worker thread, as every other call of the audio device module: on
+// Linux the module connects there again to a sound server that went away, which
+// changes what the lists are read from.
 int16_t AudioDeviceImpl::PlayoutDevices() {
-  return audio_device_module_->PlayoutDevices();
+  return worker_thread_->BlockingCall([&] {
+    RTC_DCHECK_RUN_ON(worker_thread_);
+    return audio_device_module_->PlayoutDevices();
+  });
 }
 
 int16_t AudioDeviceImpl::RecordingDevices() {
-  return audio_device_module_->RecordingDevices();
+  return worker_thread_->BlockingCall([&] {
+    RTC_DCHECK_RUN_ON(worker_thread_);
+    return audio_device_module_->RecordingDevices();
+  });
 }
 
 int32_t AudioDeviceImpl::PlayoutDeviceName(uint16_t index,
@@ -102,11 +114,15 @@ int32_t AudioDeviceImpl::SpeakerVolume(uint32_t& volume) {
 }
 
 int32_t AudioDeviceImpl::OnDeviceChange(OnDeviceChangeCallback listener) {
+  // Fogata: under the lock, as the module calls it from its own threads; a null
+  // listener stops it (as its owner goes).
+  webrtc::MutexLock lock(&listener_mutex_);
   listener_ = listener;
   return 0;
 }
 
 void AudioDeviceImpl::OnDevicesUpdated() {
+  webrtc::MutexLock lock(&listener_mutex_);
   if (listener_) listener_();
 }
 
diff --git a/src/rtc_audio_device_impl.h b/src/rtc_audio_device_impl.h
index 2dd713c..1ec6733 100644
--- a/src/rtc_audio_device_impl.h
+++ b/src/rtc_audio_device_impl.h
@@ -5,6 +5,7 @@
 #include "modules/audio_device/include/audio_device.h"
 #include "rtc_audio_device.h"
 #include "rtc_base/ref_count.h"
+#include "rtc_base/synchronization/mutex.h"
 #include "rtc_base/thread.h"
 
 namespace libwebrtc {
@@ -47,7 +48,8 @@ class AudioDeviceImpl : public RTCAudioDevice, public webrtc::AudioDeviceObserve
  private:
   webrtc::scoped_refptr<webrtc::AudioDeviceModule> audio_device_module_;
   webrtc::Thread* worker_thread_ = nullptr;
-  OnDeviceChangeCallback listener_ = nullptr;
+  webrtc::Mutex listener_mutex_;
+  OnDeviceChangeCallback listener_ RTC_GUARDED_BY(listener_mutex_) = nullptr;
 };
 
 }  // namespace libwebrtc
