+RTCVideoDeviceImpl::~RTCVideoDeviceImpl() {
+#if defined(WEBRTC_USE_PIPEWIRE)
+  // The portal's session tells no one any more.
+  portal_info_ = nullptr;
+  options_ = nullptr;
+#endif
+}
+
+void RTCVideoDeviceImpl::SetCameraPortal(bool portal, bool direct_fallback) {
+#if defined(WEBRTC_USE_PIPEWIRE)
+  webrtc::MutexLock lock(&mutex_);
+  if (options_) return;  // Asked for already: kept as it is.
+  portal_ = portal;
+  direct_fallback_ = direct_fallback;
+  access_ = portal ? kCameraAccessNotAsked : kCameraAccessDirect;
+#endif
+}
+
+RTCVideoDevice::CameraAccess RTCVideoDeviceImpl::GetCameraAccess() {
+#if defined(WEBRTC_USE_PIPEWIRE)
+  return static_cast<CameraAccess>(access_.load());
+#else
+  return kCameraAccessDirect;
+#endif
+}
+
+void RTCVideoDeviceImpl::RequestCameraAccess(CameraAccessCallback done) {
+#if defined(WEBRTC_USE_PIPEWIRE)
+  webrtc::VideoCaptureOptions* asking = nullptr;
+  CameraAccess now;
+  {
+    webrtc::MutexLock lock(&mutex_);
+    now = static_cast<CameraAccess>(access_.load());
+    if (now != kCameraAccessDirect && now != kCameraAccessGranted) {
+      waiting_.push_back(std::move(done));
+      if (now == kCameraAccessAsking) return;
+      // A session that was not granted has finished: it can go.
+      options_ = std::make_unique<webrtc::VideoCaptureOptions>();
+      options_->set_allow_pipewire(true);
+      options_->set_allow_v4l2(false);
+      asking = options_.get();
+      access_ = kCameraAccessAsking;
+    }
+  }
+  if (!asking) {
+    done(now);
+    return;
+  }
+  // Answers in OnInitialized, never from within Init: the portal answers from
+  // the main loop, PipeWire from its own thread.
+  asking->Init(this);
+#else
+  done(kCameraAccessDirect);
+#endif
+}
+
+#if defined(WEBRTC_USE_PIPEWIRE)
+void RTCVideoDeviceImpl::OnInitialized(
+    webrtc::VideoCaptureOptions::Status status) {
+  using Status = webrtc::VideoCaptureOptions::Status;
+  const CameraAccess access = status == Status::SUCCESS ? kCameraAccessGranted
+                              : status == Status::DENIED
+                                  ? kCameraAccessDenied
+                                  : kCameraAccessUnavailable;
+  RTC_LOG(LS_INFO) << "Camera portal: " << static_cast<int>(status);
+  std::vector<CameraAccessCallback> waiting;
+  {
+    webrtc::MutexLock lock(&mutex_);
+    if (access == kCameraAccessGranted) {
+      portal_info_ =
+          std::make_unique<webrtc::videocapturemodule::DeviceInfoPipeWire>(
+              options_.get());
+    }
+    // After the device info, which those who read it see granted.
+    access_ = access;
+    waiting.swap(waiting_);
+  }
+  for (auto& done : waiting) done(access);
+}
+#endif
+
+webrtc::VideoCaptureModule::DeviceInfo* RTCVideoDeviceImpl::Current(
+    webrtc::VideoCaptureOptions** options) {
+  *options = nullptr;
+#if defined(WEBRTC_USE_PIPEWIRE)
+  switch (access_.load()) {
+    case kCameraAccessDirect:
+      break;
+    case kCameraAccessGranted:
+      // Neither changes once granted.
+      *options = options_.get();
+      return portal_info_.get();
+    case kCameraAccessUnavailable:
+      if (direct_fallback_) break;
+      return nullptr;
+    default:
+      return nullptr;
+  }
+#endif
+  return device_info_.get();
+}
