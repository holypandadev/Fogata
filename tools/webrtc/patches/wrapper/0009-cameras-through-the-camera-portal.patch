 class RTCVideoDevice : public RefCountInterface {
  public:
+  // How the cameras are reached. Opened directly (V4L2 on Linux, as on Windows)
+  // there is nothing to ask. On Linux they can instead be reached through
+  // xdg-desktop-portal's Camera interface and PipeWire, which asks the person
+  // (or the permissions they gave before) once for all of them: the only way out
+  // of a sandbox that has no /dev/video*, such as a Flatpak's.
+  enum CameraAccess {
+    kCameraAccessDirect = 0,
+    // Through the portal, not asked yet: no camera is listed.
+    kCameraAccessNotAsked = 1,
+    kCameraAccessAsking = 2,
+    kCameraAccessGranted = 3,
+    // The person said no (now or before).
+    kCameraAccessDenied = 4,
+    // No portal, a portal without the Camera interface, or no PipeWire.
+    kCameraAccessUnavailable = 5,
+  };
+  typedef fixed_size_function<void(CameraAccess)> CameraAccessCallback;
+
   virtual uint32_t NumberOfDevices() = 0;
 
   virtual int32_t GetDeviceName(uint32_t deviceNumber, char* deviceNameUTF8,
@@ -32,6 +50,20 @@ class RTCVideoDevice : public RefCountInterface {
                                                  size_t height,
                                                  size_t target_fps) = 0;
 
+  // Linux: lists and opens the cameras through the Camera portal and PipeWire
+  // ([portal]) or through V4L2 (the default). With [direct_fallback] too, V4L2
+  // stands in while the portal is unavailable, never when it was denied.
+  // Elsewhere it does nothing. Call it before anything is listed.
+  virtual void SetCameraPortal(bool portal, bool direct_fallback) = 0;
+
+  virtual CameraAccess GetCameraAccess() = 0;
+
+  // Asks the portal for the cameras, unless they were granted or are being
+  // asked for; asked again after a denial, the system may answer without asking
+  // the person. [done] runs once with the outcome, on the thread that learns it:
+  // GLib's main loop (the portal's answers) or PipeWire's, or at once.
+  virtual void RequestCameraAccess(CameraAccessCallback done) = 0;
+
  protected:
   virtual ~RTCVideoDevice() {}
 };
