+// A change of devices and a device restart marked while recording is stopped (WebRTC
+// patch 0015: a stream the server moved while muted), the first recorded block
+// reaching the audio processing before the audio state's start of recording returns:
+// that block realigns keeping the transparent mode and takes the change as handled,
+// but the unmute read the counts before it and still restarts for other devices,
+// forgetting the transparent mode (WebRTC patch 0016).
+TEST_F(EchoCall, AChangeMarkedWhileStoppedIsForgottenAtTheUnmute) {
+  state_->AddReceivingStream(&heard_);
+  Start();
+  Deliver();
+  state_->RemoveSendingStream(&voice_);
+  webrtc::MarkAudioDevicesChanged();
+  webrtc::MarkAudioDeviceRestarted();
+  Count();
+  const int others = restarts_for_other_devices;
+  deliver_on_start_ = true;
+  delivered_ = 0;
+  state_->AddSendingStream(&voice_, 48000, 1);
+  deliver_on_start_ = false;
+  marks_ = webrtc::AudioDevicesChangedCount().load();
+  EXPECT_EQ(delivered_, 1) << "a block before the start returned";
+  EXPECT_EQ(Made(), 0);
+  EXPECT_EQ(restarts_for_other_devices, others + 1)
+      << "the unmute after the change forgets the transparent mode";
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
