@@ -0,0 +1,98 @@
+#ifndef LIB_WEBRTC_VP8_SIZE_GATE_H_
+#define LIB_WEBRTC_VP8_SIZE_GATE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "api/environment/environment.h"
+#include "api/video/video_frame_buffer.h"
+#include "api/video_codecs/sdp_video_format.h"
+#include "api/video_codecs/video_decoder.h"
+#include "api/video_codecs/video_decoder_factory.h"
+
+namespace libwebrtc {
+
+// Largest picture a VP8 decoder is given: no side over 8192 pixels and at most
+// 8K (7680 by 4320) of them, the largest screen shared as captured. A peer can
+// send keyframes of up to 16383 by 16383 pixels, which libvpx makes room for
+// (about a gigabyte) before anything else sees the frame.
+constexpr int kMaxDecodedSide = 8192;
+constexpr int64_t kMaxDecodedPixels = int64_t{7680} * 4320;
+
+struct Vp8Size {
+  int width;
+  int height;
+};
+
+// The picture size a VP8 keyframe's header announces (RFC 6386, 9.1: a 3-byte
+// frame tag, the start code 9d 01 2a, then 14 bits of width and of height,
+// each followed by 2 bits of scaling, little endian). Nothing for an
+// interframe, which keeps the size of the keyframe before it. A keyframe too
+// short to hold its header announces 0 by 0.
+std::optional<Vp8Size> Vp8KeyframeSize(const uint8_t* data, size_t size);
+
+// Whether a picture of that size is given to a decoder.
+bool DecodedSizeAllowed(int width, int height);
+
+// What a VP8 decoder hands on in place of a keyframe larger than
+// DecodedSizeAllowed lets through, without decoding it: a black 2 by 2 picture
+// that carries the size refused, so whoever shows the track can tell.
+// Everything in between sees an ordinary small picture.
+class TooLargeFrameBuffer : public webrtc::I420BufferInterface {
+ public:
+  TooLargeFrameBuffer(int refused_width, int refused_height);
+
+  // The refused size, when `buffer` is one of these; checked by what it says of
+  // its storage, as the library is built without run-time type information.
+  static std::optional<Vp8Size> RefusedSize(
+      const webrtc::VideoFrameBuffer& buffer);
+
+  int width() const override;
+  int height() const override;
+  const uint8_t* DataY() const override;
+  const uint8_t* DataU() const override;
+  const uint8_t* DataV() const override;
+  int StrideY() const override;
+  int StrideU() const override;
+  int StrideV() const override;
+  std::string storage_representation() const override;
+
+ private:
+  int refused_width_;
+  int refused_height_;
+  uint8_t y_[4];
+  uint8_t u_[1];
+  uint8_t v_[1];
+};
+
+// Wraps a decoder factory: every VP8 decoder it makes refuses keyframes larger
+// than DecodedSizeAllowed lets through before the decoder sees them, and the
+// interframes after them until the next keyframe it lets through.
+class SizeGateDecoderFactory : public webrtc::VideoDecoderFactory {
+ public:
+  explicit SizeGateDecoderFactory(
+      std::unique_ptr<webrtc::VideoDecoderFactory> inner);
+
+  std::vector<webrtc::SdpVideoFormat> GetSupportedFormats() const override;
+  CodecSupport QueryCodecSupport(
+      const webrtc::SdpVideoFormat& format,
+      bool reference_scaling,
+      std::optional<webrtc::Resolution> resolution) const override;
+  std::unique_ptr<webrtc::VideoDecoder> Create(
+      const webrtc::Environment& env,
+      const webrtc::SdpVideoFormat& format) override;
+
+ private:
+  std::unique_ptr<webrtc::VideoDecoderFactory> inner_;
+};
+
+// The decoder SizeGateDecoderFactory makes for VP8 (exposed for its tests).
+std::unique_ptr<webrtc::VideoDecoder> CreateVp8SizeGate(
+    std::unique_ptr<webrtc::VideoDecoder> inner);
+
+}  // namespace libwebrtc
+
+#endif  // LIB_WEBRTC_VP8_SIZE_GATE_H_
