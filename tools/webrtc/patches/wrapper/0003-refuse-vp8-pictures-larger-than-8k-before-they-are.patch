diff --git a/src/internal/vp8_size_gate.cc b/src/internal/vp8_size_gate.cc
new file mode 100644
index 0000000..0202e4f
--- /dev/null
+++ b/src/internal/vp8_size_gate.cc
@@ -0,0 +1,199 @@
+#include "src/internal/vp8_size_gate.h"
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <utility>
+
+#include "absl/strings/match.h"
+#include "api/make_ref_counted.h"
+#include "api/video/encoded_image.h"
+#include "api/video/video_frame.h"
+#include "modules/video_coding/include/video_error_codes.h"
+#include "rtc_base/logging.h"
+
+namespace libwebrtc {
+
+namespace {
+
+constexpr char kTooLargeTag[] = "fogata-too-large ";
+
+class Vp8SizeGate : public webrtc::VideoDecoder {
+ public:
+  explicit Vp8SizeGate(std::unique_ptr<webrtc::VideoDecoder> inner)
+      : inner_(std::move(inner)) {}
+
+  bool Configure(const Settings& settings) override {
+    waiting_for_keyframe_ = false;
+    return inner_->Configure(settings);
+  }
+
+  using webrtc::VideoDecoder::Decode;
+  int32_t Decode(const webrtc::EncodedImage& input,
+                 int64_t render_time_ms) override {
+    std::optional<Vp8Size> size = Vp8KeyframeSize(input.data(), input.size());
+    if (size) {
+      if (!DecodedSizeAllowed(size->width, size->height)) {
+        waiting_for_keyframe_ = true;
+        if (!told_) {
+          RTC_LOG(LS_WARNING) << "Refusing VP8 keyframes of " << size->width
+                              << "x" << size->height << ": too large to decode";
+          told_ = true;
+        }
+        if (callback_ != nullptr) {
+          webrtc::VideoFrame frame =
+              webrtc::VideoFrame::Builder()
+                  .set_video_frame_buffer(
+                      webrtc::make_ref_counted<TooLargeFrameBuffer>(
+                          size->width, size->height))
+                  .set_rtp_timestamp(input.RtpTimestamp())
+                  .set_timestamp_ms(render_time_ms)
+                  .build();
+          callback_->Decoded(frame, std::nullopt, std::nullopt);
+        }
+        return WEBRTC_VIDEO_CODEC_OK;
+      }
+      waiting_for_keyframe_ = false;
+    } else if (waiting_for_keyframe_) {
+      // It would be decoded on what came before the refused keyframe; asking
+      // for another keyframe is what an error here does.
+      return WEBRTC_VIDEO_CODEC_ERROR;
+    }
+    return inner_->Decode(input, render_time_ms);
+  }
+
+  int32_t RegisterDecodeCompleteCallback(
+      webrtc::DecodedImageCallback* callback) override {
+    callback_ = callback;
+    return inner_->RegisterDecodeCompleteCallback(callback);
+  }
+
+  int32_t Release() override { return inner_->Release(); }
+
+  DecoderInfo GetDecoderInfo() const override {
+    return inner_->GetDecoderInfo();
+  }
+
+  const char* ImplementationName() const override {
+    return inner_->ImplementationName();
+  }
+
+ private:
+  std::unique_ptr<webrtc::VideoDecoder> inner_;
+  webrtc::DecodedImageCallback* callback_ = nullptr;
+  bool waiting_for_keyframe_ = false;
+  bool told_ = false;
+};
+
+}  // namespace
+
+std::optional<Vp8Size> Vp8KeyframeSize(const uint8_t* data, size_t size) {
+  if (data == nullptr || size < 1 || (data[0] & 0x01) != 0) {
+    return std::nullopt;  // An interframe (or nothing at all).
+  }
+  if (size < 10 || data[3] != 0x9d || data[4] != 0x01 || data[5] != 0x2a) {
+    return Vp8Size{0, 0};
+  }
+  return Vp8Size{(data[6] | (data[7] << 8)) & 0x3fff,
+                 (data[8] | (data[9] << 8)) & 0x3fff};
+}
+
+bool DecodedSizeAllowed(int width, int height) {
+  return width <= kMaxDecodedSide && height <= kMaxDecodedSide &&
+         int64_t{width} * height <= kMaxDecodedPixels;
+}
+
+TooLargeFrameBuffer::TooLargeFrameBuffer(int refused_width, int refused_height)
+    : refused_width_(refused_width), refused_height_(refused_height) {
+  memset(y_, 0, sizeof(y_));
+  memset(u_, 128, sizeof(u_));
+  memset(v_, 128, sizeof(v_));
+}
+
+std::optional<Vp8Size> TooLargeFrameBuffer::RefusedSize(
+    const webrtc::VideoFrameBuffer& buffer) {
+  if (buffer.type() != Type::kI420 || buffer.width() != 2 ||
+      buffer.height() != 2) {
+    return std::nullopt;
+  }
+  const std::string what = buffer.storage_representation();
+  if (!absl::StartsWith(what, kTooLargeTag)) {
+    return std::nullopt;
+  }
+  Vp8Size size{0, 0};
+  if (sscanf(what.c_str() + sizeof(kTooLargeTag) - 1, "%dx%d", &size.width,
+             &size.height) != 2) {
+    return std::nullopt;
+  }
+  return size;
+}
+
+int TooLargeFrameBuffer::width() const {
+  return 2;
+}
+int TooLargeFrameBuffer::height() const {
+  return 2;
+}
+const uint8_t* TooLargeFrameBuffer::DataY() const {
+  return y_;
+}
+const uint8_t* TooLargeFrameBuffer::DataU() const {
+  return u_;
+}
+const uint8_t* TooLargeFrameBuffer::DataV() const {
+  return v_;
+}
+int TooLargeFrameBuffer::StrideY() const {
+  return 2;
+}
+int TooLargeFrameBuffer::StrideU() const {
+  return 1;
+}
+int TooLargeFrameBuffer::StrideV() const {
+  return 1;
+}
+std::string TooLargeFrameBuffer::storage_representation() const {
+  return kTooLargeTag + std::to_string(refused_width_) + "x" +
+         std::to_string(refused_height_);
+}
+
+SizeGateDecoderFactory::SizeGateDecoderFactory(
+    std::unique_ptr<webrtc::VideoDecoderFactory> inner)
+    : inner_(std::move(inner)) {}
+
+std::vector<webrtc::SdpVideoFormat> SizeGateDecoderFactory::GetSupportedFormats()
+    const {
+  return inner_->GetSupportedFormats();
+}
+
+webrtc::VideoDecoderFactory::CodecSupport
+SizeGateDecoderFactory::QueryCodecSupport(
+    const webrtc::SdpVideoFormat& format,
+    bool reference_scaling,
+    std::optional<webrtc::Resolution> resolution) const {
+  return inner_->QueryCodecSupport(format, reference_scaling, resolution);
+}
+
+std::unique_ptr<webrtc::VideoDecoder> SizeGateDecoderFactory::Create(
+    const webrtc::Environment& env,
+    const webrtc::SdpVideoFormat& format) {
+  if (!absl::EqualsIgnoreCase(format.name, "VP8")) {
+    return inner_->Create(env, format);
+  }
+  // VP8 takes no parameters for decoding; a factory made of templates finds a
+  // format only with exactly the parameters it lists, and the ones a description
+  // carries (such as x-google-max-bitrate) would leave the stream with none.
+  std::unique_ptr<webrtc::VideoDecoder> decoder =
+      inner_->Create(env, webrtc::SdpVideoFormat::VP8());
+  if (decoder == nullptr) {
+    return nullptr;
+  }
+  return CreateVp8SizeGate(std::move(decoder));
+}
+
+std::unique_ptr<webrtc::VideoDecoder> CreateVp8SizeGate(
+    std::unique_ptr<webrtc::VideoDecoder> inner) {
+  return std::make_unique<Vp8SizeGate>(std::move(inner));
+}
+
+}  // namespace libwebrtc
