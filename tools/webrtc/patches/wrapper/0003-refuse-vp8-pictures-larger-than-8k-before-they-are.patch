diff --git a/test/vp8_size_gate.test.cc b/test/vp8_size_gate.test.cc
new file mode 100644
index 0000000..de826f2
--- /dev/null
+++ b/test/vp8_size_gate.test.cc
@@ -0,0 +1,195 @@
+#include "src/internal/vp8_size_gate.h"
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "api/environment/environment.h"
+#include "api/make_ref_counted.h"
+#include "api/video/encoded_image.h"
+#include "api/video/i420_buffer.h"
+#include "api/video/video_frame.h"
+#include "api/video/video_frame_type.h"
+#include "api/video_codecs/sdp_video_format.h"
+#include "api/video_codecs/video_decoder_factory.h"
+#include "modules/video_coding/include/video_error_codes.h"
+#include "test/create_test_environment.h"
+#include "test/gtest.h"
+
+namespace {
+
+using libwebrtc::CreateVp8SizeGate;
+using libwebrtc::TooLargeFrameBuffer;
+using libwebrtc::Vp8KeyframeSize;
+using libwebrtc::Vp8Size;
+
+// The first bytes of a VP8 keyframe of `width` by `height` (RFC 6386, 9.1),
+// followed by some payload.
+std::vector<uint8_t> Keyframe(int width, int height) {
+  return {0x50, 0x2a, 0x00, 0x9d, 0x01, 0x2a,
+          static_cast<uint8_t>(width & 0xff),
+          static_cast<uint8_t>(width >> 8),
+          static_cast<uint8_t>(height & 0xff),
+          static_cast<uint8_t>(height >> 8),
+          0x00, 0x00, 0x00, 0x00};
+}
+
+std::vector<uint8_t> Interframe() {
+  return {0x51, 0x2a, 0x00, 0x11, 0x22, 0x33, 0x44, 0x55};
+}
+
+webrtc::EncodedImage Image(const std::vector<uint8_t>& bytes,
+                           uint32_t rtp_timestamp) {
+  webrtc::EncodedImage image;
+  image.SetEncodedData(
+      webrtc::EncodedImageBuffer::Create(bytes.data(), bytes.size()));
+  image.SetRtpTimestamp(rtp_timestamp);
+  image._frameType = (bytes[0] & 1) ? webrtc::VideoFrameType::kVideoFrameDelta
+                                    : webrtc::VideoFrameType::kVideoFrameKey;
+  return image;
+}
+
+// Counts what reaches it.
+class CountingDecoder : public webrtc::VideoDecoder {
+ public:
+  explicit CountingDecoder(int* decoded) : decoded_(decoded) {}
+  bool Configure(const Settings&) override { return true; }
+  int32_t Decode(const webrtc::EncodedImage&, int64_t) override {
+    ++*decoded_;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t RegisterDecodeCompleteCallback(
+      webrtc::DecodedImageCallback*) override {
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Release() override { return WEBRTC_VIDEO_CODEC_OK; }
+
+ private:
+  int* decoded_;
+};
+
+class Collector : public webrtc::DecodedImageCallback {
+ public:
+  using webrtc::DecodedImageCallback::Decoded;
+  int32_t Decoded(webrtc::VideoFrame& frame) override {
+    frames.push_back(frame);
+    return 0;
+  }
+  std::vector<webrtc::VideoFrame> frames;
+};
+
+TEST(Vp8SizeGate, ReadsTheKeyframeHeader) {
+  std::vector<uint8_t> giant = Keyframe(16383, 16383);
+  std::optional<Vp8Size> size = Vp8KeyframeSize(giant.data(), giant.size());
+  ASSERT_TRUE(size.has_value());
+  EXPECT_EQ(size->width, 16383);
+  EXPECT_EQ(size->height, 16383);
+
+  // The two scaling bits above each side are not part of it.
+  std::vector<uint8_t> scaled = Keyframe(0xc000 | 640, 0x4000 | 480);
+  size = Vp8KeyframeSize(scaled.data(), scaled.size());
+  ASSERT_TRUE(size.has_value());
+  EXPECT_EQ(size->width, 640);
+  EXPECT_EQ(size->height, 480);
+
+  std::vector<uint8_t> inter = Interframe();
+  EXPECT_FALSE(Vp8KeyframeSize(inter.data(), inter.size()).has_value());
+
+  std::vector<uint8_t> cut = Keyframe(640, 480);
+  size = Vp8KeyframeSize(cut.data(), 9);
+  ASSERT_TRUE(size.has_value());
+  EXPECT_EQ(size->width, 0);
+}
+
+TEST(Vp8SizeGate, AllowsUpTo8K) {
+  EXPECT_TRUE(libwebrtc::DecodedSizeAllowed(1920, 1080));
+  EXPECT_TRUE(libwebrtc::DecodedSizeAllowed(7680, 4320));
+  EXPECT_TRUE(libwebrtc::DecodedSizeAllowed(8192, 1080));
+  EXPECT_FALSE(libwebrtc::DecodedSizeAllowed(8193, 1080));
+  EXPECT_FALSE(libwebrtc::DecodedSizeAllowed(8192, 8192));
+  EXPECT_FALSE(libwebrtc::DecodedSizeAllowed(16383, 16383));
+}
+
+TEST(Vp8SizeGate, RefusesALargeKeyframeAndWhatFollowsIt) {
+  int decoded = 0;
+  Collector collector;
+  std::unique_ptr<webrtc::VideoDecoder> gate =
+      CreateVp8SizeGate(std::make_unique<CountingDecoder>(&decoded));
+  gate->RegisterDecodeCompleteCallback(&collector);
+
+  EXPECT_EQ(gate->Decode(Image(Keyframe(640, 480), 1), 0),
+            WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(gate->Decode(Image(Interframe(), 2), 0), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(decoded, 2);
+  EXPECT_TRUE(collector.frames.empty());
+
+  // Not decoded: a small picture standing for it goes on instead.
+  EXPECT_EQ(gate->Decode(Image(Keyframe(8192, 8192), 3), 0),
+            WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(decoded, 2);
+  ASSERT_EQ(collector.frames.size(), 1u);
+  const webrtc::VideoFrame& stand_in = collector.frames[0];
+  EXPECT_EQ(stand_in.width(), 2);
+  EXPECT_EQ(stand_in.height(), 2);
+  EXPECT_EQ(stand_in.rtp_timestamp(), 3u);
+  std::optional<Vp8Size> refused =
+      TooLargeFrameBuffer::RefusedSize(*stand_in.video_frame_buffer());
+  ASSERT_TRUE(refused.has_value());
+  EXPECT_EQ(refused->width, 8192);
+  EXPECT_EQ(refused->height, 8192);
+
+  // Interframes after it would be decoded on the picture before it.
+  EXPECT_EQ(gate->Decode(Image(Interframe(), 4), 0), WEBRTC_VIDEO_CODEC_ERROR);
+  EXPECT_EQ(decoded, 2);
+
+  EXPECT_EQ(gate->Decode(Image(Keyframe(1280, 720), 5), 0),
+            WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(gate->Decode(Image(Interframe(), 6), 0), WEBRTC_VIDEO_CODEC_OK);
+  EXPECT_EQ(decoded, 4);
+  EXPECT_EQ(collector.frames.size(), 1u);
+}
+
+// Makes decoders only for formats exactly as it lists them, as a factory made of
+// templates does.
+class ExactFactory : public webrtc::VideoDecoderFactory {
+ public:
+  std::vector<webrtc::SdpVideoFormat> GetSupportedFormats() const override {
+    return {webrtc::SdpVideoFormat::VP8()};
+  }
+  std::unique_ptr<webrtc::VideoDecoder> Create(
+      const webrtc::Environment&,
+      const webrtc::SdpVideoFormat& format) override {
+    if (!(format == webrtc::SdpVideoFormat::VP8())) {
+      return nullptr;
+    }
+    return std::make_unique<CountingDecoder>(&decoded);
+  }
+  int decoded = 0;
+};
+
+TEST(Vp8SizeGate, MakesDecodersForVp8WithParameters) {
+  auto inner = std::make_unique<ExactFactory>();
+  ExactFactory* exact = inner.get();
+  libwebrtc::SizeGateDecoderFactory factory(std::move(inner));
+  const webrtc::Environment env = webrtc::CreateTestEnvironment();
+  std::unique_ptr<webrtc::VideoDecoder> decoder = factory.Create(
+      env, webrtc::SdpVideoFormat("VP8", {{"x-google-max-bitrate", "1500"}}));
+  ASSERT_NE(decoder, nullptr);
+  decoder->Decode(Image(Keyframe(640, 480), 1), 0);
+  EXPECT_EQ(exact->decoded, 1);
+  decoder->Decode(Image(Keyframe(16383, 16383), 2), 0);
+  EXPECT_EQ(exact->decoded, 1);
+  EXPECT_EQ(factory.Create(env, webrtc::SdpVideoFormat("VP9")), nullptr);
+}
+
+TEST(Vp8SizeGate, OrdinaryBuffersAreNotRefused) {
+  webrtc::scoped_refptr<TooLargeFrameBuffer> refused =
+      webrtc::make_ref_counted<TooLargeFrameBuffer>(16383, 16383);
+  EXPECT_TRUE(TooLargeFrameBuffer::RefusedSize(*refused).has_value());
+  webrtc::scoped_refptr<webrtc::I420Buffer> small =
+      webrtc::I420Buffer::Create(2, 2);
+  EXPECT_FALSE(TooLargeFrameBuffer::RefusedSize(*small).has_value());
+}
