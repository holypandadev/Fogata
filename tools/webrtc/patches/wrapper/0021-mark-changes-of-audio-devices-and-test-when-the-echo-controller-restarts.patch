diff --git a/test/echo_call.test.cc b/test/echo_call.test.cc
new file mode 100644
index 0000000..9a9e998
--- /dev/null
+++ b/test/echo_call.test.cc
@@ -0,0 +1,237 @@
+// WebRTC's audio state and audio processing with Fogata's patches 0010 and 0011
+// (tools/webrtc/patches/webrtc): a call's start makes the echo controller anew;
+// only a microphone turned on again in the call recording stopped in restarts it
+// for recording, and not after a change of audio devices
+// (MarkAudioDevicesChanged). Built in again with mocks: the library shows only
+// its own API.
+
+#include <memory>
+
+#include "api/audio/audio_device.h"
+#include "api/audio/audio_processing.h"
+#include "api/audio/builtin_audio_processing_builder.h"
+#include "api/audio/echo_control.h"
+#include "api/make_ref_counted.h"
+#include "api/scoped_refptr.h"
+#include "audio/audio_state.h"
+#include "call/test/mock_audio_receive_stream.h"
+#include "call/test/mock_audio_send_stream.h"
+#include "modules/audio_device/include/mock_audio_device.h"
+#include "modules/audio_mixer/audio_mixer_impl.h"
+#include "test/create_test_environment.h"
+#include "test/gmock.h"
+#include "test/gtest.h"
+
+namespace {
+
+using ::testing::Return;
+
+// An echo controller that restarts for recording, counting each restart.
+class Restartable : public webrtc::EchoControl {
+ public:
+  explicit Restartable(int* restarted) : restarted_(restarted) {}
+  void AnalyzeRender(webrtc::AudioBuffer*) override {}
+  void AnalyzeCapture(webrtc::AudioBuffer*) override {}
+  void ProcessCapture(webrtc::AudioBuffer*, bool) override {}
+  void ProcessCapture(webrtc::AudioBuffer*, webrtc::AudioBuffer*,
+                      bool) override {}
+  Metrics GetMetrics() const override { return Metrics(); }
+  void SetAudioBufferDelay(int) override {}
+  bool ActiveProcessing() const override { return true; }
+  bool RestartForRecording() override {
+    ++*restarted_;
+    return true;
+  }
+
+ private:
+  int* const restarted_;
+};
+
+class Factory : public webrtc::EchoControlFactory {
+ public:
+  Factory(int* made, int* restarted) : made_(made), restarted_(restarted) {}
+  using webrtc::EchoControlFactory::Create;
+  std::unique_ptr<webrtc::EchoControl> Create(const webrtc::Environment&,
+                                              int, int, int) override {
+    ++*made_;
+    return std::make_unique<Restartable>(restarted_);
+  }
+
+ private:
+  int* const made_;
+  int* const restarted_;
+};
+
+// One audio state with a real audio processing (echo controller from Factory)
+// and a mock audio device whose recording starts unless told to fail.
+class EchoCall : public ::testing::Test {
+ protected:
+  EchoCall() {
+    apm_ = webrtc::BuiltinAudioProcessingBuilder()
+               .SetEchoControlFactory(
+                   std::make_unique<Factory>(&made_, &restarted_))
+               .Build(webrtc::CreateTestEnvironment());
+    webrtc::AudioProcessing::Config config;
+    config.echo_canceller.enabled = true;
+    apm_->ApplyConfig(config);
+    apm_->Initialize();
+    adm_ = webrtc::test::MockAudioDeviceModule::CreateNice();
+    ON_CALL(*adm_, Recording()).WillByDefault([this] { return recording_; });
+    ON_CALL(*adm_, StartRecording()).WillByDefault([this] {
+      if (fail_) {
+        return -1;
+      }
+      recording_ = true;
+      return 0;
+    });
+    ON_CALL(*adm_, StopRecording()).WillByDefault([this] {
+      recording_ = false;
+      return 0;
+    });
+    webrtc::AudioState::Config state_config;
+    state_config.audio_mixer = webrtc::AudioMixerImpl::Create();
+    state_config.audio_processing = apm_;
+    state_config.audio_device_module = adm_;
+    state_ =
+        webrtc::make_ref_counted<webrtc::internal::AudioState>(state_config);
+  }
+
+  // A call starts: what was made and restarted since the counts were taken.
+  void Count() {
+    made_before_ = made_;
+    restarted_before_ = restarted_;
+  }
+  int Made() const { return made_ - made_before_; }
+  int Restarted() const { return restarted_ - restarted_before_; }
+
+  int made_ = 0;
+  int restarted_ = 0;
+  int made_before_ = 0;
+  int restarted_before_ = 0;
+  bool recording_ = false;
+  bool fail_ = false;
+  webrtc::scoped_refptr<webrtc::AudioProcessing> apm_;
+  webrtc::scoped_refptr<webrtc::test::MockAudioDeviceModule> adm_;
+  webrtc::scoped_refptr<webrtc::internal::AudioState> state_;
+  webrtc::test::MockAudioSendStream voice_;
+  webrtc::test::MockAudioReceiveStream heard_;
+};
+
+// A call's start makes the echo controller anew, whatever came before: the first
+// call, and one after another that ended (its streams gone).
+TEST_F(EchoCall, ACallsStartMakesItAnew) {
+  Count();
+  state_->AddReceivingStream(&heard_);
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_TRUE(recording_);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  // The call ends with the microphone on, and another starts.
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+  Count();
+  state_->AddReceivingStream(&heard_);
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  // The call ends while the microphone is off, and another starts.
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  state_->AddReceivingStream(&heard_);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// The microphone turned off and on again in a call that went on playing restarts
+// it, every time.
+TEST_F(EchoCall, AnUnmuteInTheCallRestartsIt) {
+  state_->AddReceivingStream(&heard_);
+  state_->AddSendingStream(&voice_, 48000, 1);
+  for (int i = 0; i < 3; ++i) {
+    state_->RemoveSendingStream(&voice_);
+    EXPECT_FALSE(recording_);
+    Count();
+    state_->AddSendingStream(&voice_, 48000, 1);
+    EXPECT_EQ(Made(), 0);
+    EXPECT_EQ(Restarted(), 1);
+  }
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// A change of devices while the microphone is off makes it anew at the next start
+// in the call, once: the start after it restarts again.
+TEST_F(EchoCall, AChangeOfDevicesMakesItAnewOnce) {
+  state_->AddReceivingStream(&heard_);
+  state_->AddSendingStream(&voice_, 48000, 1);
+  state_->RemoveSendingStream(&voice_);
+  webrtc::MarkAudioDevicesChanged();
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 0);
+  EXPECT_EQ(Restarted(), 1);
+
+  // A change while recording runs counts at the next start too.
+  webrtc::MarkAudioDevicesChanged();
+  state_->RemoveSendingStream(&voice_);
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// A start of recording that fails touches nothing, and takes nothing it was
+// told: neither the call it stopped in nor a change of devices.
+TEST_F(EchoCall, AFailedStartRestartsNothingAndKeepsWhatItWasTold) {
+  state_->AddReceivingStream(&heard_);
+  state_->AddSendingStream(&voice_, 48000, 1);
+
+  // Failed, then started: still the same call.
+  state_->RemoveSendingStream(&voice_);
+  fail_ = true;
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_FALSE(recording_);
+  EXPECT_EQ(Made(), 0);
+  EXPECT_EQ(Restarted(), 0);
+  state_->RemoveSendingStream(&voice_);
+  fail_ = false;
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 0);
+  EXPECT_EQ(Restarted(), 1);
+
+  // A change of devices, a failed start, then a start: the change still counts.
+  state_->RemoveSendingStream(&voice_);
+  webrtc::MarkAudioDevicesChanged();
+  fail_ = true;
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 0);
+  EXPECT_EQ(Restarted(), 0);
+  state_->RemoveSendingStream(&voice_);
+  fail_ = false;
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+}  // namespace
