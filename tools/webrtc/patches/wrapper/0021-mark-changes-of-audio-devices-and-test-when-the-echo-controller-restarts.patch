--- /dev/null
+++ b/test/echo_call.test.cc
@@ -0,0 +1,526 @@
+// WebRTC's audio state and audio processing with Fogata's patches 0010 and 0011
+// (tools/webrtc/patches/webrtc): a call's start makes the echo controller anew;
+// only a microphone turned on again in the call recording stopped in restarts it
+// for recording, and not after a change of audio devices
+// (MarkAudioDevicesChanged); what is recorded as the microphone turns off keeps
+// the format the audio processing is given, which would make it anew otherwise.
+// Built in again with mocks: the library shows only its own API.
+
+#include <cstdint>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "api/audio/audio_device.h"
+#include "api/audio/audio_processing.h"
+#include "api/audio/builtin_audio_processing_builder.h"
+#include "api/audio/echo_control.h"
+#include "api/make_ref_counted.h"
+#include "api/scoped_refptr.h"
+#include "audio/audio_state.h"
+#include "audio/audio_transport_impl.h"
+#include "call/audio_sender.h"
+#include "rtc_base/thread.h"
+#include "base/refcountedobject.h"
+#include "src/internal/custom_audio_transport_impl.h"
+#include "src/rtc_audio_device_impl.h"
+#include "call/test/mock_audio_receive_stream.h"
+#include "call/test/mock_audio_send_stream.h"
+#include "modules/audio_device/include/mock_audio_device.h"
+#include "modules/audio_mixer/audio_mixer_impl.h"
+#include "test/create_test_environment.h"
+#include "test/gmock.h"
+#include "test/gtest.h"
+
+namespace {
+
+using ::testing::_;
+using ::testing::AnyNumber;
+using ::testing::Return;
+
+// An echo controller that restarts for recording, counting each restart.
+class Restartable : public webrtc::EchoControl {
+ public:
+  explicit Restartable(int* restarted) : restarted_(restarted) {}
+  void AnalyzeRender(webrtc::AudioBuffer*) override {}
+  void AnalyzeCapture(webrtc::AudioBuffer*) override {}
+  void ProcessCapture(webrtc::AudioBuffer*, bool) override {}
+  void ProcessCapture(webrtc::AudioBuffer*, webrtc::AudioBuffer*,
+                      bool) override {}
+  Metrics GetMetrics() const override { return Metrics(); }
+  void SetAudioBufferDelay(int) override {}
+  bool ActiveProcessing() const override { return true; }
+  bool RestartForRecording() override {
+    ++*restarted_;
+    return true;
+  }
+
+ private:
+  int* const restarted_;
+};
+
+class Factory : public webrtc::EchoControlFactory {
+ public:
+  Factory(int* made, int* restarted) : made_(made), restarted_(restarted) {}
+  using webrtc::EchoControlFactory::Create;
+  std::unique_ptr<webrtc::EchoControl> Create(const webrtc::Environment&,
+                                              int, int, int) override {
+    ++*made_;
+    return std::make_unique<Restartable>(restarted_);
+  }
+
+ private:
+  int* const made_;
+  int* const restarted_;
+};
+
+// WebRTC's own audio transport, keeping what the audio state gave it last.
+class Given : public webrtc::AudioTransportImpl {
+ public:
+  using webrtc::AudioTransportImpl::AudioTransportImpl;
+  void UpdateAudioSenders(std::vector<webrtc::AudioSender*> senders,
+                          int send_sample_rate_hz,
+                          size_t send_num_channels) override {
+    senders_ = senders.size();
+    rate_ = send_sample_rate_hz;
+    channels_ = send_num_channels;
+    webrtc::AudioTransportImpl::UpdateAudioSenders(
+        std::move(senders), send_sample_rate_hz, send_num_channels);
+  }
+  size_t senders_ = 0;
+  int rate_ = 0;
+  size_t channels_ = 0;
+};
+
+class GivenFactory : public webrtc::AudioTransportFactory {
+ public:
+  std::unique_ptr<webrtc::AudioTransport> Create(
+      webrtc::AudioMixer* mixer,
+      webrtc::AudioProcessing* audio_processing,
+      webrtc::AsyncAudioProcessing::Factory* async) override {
+    auto transport = std::make_unique<Given>(mixer, audio_processing, async);
+    given_ = transport.get();
+    return transport;
+  }
+  Given* given_ = nullptr;
+};
+
+// One audio state with a real audio processing (echo controller from Factory)
+// and a mock audio device whose recording starts unless told to fail; its stop
+// delivers a recorded block first when told to, as the device's thread does until
+// the stop returns.
+class EchoCall : public ::testing::Test {
+ protected:
+  EchoCall() {
+    apm_ = webrtc::BuiltinAudioProcessingBuilder()
+               .SetEchoControlFactory(
+                   std::make_unique<Factory>(&made_, &restarted_))
+               .Build(webrtc::CreateTestEnvironment());
+    webrtc::AudioProcessing::Config config;
+    config.echo_canceller.enabled = true;
+    apm_->ApplyConfig(config);
+    apm_->Initialize();
+    adm_ = webrtc::test::MockAudioDeviceModule::CreateNice();
+    ON_CALL(*adm_, Recording()).WillByDefault([this] { return recording_; });
+    ON_CALL(*adm_, StartRecording()).WillByDefault([this] {
+      if (fail_) {
+        return -1;
+      }
+      if (keep_) {
+        return 0;  // Kept for later, as with no sound server (patch 0012).
+      }
+      recording_ = true;
+      return 0;
+    });
+    ON_CALL(*adm_, StopRecording()).WillByDefault([this] {
+      if (deliver_on_stop_) {
+        Deliver();
+      }
+      recording_ = false;
+      return 0;
+    });
+    Build(nullptr);
+    // WebRTC's own transport hands what is recorded to the streams sending.
+    EXPECT_CALL(voice_, SendAudioDataForMock(_)).Times(AnyNumber());
+  }
+
+  // The audio state again, with this audio transport (nullptr: WebRTC's own).
+  void Build(webrtc::scoped_refptr<webrtc::AudioTransportFactory> transport) {
+    webrtc::AudioState::Config state_config;
+    state_config.audio_mixer = webrtc::AudioMixerImpl::Create();
+    state_config.audio_processing = apm_;
+    state_config.audio_device_module = adm_;
+    state_config.audio_transport_factory = std::move(transport);
+    state_ =
+        webrtc::make_ref_counted<webrtc::internal::AudioState>(state_config);
+  }
+
+  // 10 ms recorded in two channels at 48 kHz, as the lab's microphones are.
+  void Deliver() {
+    std::vector<int16_t> samples(480 * 2, 1000);
+    uint32_t new_level = 0;
+    state_->audio_transport()->RecordedDataIsAvailable(
+        samples.data(), 480, 4, 2, 48000, 0, 0, 0, false, new_level);
+    ++delivered_;
+  }
+
+  // The microphone turned off in the call while the device records a block as its
+  // stop returns, and another after it (one still in flight as the stop returns):
+  // what the audio processing is given stays as in the call, and nothing
+  // makes or restarts the echo controller, which the next unmute restarts.
+  void ExpectBlocksAtTheStopToChangeNothing() {
+    state_->AddReceivingStream(&heard_);
+    Start();
+    Deliver();  // The audio processing takes the call's format.
+    const int rate = apm_->proc_sample_rate_hz();
+    const size_t channels = apm_->num_input_channels();
+    for (int i = 0; i < 2; ++i) {
+      deliver_on_stop_ = true;
+      delivered_ = 0;
+      Count();
+      state_->RemoveSendingStream(&voice_);
+      deliver_on_stop_ = false;
+      EXPECT_EQ(delivered_, 1);
+      Deliver();
+      EXPECT_EQ(Made(), 0) << "the audio processing started over";
+      EXPECT_EQ(Restarted(), 0);
+      EXPECT_EQ(apm_->proc_sample_rate_hz(), rate);
+      EXPECT_EQ(apm_->num_input_channels(), channels);
+      UnmuteAndExpectRestart();
+      Count();
+      Deliver();
+      EXPECT_EQ(Made(), 0) << "the restarted echo controller lost";
+      EXPECT_EQ(apm_->proc_sample_rate_hz(), rate);
+      EXPECT_EQ(apm_->num_input_channels(), channels);
+    }
+    state_->RemoveSendingStream(&voice_);
+    state_->RemoveReceivingStream(&heard_);
+  }
+
+  // A call starts: what was made and restarted since the counts were taken.
+  void Count() {
+    made_before_ = made_;
+    restarted_before_ = restarted_;
+  }
+  int Made() const { return made_ - made_before_; }
+  int Restarted() const { return restarted_ - restarted_before_; }
+
+  // The microphone turned on again in the call: restarted, unless a change of
+  // devices was marked since the last start by something else in this process (a
+  // real audio device module of another test), which makes it anew.
+  void UnmuteAndExpectRestart() {
+    const bool others = webrtc::AudioDevicesChangedCount().load() != marks_;
+    Count();
+    state_->AddSendingStream(&voice_, 48000, 1);
+    marks_ = webrtc::AudioDevicesChangedCount().load();
+    if (others) {
+      EXPECT_EQ(Made(), 1) << "a change of devices marked meanwhile";
+      return;
+    }
+    EXPECT_EQ(Made(), 0);
+    EXPECT_EQ(Restarted(), 1);
+  }
+  void Start() {
+    state_->AddSendingStream(&voice_, 48000, 1);
+    marks_ = webrtc::AudioDevicesChangedCount().load();
+  }
+  uint64_t marks_ = 0;
+
+  int made_ = 0;
+  int restarted_ = 0;
+  int made_before_ = 0;
+  int restarted_before_ = 0;
+  bool recording_ = false;
+  bool fail_ = false;
+  bool keep_ = false;
+  bool deliver_on_stop_ = false;
+  int delivered_ = 0;
+  webrtc::scoped_refptr<webrtc::AudioProcessing> apm_;
+  webrtc::scoped_refptr<webrtc::test::MockAudioDeviceModule> adm_;
+  webrtc::scoped_refptr<webrtc::internal::AudioState> state_;
+  webrtc::test::MockAudioSendStream voice_;
+  webrtc::test::MockAudioReceiveStream heard_;
+  webrtc::test::MockAudioReceiveStream heard_too_;
+};
+
+// A call's start makes the echo controller anew, whatever came before: the first
+// call, and one after another that ended (its streams gone).
+TEST_F(EchoCall, ACallsStartMakesItAnew) {
+  Count();
+  state_->AddReceivingStream(&heard_);
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_TRUE(recording_);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  // The call ends with the microphone on, and another starts.
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+  Count();
+  state_->AddReceivingStream(&heard_);
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  // The call ends while the microphone is off, and another starts.
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  state_->AddReceivingStream(&heard_);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// The microphone turned off and on again in a call that went on playing restarts
+// it, every time.
+TEST_F(EchoCall, AnUnmuteInTheCallRestartsIt) {
+  state_->AddReceivingStream(&heard_);
+  Start();
+  for (int i = 0; i < 3; ++i) {
+    state_->RemoveSendingStream(&voice_);
+    EXPECT_FALSE(recording_);
+    UnmuteAndExpectRestart();
+  }
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// A change of devices while the microphone is off makes it anew at the next start
+// in the call, once: the start after it restarts again.
+TEST_F(EchoCall, AChangeOfDevicesMakesItAnewOnce) {
+  state_->AddReceivingStream(&heard_);
+  Start();
+  state_->RemoveSendingStream(&voice_);
+  webrtc::MarkAudioDevicesChanged();
+  Count();
+  Start();
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  UnmuteAndExpectRestart();
+
+  // A change while recording runs counts at the next start too.
+  webrtc::MarkAudioDevicesChanged();
+  state_->RemoveSendingStream(&voice_);
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// A start of recording that fails touches nothing, and takes nothing it was
+// told: neither the call it stopped in nor a change of devices.
+TEST_F(EchoCall, AFailedStartRestartsNothingAndKeepsWhatItWasTold) {
+  state_->AddReceivingStream(&heard_);
+  state_->AddSendingStream(&voice_, 48000, 1);
+
+  // Failed, then started again with the same stream (recording asked for anew):
+  // still the same call.
+  marks_ = webrtc::AudioDevicesChangedCount().load();
+  state_->RemoveSendingStream(&voice_);
+  fail_ = true;
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_FALSE(recording_);
+  EXPECT_EQ(Made(), 0);
+  EXPECT_EQ(Restarted(), 0);
+  fail_ = false;
+  const bool others = webrtc::AudioDevicesChangedCount().load() != marks_;
+  state_->SetRecording(true);
+  EXPECT_TRUE(recording_);
+  if (!others) {
+    EXPECT_EQ(Made(), 0);
+    EXPECT_EQ(Restarted(), 1);
+  }
+
+  // A change of devices, a failed start, then a start: the change still counts.
+  state_->RemoveSendingStream(&voice_);
+  webrtc::MarkAudioDevicesChanged();
+  fail_ = true;
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(Made(), 0);
+  EXPECT_EQ(Restarted(), 0);
+  fail_ = false;
+  state_->SetRecording(true);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// With no sound server the device keeps a start, tells it done and records later on
+// its own (WebRTC patch 0012): the start counts, and the change of devices the
+// server's going marked makes the echo controller anew; when the device then records
+// on its own, and while it records, nothing makes or restarts it again. The device here
+// is simulated: that PulseAudio's module answers 0 to a start it keeps with no server
+// is what the lab's restart check with the microphone muted covers
+// (tools/call-lab/mic.sh restart:down20 with RESTART_MUTED=1), as no unit test runs it.
+TEST_F(EchoCall, AStartKeptForLaterMakesItAnew) {
+  state_->AddReceivingStream(&heard_);
+  Start();
+  state_->RemoveSendingStream(&voice_);
+  webrtc::MarkAudioDevicesChanged();  // The server went.
+  keep_ = true;
+  Count();
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_FALSE(recording_);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+  keep_ = false;
+  recording_ = true;  // The server back: the device starts on its own.
+  webrtc::test::MockAudioSendStream screen_sound;
+  state_->AddSendingStream(&screen_sound, 48000, 2);  // Recording runs: no start.
+  state_->RemoveSendingStream(&screen_sound);
+  EXPECT_TRUE(recording_);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// Someone heard who comes or goes while the microphone is off, or recording turned
+// off meanwhile: not the call recording stopped in.
+TEST_F(EchoCall, AStreamHeardComingOrGoingMakesItAnew) {
+  state_->AddReceivingStream(&heard_);
+  state_->AddReceivingStream(&heard_too_);
+  Start();
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_too_);
+  Count();
+  Start();
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  state_->AddReceivingStream(&heard_too_);
+  Count();
+  Start();
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  UnmuteAndExpectRestart();
+
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_too_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// (Playout turned off is left out: with streams received, the audio state then
+// polls them on the current task queue, which a test's thread has not.)
+TEST_F(EchoCall, RecordingTurnedOffMakesItAnew) {
+  state_->AddReceivingStream(&heard_);
+  Start();
+  // Recording turned off and on with the microphone on.
+  state_->SetRecording(false);
+  EXPECT_FALSE(recording_);
+  Count();
+  state_->SetRecording(true);
+  EXPECT_TRUE(recording_);
+  EXPECT_EQ(Made(), 1);
+  EXPECT_EQ(Restarted(), 0);
+
+  state_->RemoveSendingStream(&voice_);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// A block recorded as the last stream sending goes, with WebRTC's own transport
+// and with the wrapper's (CustomAudioTransportImpl, the one calls use): the stop
+// came after the transport was told nothing sends, and that block went to the
+// audio processing at 8000 Hz, which made another echo controller that knew
+// nothing of the room, and the unmute's first block another.
+TEST_F(EchoCall, ABlockRecordedAsTheMicrophoneTurnsOffChangesNothing) {
+  ExpectBlocksAtTheStopToChangeNothing();
+}
+
+TEST_F(EchoCall, ABlockRecordedAsTheMicrophoneTurnsOffChangesNothingInCalls) {
+  Build(webrtc::make_ref_counted<webrtc::CustomAudioTransportFactory>());
+  ExpectBlocksAtTheStopToChangeNothing();
+}
+
+// With no stream left sending, the transport is given the format of the last ones,
+// not 8000 Hz in one channel; with streams, theirs.
+TEST_F(EchoCall, TheFormatGivenWithNoStreamIsTheLastOne) {
+  auto factory = webrtc::make_ref_counted<GivenFactory>();
+  Build(factory);
+  ASSERT_NE(factory->given_, nullptr);
+  const Given& given = *factory->given_;
+  webrtc::test::MockAudioSendStream screen_sound;
+  EXPECT_CALL(screen_sound, SendAudioDataForMock(_)).Times(AnyNumber());
+  state_->AddReceivingStream(&heard_);
+
+  state_->AddSendingStream(&voice_, 48000, 1);
+  EXPECT_EQ(given.senders_, 1u);
+  EXPECT_EQ(given.rate_, 48000);
+  EXPECT_EQ(given.channels_, 1u);
+  state_->AddSendingStream(&screen_sound, 48000, 2);
+  EXPECT_EQ(given.senders_, 2u);
+  EXPECT_EQ(given.channels_, 2u);
+  state_->RemoveSendingStream(&voice_);
+  EXPECT_EQ(given.senders_, 1u);
+  EXPECT_EQ(given.channels_, 2u);
+  state_->RemoveSendingStream(&screen_sound);
+  EXPECT_EQ(given.senders_, 0u);
+  EXPECT_EQ(given.rate_, 48000);
+  EXPECT_EQ(given.channels_, 2u);
+
+  state_->AddSendingStream(&voice_, 16000, 1);
+  EXPECT_EQ(given.senders_, 1u);
+  EXPECT_EQ(given.rate_, 16000);
+  EXPECT_EQ(given.channels_, 1u);
+  state_->RemoveSendingStream(&voice_);
+  EXPECT_EQ(given.senders_, 0u);
+  EXPECT_EQ(given.rate_, 16000);
+  EXPECT_EQ(given.channels_, 1u);
+  state_->RemoveReceivingStream(&heard_);
+}
+
+// The wrapper marks a change of devices when another output or input is chosen,
+// not when the same one is chosen again, and when the module tells of devices that
+// came or went.
+TEST(EchoCallDevices, AnotherDeviceChosenIsMarked) {
+  auto worker = webrtc::Thread::Create();
+  worker->Start();
+  auto adm = webrtc::test::MockAudioDeviceModule::CreateNice();
+  {
+    libwebrtc::scoped_refptr<libwebrtc::AudioDeviceImpl> device(
+        new libwebrtc::RefCountedObject<libwebrtc::AudioDeviceImpl>(
+            adm, worker.get()));
+    auto marks = [] { return webrtc::AudioDevicesChangedCount().load(); };
+    auto settle = [&] { worker->BlockingCall([] {}); };
+
+    device->SetPlayoutDevice(2);
+    device->SetRecordingDevice(3);
+    settle();
+    uint64_t before = marks();
+    device->SetPlayoutDevice(2);
+    device->SetRecordingDevice(3);
+    settle();
+    EXPECT_EQ(marks(), before) << "the same devices chosen again";
+
+    before = marks();
+    device->SetPlayoutDevice(1);
+    settle();
+    EXPECT_GE(marks(), before + 1);
+    before = marks();
+    device->SetRecordingDevice(0);
+    settle();
+    EXPECT_GE(marks(), before + 1);
+    before = marks();
+    static_cast<webrtc::AudioDeviceObserver*>(device.get())->OnDevicesUpdated();
+    EXPECT_GE(marks(), before + 1);
+  }
+  worker->Stop();
+}
+
+}  // namespace
