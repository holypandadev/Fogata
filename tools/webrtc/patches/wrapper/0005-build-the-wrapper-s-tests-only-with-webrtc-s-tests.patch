+      "../api/video_codecs:video_codecs_api",
+      "../modules/video_coding:video_codec_interface",
+      "../rtc_base:logging",
+      "//third_party/abseil-cpp/absl/strings",
+      "//testing/gtest",
+      "//test:test_support",
+      "//test:test_main",
+    ]
+  }
 }
