+class SharedEncoderTest : public ::testing::Test {
+ protected:
+  explicit SharedEncoderTest(const char* trials = kTrial)
+      : time_(Timestamp::Seconds(10000)),
+        env_(webrtc::CreateTestEnvironment(
+            {.field_trials = trials, .time = &time_})) {
+    auto inner = std::make_unique<CountingFactory>();
+    inner_ = inner.get();
+    factory_ = std::make_unique<SharedEncoderFactory>(std::move(inner));
+  }
+
+  std::unique_ptr<Watcher> NewWatcher(int64_t ntp_delta_ms) {
+    return std::make_unique<Watcher>(*factory_, env_, ntp_delta_ms);
+  }
+
+  // Lets the group encode what was asked for, then one frame's time pass.
+  void Encode() { time_.AdvanceTime(TimeDelta::Zero()); }
+  void NextFrame() { time_.AdvanceTime(TimeDelta::Millis(kFrameMs)); }
+
+  webrtc::GlobalSimulatedTimeController time_;
+  const Environment env_;
+  CountingFactory* inner_ = nullptr;
+  std::unique_ptr<SharedEncoderFactory> factory_;
+};
