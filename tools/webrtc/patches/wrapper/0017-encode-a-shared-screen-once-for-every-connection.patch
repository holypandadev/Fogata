+TEST_F(SharedEncoderTest, MembersOfOneSourceAndSizeShareOneEncoder) {
+  std::vector<std::unique_ptr<Watcher>> watchers;
+  for (int64_t delta : {100, 2000, 777777}) {
+    watchers.push_back(NewWatcher(delta));
+    watchers.back()->Init();
+  }
+  for (int n = 0; n < 10; ++n) {
+    for (auto& watcher : watchers) {
+      EXPECT_EQ(watcher->Ask(Frame(1, n)), WEBRTC_VIDEO_CODEC_OK);
+    }
+    NextFrame();
+  }
+
+  auto encoders = inner_->Initialized();
+  ASSERT_EQ(encoders.size(), 1u);
+  EXPECT_EQ(encoders[0]->frame_ids.size(), 10u);  // Each frame once.
+  const auto first = watchers[0]->callback.images();
+  for (auto& watcher : watchers) {
+    const auto images = watcher->callback.images();
+    ASSERT_EQ(images.size(), 10u);
+    EXPECT_TRUE(images[0].key);
+    EXPECT_EQ(Keys(images), 1);
+    for (int n = 0; n < 10; ++n) {
+      EXPECT_EQ(images[n].count, n);
+      EXPECT_EQ(images[n].rtp_timestamp, watcher->Rtp(n));
+      EXPECT_EQ(images[n].buffer, first[n].buffer);  // Not copied.
+    }
+    EXPECT_EQ(watcher->encoder().GetEncoderInfo().implementation_name,
+              "fake (shared)");
+  }
+}
