+  ExpectContinuous(while_silent);
+  for (int n = 30; n < 70; ++n) {
+    a->Ask(Frame(1, n));
+    b->Ask(Frame(1, n));
+    NextFrame();
+  }
+  const auto images = b->callback.images();
+  ASSERT_GT(images.size(), while_silent.size());
+  EXPECT_TRUE(images[while_silent.size()].key);
+  ExpectContinuous(images, while_silent.size());
+  ExpectContinuous(a->callback.images());
