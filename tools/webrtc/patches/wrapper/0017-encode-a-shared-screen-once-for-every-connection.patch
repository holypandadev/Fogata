+// What one encoder the inner factory made was asked to do.
+struct EncoderRecord {
+  webrtc::Mutex mutex;
+  int inits = 0;
+  int releases = 0;
+  bool destroyed = false;
+  int width = 0;
+  std::vector<uint16_t> frame_ids;
+  std::vector<bool> keys_made;
+  std::optional<uint32_t> bitrate_bps;
+  bool drop_first = false;
+  // InitEncode waits for it when set.
+  webrtc::Event* init_gate = nullptr;
+};
+
+// Encodes nothing: each image is one byte, the count of images it made,
+// in a buffer of its own. A key frame when asked or first.
+class CountingEncoder : public VideoEncoder {
+ public:
+  explicit CountingEncoder(std::shared_ptr<EncoderRecord> record)
+      : record_(std::move(record)) {}
+  ~CountingEncoder() override {
+    webrtc::MutexLock lock(&record_->mutex);
+    record_->destroyed = true;
+  }
+
+  int InitEncode(const VideoCodec* codec, const Settings&) override {
+    if (record_->init_gate != nullptr) {
+      record_->init_gate->Wait(webrtc::Event::kForever);
+    }
+    webrtc::MutexLock lock(&record_->mutex);
+    ++record_->inits;
+    record_->width = codec->width;
+    width_ = codec->width;
+    height_ = codec->height;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t RegisterEncodeCompleteCallback(
+      EncodedImageCallback* callback) override {
+    callback_ = callback;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Release() override {
+    webrtc::MutexLock lock(&record_->mutex);
+    ++record_->releases;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Encode(const VideoFrame& frame,
+                 const std::vector<VideoFrameType>* frame_types) override {
+    bool key_asked = false;
+    for (VideoFrameType type : *frame_types) {
+      key_asked |= type == VideoFrameType::kVideoFrameKey;
+    }
+    const bool key = key_asked || made_ == 0;
+    {
+      webrtc::MutexLock lock(&record_->mutex);
+      record_->frame_ids.push_back(frame.id());
+      if (record_->drop_first) {
+        // Dropped by the encoder itself: no image, no callback.
+        record_->drop_first = false;
+        record_->keys_made.push_back(false);
+        return WEBRTC_VIDEO_CODEC_OK;
+      }
+      record_->keys_made.push_back(key);
+    }
+    const uint8_t count = static_cast<uint8_t>(made_++);
+    EncodedImage image;
+    image.SetEncodedData(webrtc::EncodedImageBuffer::Create(&count, 1));
+    image.SetRtpTimestamp(frame.rtp_timestamp());
+    image._frameType =
+        key ? VideoFrameType::kVideoFrameKey : VideoFrameType::kVideoFrameDelta;
+    image._encodedWidth = width_;
+    image._encodedHeight = height_;
+    CodecSpecificInfo info;
+    info.codecType = webrtc::kVideoCodecVP8;
+    if (callback_ != nullptr) {
+      callback_->OnEncodedImage(image, &info);
+    }
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  void SetRates(const RateControlParameters& parameters) override {
+    webrtc::MutexLock lock(&record_->mutex);
+    record_->bitrate_bps = parameters.bitrate.get_sum_bps();
+  }
+  EncoderInfo GetEncoderInfo() const override {
+    EncoderInfo info;
+    info.implementation_name = "fake";
+    return info;
+  }
+
+ private:
+  const std::shared_ptr<EncoderRecord> record_;
+  EncodedImageCallback* callback_ = nullptr;
+  int made_ = 0;
+  uint32_t width_ = 0;
+  uint32_t height_ = 0;
+};
+
+class CountingFactory : public webrtc::VideoEncoderFactory {
+ public:
+  std::vector<SdpVideoFormat> GetSupportedFormats() const override {
+    return {SdpVideoFormat::VP8()};
+  }
+  std::unique_ptr<VideoEncoder> Create(const Environment&,
+                                       const SdpVideoFormat&) override {
+    auto record = std::make_shared<EncoderRecord>();
+    record->drop_first = drop_first_frame;
+    record->init_gate = init_gate;
+    auto encoder = std::make_unique<CountingEncoder>(record);
+    webrtc::MutexLock lock(&mutex);
+    records.push_back(record);
+    last_made = encoder.get();
+    return encoder;
+  }
+
+  // The encoders that were initialized (a proxy may also make one only to
+  // ask what it is).
+  std::vector<std::shared_ptr<EncoderRecord>> Initialized() {
+    webrtc::MutexLock lock(&mutex);
+    std::vector<std::shared_ptr<EncoderRecord>> initialized;
+    for (const auto& record : records) {
+      webrtc::MutexLock record_lock(&record->mutex);
+      if (record->inits > 0) {
+        initialized.push_back(record);
+      }
+    }
+    return initialized;
+  }
+
+  webrtc::Mutex mutex;
+  std::vector<std::shared_ptr<EncoderRecord>> records;
+  VideoEncoder* last_made = nullptr;
+  bool drop_first_frame = false;
+  webrtc::Event* init_gate = nullptr;
+};
+
+class RecordingCallback : public EncodedImageCallback {
+ public:
+  struct Got {
+    uint32_t rtp_timestamp;
+    uint8_t count;
+    bool key;
+    const void* buffer;
+  };
+
+  Result OnEncodedImage(const EncodedImage& image,
+                        const CodecSpecificInfo*) override {
+    webrtc::MutexLock lock(&mutex_);
+    images_.push_back({image.RtpTimestamp(), image.data()[0], image.IsKey(),
+                       image.GetEncodedData().get()});
+    return Result(Result::OK);
+  }
+  void OnFrameDropped(uint32_t, int, bool) override {}
+
+  std::vector<Got> images() {
+    webrtc::MutexLock lock(&mutex_);
+    return images_;
+  }
+  size_t size() {
+    webrtc::MutexLock lock(&mutex_);
+    return images_.size();
+  }
+
+ private:
+  webrtc::Mutex mutex_;
+  std::vector<Got> images_;
+};
+
+VideoCodec Codec(int width,
+                 int height,
+                 webrtc::VideoCodecMode mode =
+                     webrtc::VideoCodecMode::kRealtimeVideo) {
+  VideoCodec codec;
+  codec.codecType = webrtc::kVideoCodecVP8;
+  *codec.VP8() = VideoEncoder::GetDefaultVp8Settings();
+  codec.width = width;
+  codec.height = height;
+  codec.startBitrate = 1000;
+  codec.minBitrate = 30;
+  codec.maxBitrate = 6000;
+  codec.maxFramerate = 30;
+  codec.qpMax = 56;
+  codec.active = true;
+  codec.mode = mode;
+  codec.numberOfSimulcastStreams = 1;
+  codec.simulcastStream[0].width = width;
+  codec.simulcastStream[0].height = height;
+  codec.simulcastStream[0].numberOfTemporalLayers = 1;
+  codec.simulcastStream[0].maxBitrate = 6000;
+  codec.simulcastStream[0].qpMax = 56;
+  codec.simulcastStream[0].active = true;
+  return codec;
+}
+
+VideoEncoder::RateControlParameters Rates(uint32_t bps) {
+  webrtc::VideoBitrateAllocation allocation;
+  allocation.SetBitrate(0, 0, bps);
+  return VideoEncoder::RateControlParameters(
+      allocation, 30.0, webrtc::DataRate::BitsPerSec(bps));
+}
+
+int64_t FrameMs(int n) {
+  return kFirstFrameMs + kFrameMs * n;
+}
+
+// Frame `n` of source `slot` (0: untagged), as the capturer sends it.
+VideoFrame Frame(int slot, int n, int width = 1280, int height = 720) {
+  return VideoFrame::Builder()
+      .set_video_frame_buffer(webrtc::I420Buffer::Create(width, height))
+      .set_timestamp_us(FrameMs(n) * 1000)
+      .set_id(slot == 0 ? uint16_t{0} : SharedEncodeFrameId(slot, n))
+      .build();
+}
+
+// One connection's VideoStreamEncoder, as far as its encoder sees it: its own
+// clock offset for RTP timestamps, a key frame asked for after every
+// InitEncode.
+class Watcher {
+ public:
+  Watcher(webrtc::VideoEncoderFactory& factory,
+          const Environment& env,
+          int64_t ntp_delta_ms)
+      : encoder_(factory.Create(env, SdpVideoFormat::VP8())),
+        ntp_delta_ms_(ntp_delta_ms) {}
+
+  void Init(int width = 1280,
+            int height = 720,
+            webrtc::VideoCodecMode mode =
+                webrtc::VideoCodecMode::kRealtimeVideo,
+            uint32_t bps = 2000000) {
+    const VideoCodec codec = Codec(width, height, mode);
+    ASSERT_EQ(encoder_->InitEncode(
+                  &codec, VideoEncoder::Settings(
+                              VideoEncoder::Capabilities(false), 4, 1200)),
+              WEBRTC_VIDEO_CODEC_OK);
+    encoder_->RegisterEncodeCompleteCallback(&callback);
+    encoder_->SetRates(Rates(bps));
+    key_next_ = true;
+  }
+
+  int Ask(const VideoFrame& captured, bool key = false) {
+    VideoFrame frame = captured;
+    const int64_t ntp_ms = frame.render_time_ms() + ntp_delta_ms_;
+    frame.set_ntp_time_ms(ntp_ms);
+    frame.set_rtp_timestamp(90 * static_cast<uint32_t>(ntp_ms));
+    std::vector<VideoFrameType> types(
+        1, key || key_next_ ? VideoFrameType::kVideoFrameKey
+                            : VideoFrameType::kVideoFrameDelta);
+    key_next_ = false;
+    return encoder_->Encode(frame, &types);
+  }
+
+  // The RTP timestamp this connection gives frame `n`.
+  uint32_t Rtp(int n) const {
+    return 90 * static_cast<uint32_t>(FrameMs(n) + ntp_delta_ms_);
+  }
+
+  VideoEncoder& encoder() { return *encoder_; }
+
+  RecordingCallback callback;
+
+ private:
+  std::unique_ptr<VideoEncoder> encoder_;
+  const int64_t ntp_delta_ms_;
+  bool key_next_ = true;
+};
+
+int Keys(const std::vector<RecordingCallback::Got>& images) {
+  int keys = 0;
+  for (const auto& image : images) {
+    keys += image.key ? 1 : 0;
+  }
+  return keys;
+}
+
+// Images 0, 1, 2, ... of one encoder, none missing, none twice.
+void ExpectContinuous(const std::vector<RecordingCallback::Got>& images,
+                      size_t from = 0,
+                      size_t to = SIZE_MAX) {
+  for (size_t i = from + 1; i < std::min(images.size(), to); ++i) {
+    EXPECT_EQ(images[i].count, static_cast<uint8_t>(images[i - 1].count + 1))
+        << "at image " << i;
+  }
+}
