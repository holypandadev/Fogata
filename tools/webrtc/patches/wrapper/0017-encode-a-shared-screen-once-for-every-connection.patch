+#ifndef LIB_WEBRTC_SHARED_ENCODER_H_
+#define LIB_WEBRTC_SHARED_ENCODER_H_
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "api/environment/environment.h"
+#include "api/field_trials_view.h"
+#include "api/video/resolution.h"
+#include "api/video_codecs/sdp_video_format.h"
+#include "api/video_codecs/video_encoder.h"
+#include "api/video_codecs/video_encoder_factory.h"
+
+// One encode of a shared screen for every connection that sends it.
+//
+// Every connection that sends a track has a VideoStreamEncoder of its own, and
+// each asks its encoder factory for an encoder of its own: a screen shared to
+// seven watchers was encoded seven times, with seven libvpx encoders and their
+// buffers. Every one of them is given the same frames (VideoBroadcaster hands
+// each sink the same VideoFrame) at, mostly, the same settings.
+//
+// SharedEncoderFactory wraps the factory those encoders come from. With the
+// field trial "Fogata-SharedScreenEncode/Enabled/" each VP8 encoder it makes is
+// a proxy. Proxies of the frames of one screen (frames a source tagged through
+// SharedEncodeTag) and of the same settings form a group with one real
+// encoder: a frame is encoded once when any of them asks for it, and the image
+// is given to each of them with its own RTP timestamp. Each connection still
+// packetizes, encrypts, paces and estimates on its own, so nothing on the wire
+// changes. Untagged frames (cameras) are encoded as before, by an encoder of
+// the proxy's own, on the caller's thread.
+//
+// No type of the wrapper is used here, so the macOS framework builds this
+// file too.
+//
+// One track for each tagged source: VideoBroadcaster gives a sink that wants
+// black frames (a disabled track) black frames with the source's ids, which
+// would then pass for the frames of the same ids.
+
+namespace libwebrtc {
+
+inline constexpr char kSharedScreenEncodeTrial[] = "Fogata-SharedScreenEncode";
+
+// The sources whose frames can be told apart at once: the top 4 bits of a
+// frame's id (VideoFrame::id(), 0 meaning none) name the source, the other 12
+// count its frames.
+inline constexpr int kSharedEncodeSlots = 15;
+
+// A source number from 1 to kSharedEncodeSlots no other live source has, or 0
+// when all are taken (the source then stays untagged and is never shared).
+// Numbers are handed out in turn, so one given back is not reused at once
+// while frames tagged with it may still be on their way to an encoder.
+int AcquireSharedEncodeSlot();
+void ReleaseSharedEncodeSlot(int slot);
+
+// The id of frame `seq` of source `slot`; never 0 for a slot from 1 up.
+uint16_t SharedEncodeFrameId(int slot, uint32_t seq);
+// The source of a frame id; 0 for an untagged frame.
+int SharedEncodeSlotOf(uint16_t id);
+
+// Tags the frames of one source once enabled. Thread-safe: frames may come
+// from any thread, Enable() from another.
+class SharedEncodeTag {
+ public:
+  SharedEncodeTag();
+  ~SharedEncodeTag();
+  SharedEncodeTag(const SharedEncodeTag&) = delete;
+  SharedEncodeTag& operator=(const SharedEncodeTag&) = delete;
+
+  // Takes a source number, once; false when none was free (frames then stay
+  // untagged).
+  bool Enable();
+  int slot() const { return slot_.load(std::memory_order_acquire); }
+  // The id the next frame carries, or 0 while not enabled.
+  uint16_t NextFrameId();
+
+ private:
+  std::atomic<int> slot_{0};
+  std::atomic<uint32_t> seq_{0};
+};
+
+// The parameters of the trial, e.g.
+// "Fogata-SharedScreenEncode/Enabled,key_ms:500,live_ms:300/".
+struct SharedEncodeConfig {
+  // At least this long between key frames a group makes on request.
+  int key_ms = 1000;
+  // A member that asked for no frame for this long of frame time while others
+  // did is paused: it gets nothing until a key frame once it asks again.
+  int live_ms = 250;
+  // A member whose bitrate stays under isolate_ratio times the median of the
+  // others' (at least two others) for isolate_ms gets an encoder of its own.
+  double isolate_ratio = 0.5;
+  int isolate_ms = 3000;
+  // So does a member that asks for a key frame this many times in 10 s.
+  int isolate_keys = 3;
+  // An isolated member whose bitrate has been at least the group's for this
+  // long rejoins it (doubling, up to 16 times, each time it did not stay 20 s).
+  int rejoin_ms = 10000;
+  // Encoder threads of a group's encoder; unset keeps what the connections ask.
+  std::optional<int> threads;
+
+  static SharedEncodeConfig Parse(const webrtc::FieldTrialsView& trials);
+};
+
+class SharedEncodeRegistry;
+
+// See the top of this file. Thread-safe as the factory it wraps is.
+class SharedEncoderFactory final : public webrtc::VideoEncoderFactory {
+ public:
+  explicit SharedEncoderFactory(
+      std::unique_ptr<webrtc::VideoEncoderFactory> inner);
+  ~SharedEncoderFactory() override;
+
+  using webrtc::VideoEncoderFactory::QueryCodecSupport;
+  std::vector<webrtc::SdpVideoFormat> GetSupportedFormats() const override;
+  std::vector<webrtc::SdpVideoFormat> GetImplementations() const override;
+  CodecSupport QueryCodecSupport(
+      const webrtc::SdpVideoFormat& format,
+      std::optional<std::string> scalability_mode,
+      std::optional<webrtc::Resolution> resolution) const override;
+  // The inner factory's encoder, unless the trial is on and `format` is VP8.
+  std::unique_ptr<webrtc::VideoEncoder> Create(
+      const webrtc::Environment& env,
+      const webrtc::SdpVideoFormat& format) override;
+  std::unique_ptr<EncoderSelectorInterface> GetEncoderSelector() const override;
+
+ private:
+  // Kept by every proxy and group too, so the inner factory outlives them.
+  std::shared_ptr<SharedEncodeRegistry> registry_;
+};
+
+}  // namespace libwebrtc
+
+#endif  // LIB_WEBRTC_SHARED_ENCODER_H_
