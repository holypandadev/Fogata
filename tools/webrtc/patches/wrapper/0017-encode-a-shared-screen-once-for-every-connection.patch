+TEST_F(SharedEncoderTest, ALateJoinerStartsOnAKeptKeyFrame) {
+  // At the start of a share every connection asks for the first frame, one
+  // a little after the other: the group encoded it for the first already.
+  auto a = NewWatcher(10);
+  auto b = NewWatcher(20);
+  a->Init();
+  b->Init();
+  a->Ask(Frame(1, 0));
+  Encode();
+  a->Ask(Frame(1, 1));
+  Encode();
+  b->Ask(Frame(1, 0));
+  // The key frame at once, the frame after it one frame later at most.
+  EXPECT_EQ(b->callback.size(), 1u);
+  NextFrame();
+  EXPECT_EQ(b->callback.size(), 2u);
+  for (int n = 1; n < 40; ++n) {
+    if (n > 1) {
+      a->Ask(Frame(1, n));
+    }
+    b->Ask(Frame(1, n));
+    NextFrame();
+  }
+  const auto images = b->callback.images();
+  ASSERT_EQ(images.size(), 40u);
+  EXPECT_TRUE(images[0].key);
+  EXPECT_EQ(images[0].rtp_timestamp, b->Rtp(0));
+  EXPECT_EQ(images[1].rtp_timestamp, b->Rtp(1));
+  ExpectContinuous(images);
+  // No second key frame was made for it.
+  EXPECT_EQ(Keys(a->callback.images()), 1);
+}
