+TEST_F(SharedEncoderTest, TwoSourcesNeverMix) {
+  // The sharer switches screens: each connection moves to the new track in
+  // turn (replaceTrack), while the others still send the old one.
+  std::vector<std::unique_ptr<Watcher>> watchers;
+  for (int64_t delta : {10, 20, 30}) {
+    watchers.push_back(NewWatcher(delta));
+    watchers.back()->Init();
+  }
+  auto moves_at = [](int i) { return 10 + 2 * i; };
+  for (int n = 0; n < 60; ++n) {
+    for (int i = 0; i < 3; ++i) {
+      watchers[i]->Ask(Frame(n >= moves_at(i) ? 2 : 1, n));
+    }
+    NextFrame();
+  }
+  auto encoders = inner_->Initialized();
+  ASSERT_EQ(encoders.size(), 2u);
+  for (const auto& encoder : encoders) {
+    ASSERT_FALSE(encoder->frame_ids.empty());
+    const int slot = SharedEncodeSlotOf(encoder->frame_ids[0]);
+    for (uint16_t id : encoder->frame_ids) {
+      EXPECT_EQ(SharedEncodeSlotOf(id), slot);
+    }
+  }
+  for (int i = 0; i < 3; ++i) {
+    // Every frame of the old screen until it moved, then the new screen's
+    // from a key frame on.
+    const auto images = watchers[i]->callback.images();
+    const size_t moved = static_cast<size_t>(moves_at(i));
+    ASSERT_GT(images.size(), moved);
+    for (size_t k = 0; k < moved; ++k) {
+      EXPECT_EQ(static_cast<size_t>(images[k].count), k);
+    }
+    EXPECT_TRUE(images[moved].key);
+    ExpectContinuous(images, moved);
+  }
+}
