+TEST(SharedEncodeSlots, FifteenThenNone) {
+  std::vector<int> slots;
+  for (int i = 0; i < libwebrtc::kSharedEncodeSlots; ++i) {
+    slots.push_back(libwebrtc::AcquireSharedEncodeSlot());
+  }
+  EXPECT_EQ(std::set<int>(slots.begin(), slots.end()).size(), 15u);
+  for (int slot : slots) {
+    EXPECT_GE(slot, 1);
+    EXPECT_LE(slot, 15);
+  }
+  EXPECT_EQ(libwebrtc::AcquireSharedEncodeSlot(), 0);
+
+  {
+    // The 16th source stays untagged, so it is never shared.
+    libwebrtc::SharedEncodeTag tag;
+    EXPECT_FALSE(tag.Enable());
+    EXPECT_EQ(tag.NextFrameId(), 0);
+    EXPECT_EQ(tag.NextFrameId(), 0);
+
+    libwebrtc::ReleaseSharedEncodeSlot(slots[6]);
+    EXPECT_TRUE(tag.Enable());
+    EXPECT_EQ(tag.slot(), slots[6]);
+    EXPECT_EQ(tag.NextFrameId(), SharedEncodeFrameId(slots[6], 0));
+    EXPECT_EQ(tag.NextFrameId(), SharedEncodeFrameId(slots[6], 1));
+    EXPECT_EQ(SharedEncodeSlotOf(SharedEncodeFrameId(slots[6], 1)), slots[6]);
+  }
+  // Given back as the tag went.
+  EXPECT_EQ(libwebrtc::AcquireSharedEncodeSlot(), slots[6]);
+  for (int slot : slots) {
+    libwebrtc::ReleaseSharedEncodeSlot(slot);
+  }
+}
+
+TEST(SharedEncodeSlots, IdsCountTwelveBitsAndAreNeverZero) {
+  EXPECT_EQ(SharedEncodeFrameId(1, 0), 0x1000);
+  EXPECT_EQ(SharedEncodeFrameId(15, 0x0fff), 0xffff);
+  EXPECT_EQ(SharedEncodeFrameId(3, 0x1000), SharedEncodeFrameId(3, 0));
+  for (int slot = 1; slot <= libwebrtc::kSharedEncodeSlots; ++slot) {
+    for (uint32_t seq : {0u, 1u, 4095u, 4096u, 0xffffffffu}) {
+      EXPECT_NE(SharedEncodeFrameId(slot, seq), 0);
+      EXPECT_EQ(SharedEncodeSlotOf(SharedEncodeFrameId(slot, seq)), slot);
+    }
+  }
+  EXPECT_EQ(SharedEncodeSlotOf(0), 0);
+}
