+namespace libwebrtc {
+
+namespace {
+
+using webrtc::CodecSpecificInfo;
+using webrtc::EncodedImage;
+using webrtc::EncodedImageCallback;
+using webrtc::Environment;
+using webrtc::Mutex;
+using webrtc::MutexLock;
+using webrtc::SdpVideoFormat;
+using webrtc::TimeDelta;
+using webrtc::Timestamp;
+using webrtc::VideoCodec;
+using webrtc::VideoEncoder;
+using webrtc::VideoFrame;
+using webrtc::VideoFrameType;
+
+// Frames of one source whose ids are equal and whose capture times are less
+// than this apart are the same frame. Ids repeat every 4096 frames, which is
+// over 30 s at 120 frames a second.
+constexpr int64_t kSameFrameUs = 1000000;
+// Encoded images a group keeps for members that skipped them.
+constexpr size_t kCachedImages = 8;
+// Frames a member asked for whose RTP timestamps it remembers.
+constexpr size_t kAskedFrames = 32;
+constexpr TimeDelta kKeyRequestWindow = TimeDelta::Seconds(10);
+// A rejoined member isolated again within this long waits twice as long.
+constexpr TimeDelta kRejoinMustLast = TimeDelta::Seconds(20);
+constexpr TimeDelta kRejoinCheckInterval = TimeDelta::Millis(500);
+// RTP video clock: 90 kHz.
+constexpr uint32_t kRtpTicksPerMs = 90;
+
+// ---------------------------------------------------------------------------
+// Source numbers.
+
+struct SlotTable {
+  Mutex mutex;
+  bool used[kSharedEncodeSlots + 1] RTC_GUARDED_BY(mutex) = {};
+  int last RTC_GUARDED_BY(mutex) = 0;
+};
+
+SlotTable& Slots() {
+  // Never destroyed: sources may give their number back at exit.
+  static SlotTable* const table = new SlotTable();
+  return *table;
+}
+
+// ---------------------------------------------------------------------------
+// Frames and groups.
+
+struct FrameKey {
+  uint16_t id = 0;
+  int64_t timestamp_us = 0;
+};
+
+bool SameFrame(const FrameKey& a, const FrameKey& b) {
+  return a.id == b.id &&
+         std::llabs(a.timestamp_us - b.timestamp_us) < kSameFrameUs;
+}
+
+bool NewerFrame(const FrameKey& a, const FrameKey& b) {
+  return !SameFrame(a, b) && a.timestamp_us > b.timestamp_us;
+}
+
+// What must be equal for two connections to share an encoder: the source,
+// and the settings VideoStreamEncoder's RequiresEncoderReset compares (any
+// change of these makes it initialize its encoder again). Min and max bitrate
+// and the frame rate are left out: they only reach SetRates.
+struct GroupKey {
+  int slot = 0;
+  // 0 for the group every member of these settings joins; any other number
+  // for a member on its own (see Isolate below).
+  int isolation = 0;
+  VideoCodec codec;
+  int number_of_cores = 0;
+  std::optional<int> encoder_thread_limit;
+};
+
+bool SameSettings(const VideoCodec& a, const VideoCodec& b) {
+  if (a.codecType != b.codecType || a.width != b.width ||
+      a.height != b.height || a.qpMax != b.qpMax ||
+      a.numberOfSimulcastStreams != b.numberOfSimulcastStreams ||
+      a.mode != b.mode || a.GetFrameDropEnabled() != b.GetFrameDropEnabled() ||
+      a.GetScalabilityMode() != b.GetScalabilityMode() ||
+      a.GetVideoEncoderComplexity() != b.GetVideoEncoderComplexity() ||
+      a.legacy_conference_mode != b.legacy_conference_mode ||
+      a.active != b.active) {
+    return false;
+  }
+  if (a.codecType == webrtc::kVideoCodecVP8 && !(a.VP8() == b.VP8())) {
+    return false;
+  }
+  const webrtc::SimulcastStream& sa = a.simulcastStream[0];
+  const webrtc::SimulcastStream& sb = b.simulcastStream[0];
+  return sa.active == sb.active && sa.width == sb.width &&
+         sa.height == sb.height &&
+         sa.numberOfTemporalLayers == sb.numberOfTemporalLayers &&
+         sa.qpMax == sb.qpMax;
+}
+
+bool SameKey(const GroupKey& a, const GroupKey& b) {
+  return a.slot == b.slot && a.isolation == b.isolation &&
+         a.number_of_cores == b.number_of_cores &&
+         a.encoder_thread_limit == b.encoder_thread_limit &&
+         SameSettings(a.codec, b.codec);
+}
+
+// Only one stream of VP8 is shared; simulcast and other codecs are encoded by
+// each connection as before. Should one connection ever have two proxies of
+// the same settings (calls send no simulcast), both are members of one group
+// and each gets every image: nothing breaks, nothing is saved.
+bool Shareable(const VideoCodec& codec) {
+  return codec.codecType == webrtc::kVideoCodecVP8 &&
+         codec.numberOfSimulcastStreams <= 1;
+}
+
+bool AsksForKeyFrame(const std::vector<VideoFrameType>* frame_types) {
+  if (frame_types == nullptr) {
+    return false;
+  }
+  for (VideoFrameType type : *frame_types) {
+    if (type == VideoFrameType::kVideoFrameKey) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::atomic<int> next_member_id{1};
+
+// What a group knows of one proxy. The proxy owns it; while the proxy is in a
+// group, every field is read and written under that group's mutex.
+struct Member {
+  struct Asked {
+    FrameKey frame;
+    uint32_t rtp_timestamp = 0;
+    int64_t ntp_time_ms = 0;
+  };
+
+  Member() : id(next_member_id.fetch_add(1)) {}
+
+  const Asked* AskedFor(const FrameKey& frame) const {
+    for (auto it = asked.rbegin(); it != asked.rend(); ++it) {
+      if (SameFrame(it->frame, frame)) {
+        return &*it;
+      }
+    }
+    return nullptr;
+  }
+
+  const int id;
+  EncodedImageCallback* callback = nullptr;
+  std::optional<VideoEncoder::RateControlParameters> rates;
+  // It has had a key frame of this group and every image since.
+  bool in_sync = false;
+  // It asked for nothing while others did; nothing until it asks again.
+  bool paused = false;
+  // It asked for a key frame that has not come yet.
+  bool wants_key = false;
+  // It is to leave for an encoder of its own on its next Encode.
+  bool isolate = false;
+  // An encoder error its next Encode returns.
+  int pending_error = 0;
+  // The capture time of the first image encoded for others since it last
+  // asked for a frame.
+  std::optional<int64_t> first_missed_us;
+  // The frames it asked for last, with the RTP and NTP times its
+  // VideoStreamEncoder gave them.
+  std::deque<Asked> asked;
+  // Images encoded since it is in sync that it has not had yet (group
+  // sequence numbers, oldest first).
+  std::deque<int64_t> held;
+  int64_t last_delivered = 0;
+  std::deque<Timestamp> key_requests;
+  std::optional<Timestamp> low_since;
+};
+
+class SharedEncodeGroup;
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+// The registry: the inner factory, the groups by key.
+
+class SharedEncodeRegistry {
+ public:
+  explicit SharedEncodeRegistry(
+      std::unique_ptr<webrtc::VideoEncoderFactory> inner)
+      : inner_(std::move(inner)) {}
+
+  webrtc::VideoEncoderFactory& inner() { return *inner_; }
+
+  // The live group of `key`, made when there is none.
+  std::shared_ptr<SharedEncodeGroup> GetOrCreate(
+      const std::shared_ptr<SharedEncodeRegistry>& self,
+      const GroupKey& key,
+      const Environment& env,
+      const SdpVideoFormat& format,
+      const VideoEncoder::Settings& settings,
+      const SharedEncodeConfig& config);
+  // The live group of `key`, if any.
+  std::shared_ptr<SharedEncodeGroup> Find(const GroupKey& key);
+  // Called by a group as it goes.
+  void ForgetDeadGroups();
+  int NewIsolation() {
+    MutexLock lock(&mutex_);
+    return next_isolation_++;
+  }
+  // What the inner factory's encoder says of itself before it is initialized:
+  // what a proxy says until it has an encoder.
+  VideoEncoder::EncoderInfo ProbeInfo(const Environment& env,
+                                      const SdpVideoFormat& format);
+
+ private:
+  // Set at construction. Its Create is called from the threads of every
+  // connection, as it was without this registry.
+  const std::unique_ptr<webrtc::VideoEncoderFactory> inner_;
+  Mutex mutex_;
+  // Weak: the proxies keep their groups. A shared_ptr taken from these is
+  // never let go while `mutex_` is held, as a group's destructor takes it.
+  std::vector<std::pair<GroupKey, std::weak_ptr<SharedEncodeGroup>>> groups_
+      RTC_GUARDED_BY(mutex_);
+  int next_isolation_ RTC_GUARDED_BY(mutex_) = 1;
+  std::optional<VideoEncoder::EncoderInfo> probe_ RTC_GUARDED_BY(mutex_);
+};
+
+namespace {
+
+// One real encoder, one task queue, its members.
+//
+// Threads: the members' methods run on their VideoStreamEncoders' encoder
+// queues; `real_` is used on `queue_` only (made, initialized, given rates,
+// encoding) and, once `queue_` is gone, released in the destructor. Every
+// delivery to a member's callback happens while `mutex_` is held, so one
+// member's images come in encode order, and once Leave() has returned no
+// image reaches that member.
+//
+// Lock order: a member's callback is VideoStreamEncoder::OnEncodedImage,
+// which posts to its own queue and enters SendStatisticsProxy and
+// RtpVideoSender (their own mutexes); none of those calls an encoder. A
+// VideoStreamEncoder calls its proxy with no lock held. The registry's mutex
+// and a group's are never held together.
+//
+// Life: only proxies hold a group, and they let go of it on their own threads.
+// Tasks on `queue_` hold a plain pointer, so the group is never destroyed on
+// `queue_`, which therefore never deletes itself.
+class SharedEncodeGroup final : public EncodedImageCallback {
+ public:
+  enum class Outcome { kDone, kIsolate };
+
+  SharedEncodeGroup(std::shared_ptr<SharedEncodeRegistry> registry,
+                    const GroupKey& key,
+                    const Environment& env,
+                    const SdpVideoFormat& format,
+                    const VideoEncoder::Settings& settings,
+                    const SharedEncodeConfig& config)
+      : registry_(std::move(registry)),
+        key_(key),
+        env_(env),
+        format_(format),
+        settings_(settings),
+        config_(config),
+        // As VideoStreamEncoder does: wall-clock NTP minus monotonic time,
+        // taken once, so the real encoder sees RTP timestamps that only grow.
+        ntp_delta_ms_(env.clock().CurrentNtpInMilliseconds() -
+                      env.clock().TimeInMilliseconds()),
+        queue_(env.task_queue_factory().CreateTaskQueue(
+            // 15 characters: the most a Linux thread name holds.
+            "SharedScreenEnc",
+            webrtc::TaskQueueFactory::Priority::kVideo)) {}
+
+  ~SharedEncodeGroup() override {
+    registry_->ForgetDeadGroups();
+    {
+      // With no member left, a frame waiting is all that would make an encode
+      // under way post another.
+      MutexLock lock(&mutex_);
+      next_.reset();
+    }
+    // Delete() waits for a task that runs, which may still post to the queue
+    // (dropped), so `queue_` keeps pointing at it until Delete() returns. The
+    // other tasks are dropped unrun; they hold nothing but a plain pointer to
+    // this group. WebRTC asks for a queue to be deleted where it was made;
+    // its implementations only require that it not be from the queue itself,
+    // which never happens here (see "Life" above).
+    queue_.get_deleter()(queue_.get());
+    (void)queue_.release();
+    if (real_ != nullptr) {
+      real_->Release();
+      real_ = nullptr;
+    }
+  }
+
+  const GroupKey& key() const { return key_; }
+
+  void Join(Member* member) {
+    MutexLock lock(&mutex_);
+    member->in_sync = false;
+    member->paused = false;
+    member->wants_key = true;
+    member->isolate = false;
+    member->pending_error = WEBRTC_VIDEO_CODEC_OK;
+    member->first_missed_us.reset();
+    member->held.clear();
+    member->last_delivered = seq_;
+    member->low_since.reset();
+    members_.push_back(member);
+    // Its first image is a key frame, shared with whoever else waits for one
+    // (unless it can start on one kept, see CatchUp).
+    if (member->callback != nullptr) {
+      key_wanted_ = true;
+    }
+  }
+
+  // A member released while the group encodes: real_->Encode() runs without
+  // `mutex_`, and the image is delivered under it to whoever is a member
+  // then, so a member gone by then gets nothing. Released while the group
+  // delivers (to it or another): Leave waits for `mutex_`, so it returns once
+  // that delivery ended, and none starts after.
+  void Leave(Member* member) {
+    MutexLock lock(&mutex_);
+    members_.erase(std::remove(members_.begin(), members_.end(), member),
+                   members_.end());
+    member->in_sync = false;
+    member->held.clear();
+  }
+
+  void SetCallback(Member* member, EncodedImageCallback* callback) {
+    MutexLock lock(&mutex_);
+    if (member->callback != callback) {
+      // Whatever had the images before, the new callback starts on a key
+      // frame.
+      member->callback = callback;
+      member->in_sync = false;
+      member->held.clear();
+    }
+  }
+
+  void SetRates(Member* member,
+                const VideoEncoder::RateControlParameters& rates) {
+    MutexLock lock(&mutex_);
+    member->rates = rates;
+  }
+
+  // The real encoder's own description, once it is initialized, named for the
+  // group when it is shared ("libvpx (shared)"; the app reads it from the
+  // outbound-rtp stats' encoderImplementation). Not the number of members:
+  // every VideoStreamEncoder compares the whole description with every frame
+  // and starts its rate adjuster and scalers over when it changes.
+  std::optional<VideoEncoder::EncoderInfo> Info() const {
+    MutexLock lock(&mutex_);
+    if (!real_info_) {
+      return std::nullopt;
+    }
+    VideoEncoder::EncoderInfo info = *real_info_;
+    if (key_.isolation == 0) {
+      info.implementation_name += " (shared)";
+    }
+    return info;
+  }
+
+  std::optional<uint32_t> AppliedBitrateBps() const {
+    MutexLock lock(&mutex_);
+    if (!applied_rates_) {
+      return std::nullopt;
+    }
+    return applied_rates_->bitrate.get_sum_bps();
+  }
+
+  // A member's VideoStreamEncoder asks for `frame` to be encoded (from the
+  // member's Encode). Returns kIsolate when the member is to leave for an
+  // encoder of its own instead; `error` gets an encoder error to return.
+  Outcome Request(Member* member,
+                  const VideoFrame& frame,
+                  const std::vector<VideoFrameType>* frame_types,
+                  int* error) {
+    const Timestamp now = env_.clock().CurrentTime();
+    const FrameKey key{frame.id(), frame.timestamp_us()};
+    const bool key_asked = AsksForKeyFrame(frame_types);
+
+    MutexLock lock(&mutex_);
+    // An encoder error, reported once, as an encoder of its own would:
+    // VideoStreamEncoder then asks for another encoder and stops encoding.
+    *error = std::exchange(member->pending_error, 0);
+    if (member->isolate) {
+      return Outcome::kIsolate;
+    }
+
+    member->paused = false;
+    member->first_missed_us.reset();
+    member->asked.push_back({key, frame.rtp_timestamp(), frame.ntp_time_ms()});
+    if (member->asked.size() > kAskedFrames) {
+      member->asked.pop_front();
+    }
+
+    if (key_asked && member->in_sync && !member->wants_key) {
+      // A key frame lost on its way: its receiver asked. Asks repeated while
+      // one is due are not counted. A member that keeps asking costs every
+      // other member a key frame each time: it gets an encoder of its own.
+      if (CountKeyRequest(member, now)) {
+        return Outcome::kIsolate;
+      }
+    }
+    if (key_asked || !member->in_sync) {
+      member->wants_key = true;
+      // Encode called before RegisterEncodeCompleteCallback: it could not be
+      // given the key frame, so it costs the others none until it can.
+      if (member->callback != nullptr) {
+        key_wanted_ = true;
+      }
+    }
+
+    // Encoded already: delivered unless it was (pushed, or skipped as the
+    // member was not in sync yet).
+    for (const Cached& cached : cache_) {
+      if (SameFrame(cached.key, key)) {
+        if (!member->in_sync) {
+          CatchUp(member, cached.seq);
+        }
+        if (member->in_sync && cached.seq > member->last_delivered) {
+          DeliverUpTo(member, cached.seq);
+        }
+        return Outcome::kDone;
+      }
+    }
+    // Images it skipped before this frame go first, in order.
+    if (member->in_sync) {
+      while (!member->held.empty()) {
+        const Cached* held = FindCached(member->held.front());
+        if (held != nullptr && !NewerFrame(key, held->key)) {
+          break;
+        }
+        DeliverUpTo(member, member->held.front());
+        if (!member->in_sync) {
+          break;
+        }
+      }
+    }
+    if (encoding_ && SameFrame(*encoding_, key)) {
+      // OnEncodedImage finds it in `asked`.
+      return Outcome::kDone;
+    }
+    if (next_ && SameFrame(next_->key, key)) {
+      if (!frame.has_update_rect()) {
+        next_->rect_unknown = true;
+      } else {
+        next_->rect.Union(frame.update_rect());
+      }
+      return Outcome::kDone;
+    }
+    if ((taken_ && !NewerFrame(key, *taken_)) ||
+        (next_ && !NewerFrame(key, next_->key))) {
+      // Older than what the group encodes: dropped, for this member as by an
+      // encoder (its metadata writer reports it once a newer image comes). Its
+      // changes may be missing from the next frame's update rectangle.
+      dropped_since_taken_ = true;
+      return Outcome::kDone;
+    }
+    if (next_) {
+      // Replaced before it was encoded: dropped for all who asked for it.
+      dropped_since_taken_ = true;
+    }
+    next_ = Next{frame, key, !frame.has_update_rect(), frame.update_rect()};
+    if (!encode_scheduled_) {
+      encode_scheduled_ = true;
+      queue_->PostTask([this] { EncodeNext(); });
+    }
+    return Outcome::kDone;
+  }
+
+  // EncodedImageCallback, for `real_`: inside real_->Encode() on `queue_`.
+  Result OnEncodedImage(const EncodedImage& image,
+                        const CodecSpecificInfo* info) override {
+    const Timestamp now = env_.clock().CurrentTime();
+    MutexLock lock(&mutex_);
+    if (!encoding_) {
+      // Not inside Encode(): an encoder that calls back on its own thread
+      // later than this group expects. Nothing to tell whose frame it is.
+      RTC_LOG(LS_WARNING) << "Shared encoder: image outside Encode() dropped";
+      return Result(Result::OK);
+    }
+    const FrameKey key = *encoding_;
+    // Room for it. A member still holding the oldest image gets it now, so
+    // no member misses one.
+    while (cache_.size() >= kCachedImages) {
+      const int64_t oldest = cache_.front().seq;
+      for (Member* member : members_) {
+        if (!member->held.empty() && member->held.front() <= oldest) {
+          DeliverUpTo(member, oldest);
+        }
+      }
+      cache_.pop_front();
+    }
+    cache_.push_back(Cached{key, ++seq_, image,
+                            info != nullptr
+                                ? std::optional<CodecSpecificInfo>(*info)
+                                : std::nullopt});
+    const Cached& cached = cache_.back();
+    const bool key_frame = image.IsKey();
+    if (key_frame) {
+      last_key_at_ = now;
+      key_wanted_ = false;
+    }
+    const TimeDelta push_after = FrameInterval();
+    for (Member* member : members_) {
+      if (member->callback == nullptr) {
+        continue;
+      }
+      if (!member->in_sync) {
+        // Not in sync: only a key frame starts it; a paused member waits
+        // until it asks again.
+        if (!key_frame || member->paused) {
+          continue;
+        }
+        member->in_sync = true;
+        member->held.clear();
+        member->last_delivered = cached.seq - 1;
+      }
+      if (key_frame) {
+        member->wants_key = false;
+      }
+      if (member->AskedFor(key) != nullptr) {
+        DeliverUpTo(member, cached.seq);
+      } else if (member->first_missed_us &&
+                 key.timestamp_us - *member->first_missed_us >=
+                     int64_t{config_.live_ms} * 1000) {
+        // It has asked for nothing for live_ms while others did: its
+        // connection paused (no bitrate, network down) or stopped sending
+        // this track. A key frame when it asks again.
+        member->in_sync = false;
+        member->paused = true;
+        member->held.clear();
+      } else {
+        // Skipped by its VideoStreamEncoder (congestion window, a queue
+        // still busy, the first frames at a low bitrate) or not asked for
+        // yet: it gets the image when it asks, or pushed one frame later.
+        // Never missing one keeps its stream decodable: its picture ids
+        // count what it is given.
+        if (!member->first_missed_us) {
+          member->first_missed_us = key.timestamp_us;
+        }
+        member->held.push_back(cached.seq);
+        queue_->PostDelayedTask(
+            [this, id = member->id, seq = cached.seq] { PushHeld(id, seq); },
+            push_after);
+      }
+    }
+    return Result(Result::OK);
+  }
+
+  void OnFrameDropped(uint32_t /* rtp_timestamp */,
+                      int /* spatial_id */,
+                      bool /* is_end_of_temporal_unit */) override {
+    // A frame the real encoder dropped: each member's metadata writer reports
+    // its own frame as dropped when its next image comes.
+  }
+
+ private:
+  struct Next {
+    VideoFrame frame;
+    FrameKey key;
+    bool rect_unknown;
+    VideoFrame::UpdateRect rect;
+  };
+
+  struct Cached {
+    FrameKey key;
+    int64_t seq;
+    // Shares its buffer with every copy given to members.
+    EncodedImage image;
+    std::optional<CodecSpecificInfo> info;
+  };
+
+  // On `queue_`.
+  void EncodeNext() {
+    std::optional<VideoFrame> frame;
+    std::vector<VideoFrameType> frame_types(1,
+                                            VideoFrameType::kVideoFrameDelta);
+    std::optional<VideoEncoder::RateControlParameters> apply_rates;
+    {
+      MutexLock lock(&mutex_);
+      if (!next_) {
+        encode_scheduled_ = false;
+        return;
+      }
+      const Timestamp now = env_.clock().CurrentTime();
+      Next next = std::move(*next_);
+      next_.reset();
+      CheckSlowMembers(now);
+      std::optional<VideoEncoder::RateControlParameters> rates = GroupRates();
+      if (rates && (real_ == nullptr || !applied_rates_ ||
+                    *rates != *applied_rates_)) {
+        applied_rates_ = rates;
+        apply_rates = rates;
+      } else if (real_ == nullptr && applied_rates_) {
+        apply_rates = applied_rates_;
+      }
+      const bool key_due =
+          !last_key_at_ ||
+          now - *last_key_at_ >= TimeDelta::Millis(config_.key_ms);
+      if (real_ == nullptr || (key_wanted_ && key_due)) {
+        frame_types[0] = VideoFrameType::kVideoFrameKey;
+      }
+      frame.emplace(next.frame);
+      // The real encoder's own timestamps, as one VideoStreamEncoder would
+      // give them; each member gets its own back with the image.
+      frame->set_rtp_timestamp(
+          kRtpTicksPerMs *
+          static_cast<uint32_t>(frame->render_time_ms() + ntp_delta_ms_));
+      // Every asker's rectangle covers what changed since the frame it asked
+      // for before; a frame the group dropped since its last one leaves a
+      // change no one reports.
+      if (next.rect_unknown || dropped_since_taken_) {
+        frame->clear_update_rect();
+      } else {
+        frame->set_update_rect(next.rect);
+      }
+      dropped_since_taken_ = false;
+      taken_ = next.key;
+      encoding_ = next.key;
+    }
+
+    if (real_ == nullptr) {
+      VideoEncoder::Settings settings = settings_;
+      if (config_.threads) {
+        settings.encoder_thread_limit = *config_.threads;
+      }
+      real_ = registry_->inner().Create(env_, format_);
+      int result = real_ != nullptr
+                       ? real_->InitEncode(&key_.codec, settings)
+                       : WEBRTC_VIDEO_CODEC_ERROR;
+      if (result != WEBRTC_VIDEO_CODEC_OK) {
+        RTC_LOG(LS_ERROR) << "Shared encoder: InitEncode failed: " << result;
+        real_ = nullptr;
+        // Each member hears of it on its next Encode. The next frame asked
+        // for tries again.
+        MutexLock lock(&mutex_);
+        for (Member* member : members_) {
+          member->pending_error =
+              result < 0 ? result : WEBRTC_VIDEO_CODEC_ERROR;
+        }
+        encoding_.reset();
+        next_.reset();
+        encode_scheduled_ = false;
+        return;
+      }
+      real_->RegisterEncodeCompleteCallback(this);
+      MutexLock lock(&mutex_);
+      real_info_ = real_->GetEncoderInfo();
+    }
+    if (apply_rates) {
+      real_->SetRates(*apply_rates);
+    }
+    // Calls OnEncodedImage before it returns, or not at all when the encoder
+    // drops the frame itself; then a key frame wanted stays wanted.
+    const int32_t result = real_->Encode(*frame, &frame_types);
+
+    MutexLock lock(&mutex_);
+    encoding_.reset();
+    if (result < 0) {
+      // Each member's VideoStreamEncoder hears of it on its next Encode, as
+      // it would from an encoder of its own.
+      RTC_LOG(LS_ERROR) << "Shared encoder: Encode failed: " << result;
+      for (Member* member : members_) {
+        member->pending_error = result;
+      }
+    }
+    if (next_) {
+      queue_->PostTask([this] { EncodeNext(); });
+    } else {
+      encode_scheduled_ = false;
+    }
+  }
+
+  // On `queue_`: a member that has not asked for an image one frame after it
+  // was encoded gets it anyway.
+  void PushHeld(int member_id, int64_t seq) {
+    MutexLock lock(&mutex_);
+    for (Member* member : members_) {
+      if (member->id == member_id) {
+        if (member->in_sync &&
+            std::find(member->held.begin(), member->held.end(), seq) !=
+                member->held.end()) {
+          DeliverUpTo(member, seq);
+        }
+        return;
+      }
+    }
+  }
+
+  const Cached* FindCached(int64_t seq) const
+      RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    for (const Cached& cached : cache_) {
+      if (cached.seq == seq) {
+        return &cached;
+      }
+    }
+    return nullptr;
+  }
+
+  // Delivers to `member` every image it holds up to `seq`, then `seq` itself,
+  // in order.
+  void DeliverUpTo(Member* member, int64_t seq)
+      RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    while (member->in_sync && !member->held.empty() &&
+           member->held.front() <= seq) {
+      const int64_t held = member->held.front();
+      member->held.pop_front();
+      if (const Cached* cached = FindCached(held)) {
+        Deliver(member, *cached);
+      }
+    }
+    if (member->in_sync && member->last_delivered < seq) {
+      if (const Cached* cached = FindCached(seq)) {
+        Deliver(member, *cached);
+      }
+    }
+  }
+
+  void Deliver(Member* member, const Cached& cached)
+      RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    if (cached.seq <= member->last_delivered) {
+      return;
+    }
+    if (member->callback == nullptr) {
+      LoseSync(member);
+      return;
+    }
+    EncodedImage image(cached.image);
+    // Encode times are its VideoStreamEncoder's to fill in, for the frames it
+    // asked for; for the others the encode took no time of its own.
+    image.timing_ = EncodedImage::Timing();
+    if (const Member::Asked* asked = member->AskedFor(cached.key)) {
+      // Matched by its FrameEncodeMetadataWriter, which fills in capture and
+      // NTP time, rotation and encode timing as for its own encoder's images.
+      image.SetRtpTimestamp(asked->rtp_timestamp);
+    } else if (!member->asked.empty()) {
+      // Not asked for (pushed). VideoStreamEncoder makes RTP timestamps as
+      // 90 * (capture ms + a delta fixed when it was made), so the one it
+      // would have given this frame follows from any frame it did give one.
+      // What its VideoStreamEncoder::OnEncodedImage does with it: its
+      // FrameEncodeMetadataWriter finds no record of the RTP timestamp (it
+      // logs that, throttled), so the image keeps these capture and NTP times
+      // and invalid timing, and the frames it asked for before it are
+      // reported dropped by the encoder (they were, for this member).
+      // SendStatisticsProxy still counts it (framesEncoded, keyFramesEncoded,
+      // bytes, QP) and adds its encode time, 0 here; RtpVideoSender packetizes
+      // and sends it, and the send stream counts it as activity. Stats it
+      // skews: framesEncoded and keyFramesEncoded include key frames others
+      // asked for; totalEncodeTime of a matched image includes the wait for
+      // the group (one encode, counted by every member: the app takes the
+      // largest per size, not the sum). The frame instrumentation generator
+      // (corruption detection) would see images it did not see the frame
+      // of; it is on only with the corruption detection header extension,
+      // which WebRTC offers stopped and calls never enable.
+      const Member::Asked& last = member->asked.back();
+      const int64_t capture_ms = cached.key.timestamp_us / 1000;
+      const int64_t delta_ms = capture_ms - last.frame.timestamp_us / 1000;
+      image.SetRtpTimestamp(last.rtp_timestamp +
+                            kRtpTicksPerMs * static_cast<uint32_t>(delta_ms));
+      image.capture_time_ms_ = capture_ms;
+      image.ntp_time_ms_ = last.ntp_time_ms + delta_ms;
+    } else {
+      LoseSync(member);
+      return;
+    }
+    member->last_delivered = cached.seq;
+    const Result result = member->callback->OnEncodedImage(
+        image, cached.info ? &*cached.info : nullptr);
+    if (result.error != Result::OK) {
+      // Its connection did not send it (not sending at the moment): what it
+      // sends next must not refer to it.
+      LoseSync(member);
+    }
+  }
+
+  // A member out of sync asks for a frame encoded already (it joined, or came
+  // back, a moment after the others asked for it): when a key frame and every
+  // image since are still kept, it starts there instead of waiting for the
+  // next key frame. Up to the frame it asked for it gets them now, the newer
+  // ones one frame later unless it asks first.
+  void CatchUp(Member* member, int64_t seq)
+      RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    if (member->callback == nullptr) {
+      return;
+    }
+    std::optional<int64_t> key_seq;
+    for (const Cached& cached : cache_) {
+      if (cached.seq <= seq && cached.image.IsKey()) {
+        key_seq = cached.seq;
+      }
+    }
+    if (!key_seq) {
+      return;
+    }
+    member->in_sync = true;
+    member->paused = false;
+    member->wants_key = false;
+    member->held.clear();
+    member->last_delivered = *key_seq - 1;
+    const TimeDelta push_after = FrameInterval();
+    for (const Cached& cached : cache_) {
+      if (cached.seq < *key_seq) {
+        continue;
+      }
+      member->held.push_back(cached.seq);
+      if (cached.seq > seq) {
+        queue_->PostDelayedTask(
+            [this, id = member->id, held = cached.seq] { PushHeld(id, held); },
+            push_after);
+      }
+    }
+    UpdateKeyWanted();
+  }
+
+  // Whether a member that can take one waits for a key frame.
+  void UpdateKeyWanted() RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    key_wanted_ = false;
+    for (const Member* member : members_) {
+      if (member->callback != nullptr && !member->paused &&
+          member->wants_key) {
+        key_wanted_ = true;
+      }
+    }
+  }
+
+  void LoseSync(Member* member) RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    if (member->in_sync) {
+      // Counted as a lost key frame: a connection that keeps failing gets an
+      // encoder of its own.
+      if (CountKeyRequest(member, env_.clock().CurrentTime())) {
+        member->isolate = true;
+      }
+    }
+    member->in_sync = false;
+    member->held.clear();
+    member->wants_key = true;
+    if (member->callback != nullptr) {
+      key_wanted_ = true;
+    }
+  }
+
+  // Returns whether `member` asked often enough to be isolated.
+  bool CountKeyRequest(Member* member, Timestamp now)
+      RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    while (!member->key_requests.empty() &&
+           now - member->key_requests.front() >= kKeyRequestWindow) {
+      member->key_requests.pop_front();
+    }
+    member->key_requests.push_back(now);
+    if (members_.size() > 1 &&
+        member->key_requests.size() >=
+            static_cast<size_t>(config_.isolate_keys)) {
+      member->key_requests.clear();
+      member->isolate = true;
+      return true;
+    }
+    return false;
+  }
+
+  // Members with a say in the rates: not paused, not leaving; those in sync
+  // when there are any (members waiting for their first key frame otherwise).
+  std::vector<const Member*> RatedMembers() const
+      RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    std::vector<const Member*> in_sync;
+    std::vector<const Member*> waiting;
+    for (const Member* member : members_) {
+      if (!member->rates || member->paused || member->isolate) {
+        continue;
+      }
+      (member->in_sync ? in_sync : waiting).push_back(member);
+    }
+    return in_sync.empty() ? waiting : in_sync;
+  }
+
+  // The lowest member's allocation, so every connection carries the stream;
+  // a member far below the others is isolated rather than lowering everyone
+  // for long. Its VideoStreamEncoder never sets a rate of 0 (it just stops
+  // asking), so a paused member is left out by liveness. With no member to
+  // go by, the rates stay as they were.
+  std::optional<VideoEncoder::RateControlParameters> GroupRates() const
+      RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    const std::vector<const Member*> rated = RatedMembers();
+    if (rated.empty()) {
+      return std::nullopt;
+    }
+    const Member* lowest = rated.front();
+    webrtc::DataRate bandwidth = rated.front()->rates->bandwidth_allocation;
+    double framerate = rated.front()->rates->framerate_fps;
+    for (const Member* member : rated) {
+      if (member->rates->bitrate.get_sum_bps() <
+          lowest->rates->bitrate.get_sum_bps()) {
+        lowest = member;
+      }
+      bandwidth = std::min(bandwidth, member->rates->bandwidth_allocation);
+      framerate = std::max(framerate, member->rates->framerate_fps);
+    }
+    VideoEncoder::RateControlParameters rates = *lowest->rates;
+    rates.bandwidth_allocation = bandwidth;
+    rates.framerate_fps = framerate;
+    return rates;
+  }
+
+  // A member whose bitrate stays far under the others' is isolated.
+  void CheckSlowMembers(Timestamp now) RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    std::vector<Member*> live;
+    for (Member* member : members_) {
+      if (member->rates && member->in_sync && !member->paused &&
+          !member->isolate) {
+        live.push_back(member);
+      } else {
+        member->low_since.reset();
+      }
+    }
+    for (Member* member : live) {
+      std::vector<uint32_t> others;
+      for (const Member* other : live) {
+        if (other != member) {
+          others.push_back(other->rates->bitrate.get_sum_bps());
+        }
+      }
+      if (others.size() < 2) {
+        member->low_since.reset();
+        continue;
+      }
+      std::sort(others.begin(), others.end());
+      const size_t half = others.size() / 2;
+      const double median =
+          others.size() % 2 == 1
+              ? others[half]
+              : (static_cast<double>(others[half - 1]) + others[half]) / 2;
+      if (member->rates->bitrate.get_sum_bps() >=
+          config_.isolate_ratio * median) {
+        member->low_since.reset();
+      } else if (!member->low_since) {
+        member->low_since = now;
+      } else if (now - *member->low_since >=
+                 TimeDelta::Millis(config_.isolate_ms)) {
+        member->isolate = true;
+        member->low_since.reset();
+      }
+    }
+  }
+
+  // One frame at the group's frame rate, from 20 to 100 ms.
+  TimeDelta FrameInterval() const RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    double fps = applied_rates_ ? applied_rates_->framerate_fps : 30.0;
+    if (!(fps > 0)) {
+      fps = 30.0;
+    }
+    const int64_t ms = static_cast<int64_t>(1000.0 / fps + 0.5);
+    return TimeDelta::Millis(std::clamp<int64_t>(ms, 20, 100));
+  }
+
+  const std::shared_ptr<SharedEncodeRegistry> registry_;
+  const GroupKey key_;
+  const Environment env_;
+  const SdpVideoFormat format_;
+  const VideoEncoder::Settings settings_;
+  const SharedEncodeConfig config_;
+  const int64_t ntp_delta_ms_;
+
+  mutable Mutex mutex_;
+  std::vector<Member*> members_ RTC_GUARDED_BY(mutex_);
+  // The newest frame asked for and not taken for encoding yet.
+  std::optional<Next> next_ RTC_GUARDED_BY(mutex_);
+  bool encode_scheduled_ RTC_GUARDED_BY(mutex_) = false;
+  // The last frame taken for encoding, and the one inside real_->Encode().
+  std::optional<FrameKey> taken_ RTC_GUARDED_BY(mutex_);
+  std::optional<FrameKey> encoding_ RTC_GUARDED_BY(mutex_);
+  bool dropped_since_taken_ RTC_GUARDED_BY(mutex_) = false;
+  std::deque<Cached> cache_ RTC_GUARDED_BY(mutex_);
+  int64_t seq_ RTC_GUARDED_BY(mutex_) = 0;
+  bool key_wanted_ RTC_GUARDED_BY(mutex_) = false;
+  std::optional<Timestamp> last_key_at_ RTC_GUARDED_BY(mutex_);
+  std::optional<VideoEncoder::RateControlParameters> applied_rates_
+      RTC_GUARDED_BY(mutex_);
+  std::optional<VideoEncoder::EncoderInfo> real_info_ RTC_GUARDED_BY(mutex_);
+
+  // On `queue_` only (and in the destructor once `queue_` is gone).
+  std::unique_ptr<VideoEncoder> real_;
+
+  // Last: made once everything its tasks use is.
+  std::unique_ptr<webrtc::TaskQueueBase, webrtc::TaskQueueDeleter> queue_;
+};
+
+// ---------------------------------------------------------------------------
+// The encoder each VideoStreamEncoder gets.
+
+class SharedEncoderProxy final : public VideoEncoder {
+ public:
+  SharedEncoderProxy(std::shared_ptr<SharedEncodeRegistry> registry,
+                     const Environment& env,
+                     const SdpVideoFormat& format,
+                     const SharedEncodeConfig& config)
+      : registry_(std::move(registry)),
+        env_(env),
+        format_(format),
+        config_(config),
+        rejoin_wait_(TimeDelta::Millis(config.rejoin_ms)) {}
+
+  ~SharedEncoderProxy() override { LeaveGroup(); }
+
+  void SetFecControllerOverride(
+      webrtc::FecControllerOverride* fec_controller_override) override {
+    fec_controller_override_ = fec_controller_override;
+    if (direct_ != nullptr) {
+      direct_->SetFecControllerOverride(fec_controller_override);
+    }
+  }
+
+  // Keeps the settings; no encoder is made before the first frame tells
+  // whether it can be shared. Called again on a live proxy (a new size, a new
+  // quality): it leaves its group, and its next frame finds the group of the
+  // new settings, starting on a key frame as an encoder initialized again
+  // would.
+  int InitEncode(const VideoCodec* codec_settings,
+                 const VideoEncoder::Settings& settings) override {
+    if (codec_settings == nullptr) {
+      return WEBRTC_VIDEO_CODEC_ERR_PARAMETER;
+    }
+    LeaveGroup();
+    codec_ = *codec_settings;
+    settings_ = settings;
+    if (direct_ != nullptr) {
+      return direct_->InitEncode(codec_settings, settings);
+    }
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+
+  int32_t RegisterEncodeCompleteCallback(
+      EncodedImageCallback* callback) override {
+    callback_ = callback;
+    if (direct_ != nullptr) {
+      return direct_->RegisterEncodeCompleteCallback(callback);
+    }
+    if (group_ != nullptr) {
+      group_->SetCallback(&member_, callback);
+    } else {
+      member_.callback = callback;
+    }
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+
+  // Once it returns, no image reaches the callback (a delivery under way is
+  // waited for). When it was the group's last member, the group goes, with
+  // its encoder and thread.
+  int32_t Release() override {
+    LeaveGroup();
+    codec_.reset();
+    if (direct_ != nullptr) {
+      return direct_->Release();
+    }
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+
+  int32_t Encode(const VideoFrame& frame,
+                 const std::vector<VideoFrameType>* frame_types) override {
+    if (!codec_ || !settings_) {
+      return WEBRTC_VIDEO_CODEC_UNINITIALIZED;
+    }
+    const int slot = SharedEncodeSlotOf(frame.id());
+    if (slot == 0 || !Shareable(*codec_)) {
+      return EncodeDirect(frame, frame_types);
+    }
+    if (direct_ != nullptr) {
+      direct_->Release();
+      direct_ = nullptr;
+    }
+    const Timestamp now = env_.clock().CurrentTime();
+    if (isolation_ != 0) {
+      MaybeRejoin(slot, now);
+    }
+    for (int attempt = 0; attempt < 2; ++attempt) {
+      const GroupKey key = KeyFor(slot, isolation_);
+      if (group_ == nullptr || !SameKey(group_->key(), key)) {
+        JoinGroup(key);
+      }
+      int error = WEBRTC_VIDEO_CODEC_OK;
+      if (group_->Request(&member_, frame, frame_types, &error) ==
+          SharedEncodeGroup::Outcome::kDone) {
+        return error;
+      }
+      Isolate(now);
+    }
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+
+  void SetRates(const RateControlParameters& parameters) override {
+    rates_ = parameters;
+    if (direct_ != nullptr) {
+      direct_->SetRates(parameters);
+    } else if (group_ != nullptr) {
+      group_->SetRates(&member_, parameters);
+    } else {
+      member_.rates = parameters;
+    }
+  }
+
+  // A shared encoder makes VP8 of one temporal layer, which takes no use of
+  // these (DefaultTemporalLayers ignores them); an own encoder gets them.
+  void OnPacketLossRateUpdate(float packet_loss_rate) override {
+    if (direct_ != nullptr) {
+      direct_->OnPacketLossRateUpdate(packet_loss_rate);
+    }
+  }
+  void OnRttUpdate(int64_t rtt_ms) override {
+    if (direct_ != nullptr) {
+      direct_->OnRttUpdate(rtt_ms);
+    }
+  }
+  void OnLossNotification(const LossNotification& loss_notification) override {
+    if (direct_ != nullptr) {
+      direct_->OnLossNotification(loss_notification);
+    }
+  }
+
+  // The real encoder's. Until it is initialized, what the inner factory's
+  // encoder says before initialization; VideoStreamEncoder reads it again
+  // with every frame and adapts once it changes.
+  EncoderInfo GetEncoderInfo() const override {
+    if (direct_ != nullptr) {
+      return direct_->GetEncoderInfo();
+    }
+    if (group_ != nullptr) {
+      if (std::optional<EncoderInfo> info = group_->Info()) {
+        return *info;
+      }
+    }
+    return registry_->ProbeInfo(env_, format_);
+  }
+
+ private:
+  // Untagged frames (cameras) or settings that are not shared: an encoder of
+  // its own, used on this thread as without the proxy.
+  int32_t EncodeDirect(const VideoFrame& frame,
+                       const std::vector<VideoFrameType>* frame_types) {
+    LeaveGroup();
+    if (direct_ != nullptr) {
+      return direct_->Encode(frame, frame_types);
+    }
+    direct_ = registry_->inner().Create(env_, format_);
+    if (direct_ == nullptr) {
+      return WEBRTC_VIDEO_CODEC_ERROR;
+    }
+    direct_->SetFecControllerOverride(fec_controller_override_);
+    const int result = direct_->InitEncode(&*codec_, *settings_);
+    if (result != WEBRTC_VIDEO_CODEC_OK) {
+      direct_ = nullptr;
+      return result < 0 ? result : WEBRTC_VIDEO_CODEC_ERROR;
+    }
+    if (callback_ != nullptr) {
+      direct_->RegisterEncodeCompleteCallback(callback_);
+    }
+    if (rates_) {
+      direct_->SetRates(*rates_);
+    }
+    // A new encoder starts on a key frame.
+    std::vector<VideoFrameType> key_frame(
+        frame_types != nullptr && !frame_types->empty() ? frame_types->size()
+                                                        : 1,
+        VideoFrameType::kVideoFrameKey);
+    return direct_->Encode(frame, &key_frame);
+  }
+
+  GroupKey KeyFor(int slot, int isolation) const {
+    GroupKey key;
+    key.slot = slot;
+    key.isolation = isolation;
+    key.codec = *codec_;
+    key.number_of_cores = settings_->number_of_cores;
+    key.encoder_thread_limit = settings_->encoder_thread_limit;
+    return key;
+  }
+
+  void JoinGroup(const GroupKey& key) {
+    LeaveGroup();
+    group_ = registry_->GetOrCreate(registry_, key, env_, format_, *settings_,
+                                    config_);
+    member_.callback = callback_;
+    member_.rates = rates_;
+    group_->Join(&member_);
+  }
+
+  void LeaveGroup() {
+    if (group_ == nullptr) {
+      return;
+    }
+    group_->Leave(&member_);
+    // May destroy the group, here, on this connection's thread: never on the
+    // group's own queue.
+    group_ = nullptr;
+  }
+
+  // Off to an encoder of its own, which drives only its own requests: its
+  // VideoStreamEncoder's drops apply as without sharing, so the app sees its
+  // lower frame rate and steps it down to another size.
+  void Isolate(Timestamp now) {
+    const TimeDelta first_wait = TimeDelta::Millis(config_.rejoin_ms);
+    if (rejoined_at_ && now - *rejoined_at_ < kRejoinMustLast) {
+      rejoin_wait_ = std::min(rejoin_wait_ * 2, first_wait * 16);
+    } else {
+      rejoin_wait_ = first_wait;
+    }
+    rejoined_at_.reset();
+    isolation_ = registry_->NewIsolation();
+    good_since_.reset();
+    last_rejoin_check_ = now;
+    RTC_LOG(LS_INFO) << "Shared encoder: a connection gets its own encoder"
+                     << " for at least " << rejoin_wait_.ms() << " ms";
+  }
+
+  // Back to the shared group once its bitrate has been at least the group's
+  // for long enough (or the group is gone).
+  void MaybeRejoin(int slot, Timestamp now) {
+    if (last_rejoin_check_ &&
+        now - *last_rejoin_check_ < kRejoinCheckInterval) {
+      return;
+    }
+    last_rejoin_check_ = now;
+    std::shared_ptr<SharedEncodeGroup> shared =
+        registry_->Find(KeyFor(slot, 0));
+    std::optional<uint32_t> group_bps;
+    if (shared != nullptr) {
+      group_bps = shared->AppliedBitrateBps();
+    }
+    const uint32_t own_bps = rates_ ? rates_->bitrate.get_sum_bps() : 0;
+    if (shared == nullptr || !group_bps || own_bps >= *group_bps) {
+      if (!good_since_) {
+        good_since_ = now;
+      }
+      if (shared == nullptr || now - *good_since_ >= rejoin_wait_) {
+        isolation_ = 0;
+        rejoined_at_ = now;
+        good_since_.reset();
+      }
+    } else {
+      good_since_.reset();
+    }
+    // `shared` may be the last hold on that group: let go of here, on this
+    // thread, holding no lock.
+  }
+
+  const std::shared_ptr<SharedEncodeRegistry> registry_;
+  const Environment env_;
+  const SdpVideoFormat format_;
+  const SharedEncodeConfig config_;
+
+  // All on the VideoStreamEncoder's encoder queue.
+  std::optional<VideoCodec> codec_;
+  std::optional<VideoEncoder::Settings> settings_;
+  EncodedImageCallback* callback_ = nullptr;
+  std::optional<RateControlParameters> rates_;
+  webrtc::FecControllerOverride* fec_controller_override_ = nullptr;
+  std::unique_ptr<VideoEncoder> direct_;
+  std::shared_ptr<SharedEncodeGroup> group_;
+  // Read and written under group_'s mutex while in a group.
+  Member member_;
+  int isolation_ = 0;
+  TimeDelta rejoin_wait_;
+  std::optional<Timestamp> rejoined_at_;
+  std::optional<Timestamp> good_since_;
+  std::optional<Timestamp> last_rejoin_check_;
+};
+
+}  // namespace
+
+// ---------------------------------------------------------------------------
+
+std::shared_ptr<SharedEncodeGroup> SharedEncodeRegistry::GetOrCreate(
+    const std::shared_ptr<SharedEncodeRegistry>& self,
+    const GroupKey& key,
+    const Environment& env,
+    const SdpVideoFormat& format,
+    const VideoEncoder::Settings& settings,
+    const SharedEncodeConfig& config) {
+  std::shared_ptr<SharedEncodeGroup> group;
+  {
+    MutexLock lock(&mutex_);
+    for (auto& [group_key, weak] : groups_) {
+      if (SameKey(group_key, key)) {
+        group = weak.lock();
+        if (group != nullptr) {
+          break;
+        }
+      }
+    }
+    if (group == nullptr) {
+      groups_.erase(std::remove_if(groups_.begin(), groups_.end(),
+                                   [](const auto& entry) {
+                                     return entry.second.expired();
+                                   }),
+                    groups_.end());
+      group = std::make_shared<SharedEncodeGroup>(self, key, env, format,
+                                                  settings, config);
+      groups_.emplace_back(key, group);
+    }
+  }
+  return group;
+}
+
+std::shared_ptr<SharedEncodeGroup> SharedEncodeRegistry::Find(
+    const GroupKey& key) {
+  std::shared_ptr<SharedEncodeGroup> group;
+  {
+    MutexLock lock(&mutex_);
+    for (auto& [group_key, weak] : groups_) {
+      if (SameKey(group_key, key)) {
+        group = weak.lock();
+        if (group != nullptr) {
+          break;
+        }
+      }
+    }
+  }
+  return group;
+}
+
+void SharedEncodeRegistry::ForgetDeadGroups() {
+  MutexLock lock(&mutex_);
+  groups_.erase(std::remove_if(groups_.begin(), groups_.end(),
+                               [](const auto& entry) {
+                                 return entry.second.expired();
+                               }),
+                groups_.end());
+}
+
+VideoEncoder::EncoderInfo SharedEncodeRegistry::ProbeInfo(
+    const Environment& env,
+    const SdpVideoFormat& format) {
+  MutexLock lock(&mutex_);
+  if (!probe_) {
+    std::unique_ptr<VideoEncoder> probe = inner_->Create(env, format);
+    probe_ = probe != nullptr ? probe->GetEncoderInfo()
+                              : VideoEncoder::EncoderInfo();
+  }
+  return *probe_;
+}
+
+// ---------------------------------------------------------------------------
+
+int AcquireSharedEncodeSlot() {
+  SlotTable& table = Slots();
+  MutexLock lock(&table.mutex);
+  for (int i = 1; i <= kSharedEncodeSlots; ++i) {
+    const int slot = (table.last + i - 1) % kSharedEncodeSlots + 1;
+    if (!table.used[slot]) {
+      table.used[slot] = true;
+      table.last = slot;
+      return slot;
+    }
+  }
+  return 0;
+}
+
+void ReleaseSharedEncodeSlot(int slot) {
+  if (slot < 1 || slot > kSharedEncodeSlots) {
+    return;
+  }
+  SlotTable& table = Slots();
+  MutexLock lock(&table.mutex);
+  table.used[slot] = false;
+}
+
+uint16_t SharedEncodeFrameId(int slot, uint32_t seq) {
+  return static_cast<uint16_t>(((slot & 0x0f) << 12) | (seq & 0x0fff));
+}
+
+int SharedEncodeSlotOf(uint16_t id) {
+  return id >> 12;
+}
+
+SharedEncodeTag::SharedEncodeTag() = default;
+
+SharedEncodeTag::~SharedEncodeTag() {
+  ReleaseSharedEncodeSlot(slot_.exchange(0));
+}
+
+bool SharedEncodeTag::Enable() {
+  if (slot_.load(std::memory_order_acquire) != 0) {
+    return true;
+  }
+  const int slot = AcquireSharedEncodeSlot();
+  if (slot == 0) {
+    RTC_LOG(LS_WARNING) << "Shared encoder: no source number free; this "
+                           "source is encoded for each connection";
+    return false;
+  }
+  int expected = 0;
+  if (!slot_.compare_exchange_strong(expected, slot,
+                                     std::memory_order_acq_rel)) {
+    ReleaseSharedEncodeSlot(slot);  // Another call took one first.
+  }
+  return true;
+}
+
+uint16_t SharedEncodeTag::NextFrameId() {
+  const int slot = slot_.load(std::memory_order_acquire);
+  if (slot == 0) {
+    return 0;
+  }
+  return SharedEncodeFrameId(slot, seq_.fetch_add(1));
+}
+
+SharedEncodeConfig SharedEncodeConfig::Parse(
+    const webrtc::FieldTrialsView& trials) {
+  SharedEncodeConfig config;
+  webrtc::StructParametersParser::Create(
+      "key_ms", &config.key_ms,                //
+      "live_ms", &config.live_ms,              //
+      "isolate_ratio", &config.isolate_ratio,  //
+      "isolate_ms", &config.isolate_ms,        //
+      "isolate_keys", &config.isolate_keys,    //
+      "rejoin_ms", &config.rejoin_ms,          //
+      "threads", &config.threads)
+      ->Parse(trials.Lookup(kSharedScreenEncodeTrial));
+  config.key_ms = std::max(config.key_ms, 0);
+  config.live_ms = std::max(config.live_ms, 1);
+  config.isolate_ms = std::max(config.isolate_ms, 0);
+  config.isolate_keys = std::max(config.isolate_keys, 1);
+  config.rejoin_ms = std::max(config.rejoin_ms, 0);
+  if (config.threads && *config.threads < 1) {
+    config.threads.reset();
+  }
+  return config;
+}
+
+SharedEncoderFactory::SharedEncoderFactory(
+    std::unique_ptr<webrtc::VideoEncoderFactory> inner)
+    : registry_(std::make_shared<SharedEncodeRegistry>(std::move(inner))) {}
+
+SharedEncoderFactory::~SharedEncoderFactory() = default;
+
+std::vector<webrtc::SdpVideoFormat> SharedEncoderFactory::GetSupportedFormats()
+    const {
+  return registry_->inner().GetSupportedFormats();
+}
+
+std::vector<webrtc::SdpVideoFormat> SharedEncoderFactory::GetImplementations()
+    const {
+  return registry_->inner().GetImplementations();
+}
+
+webrtc::VideoEncoderFactory::CodecSupport
+SharedEncoderFactory::QueryCodecSupport(
+    const webrtc::SdpVideoFormat& format,
+    std::optional<std::string> scalability_mode,
+    std::optional<webrtc::Resolution> resolution) const {
+  return registry_->inner().QueryCodecSupport(format, scalability_mode,
+                                              resolution);
+}
+
+std::unique_ptr<webrtc::VideoEncoder> SharedEncoderFactory::Create(
+    const webrtc::Environment& env,
+    const webrtc::SdpVideoFormat& format) {
+  if (!env.field_trials().IsEnabled(kSharedScreenEncodeTrial) ||
+      !absl::EqualsIgnoreCase(format.name, "VP8")) {
+    return registry_->inner().Create(env, format);
+  }
+  return std::make_unique<SharedEncoderProxy>(
+      registry_, env, format, SharedEncodeConfig::Parse(env.field_trials()));
+}
+
+std::unique_ptr<webrtc::VideoEncoderFactory::EncoderSelectorInterface>
+SharedEncoderFactory::GetEncoderSelector() const {
+  return registry_->inner().GetEncoderSelector();
+}
+
+}  // namespace libwebrtc
