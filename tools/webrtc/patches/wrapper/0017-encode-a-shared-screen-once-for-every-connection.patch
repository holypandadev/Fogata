+// With real threads: the group delivers on its own thread while a connection
+// releases its encoder on another.
+TEST(SharedEncoder, NoDeliveryAfterRelease) {
+  const Environment env =
+      webrtc::CreateTestEnvironment({.field_trials = kTrial});
+  // The group's encoder starts only once both connections asked for the first
+  // frame, so both are its members when it is delivered.
+  webrtc::Event init_gate;
+  auto inner = std::make_unique<CountingFactory>();
+  inner->init_gate = &init_gate;
+  SharedEncoderFactory factory(std::move(inner));
+
+  class GatedCallback : public EncodedImageCallback {
+   public:
+    Result OnEncodedImage(const EncodedImage&,
+                          const CodecSpecificInfo*) override {
+      if (count.fetch_add(1) == 0) {
+        entered.Set();
+        gate.Wait(webrtc::Event::kForever);
+      }
+      return Result(Result::OK);
+    }
+    void OnFrameDropped(uint32_t, int, bool) override {}
+    webrtc::Event entered;
+    webrtc::Event gate;
+    std::atomic<int> count{0};
+  } gated;
+
+  class CountingCallback : public EncodedImageCallback {
+   public:
+    Result OnEncodedImage(const EncodedImage&,
+                          const CodecSpecificInfo*) override {
+      count.fetch_add(1);
+      got.Set();
+      return Result(Result::OK);
+    }
+    void OnFrameDropped(uint32_t, int, bool) override {}
+    webrtc::Event got;
+    std::atomic<int> count{0};
+  } counting;
+
+  const VideoCodec codec = Codec(1280, 720);
+  const VideoEncoder::Settings settings(VideoEncoder::Capabilities(false), 4,
+                                        1200);
+  std::unique_ptr<VideoEncoder> a = factory.Create(env, SdpVideoFormat::VP8());
+  std::unique_ptr<VideoEncoder> b = factory.Create(env, SdpVideoFormat::VP8());
+  for (auto* encoder : {a.get(), b.get()}) {
+    encoder->InitEncode(&codec, settings);
+    encoder->SetRates(Rates(2000000));
+  }
+  a->RegisterEncodeCompleteCallback(&gated);
+  b->RegisterEncodeCompleteCallback(&counting);
+  std::vector<VideoFrameType> key(1, VideoFrameType::kVideoFrameKey);
+  std::vector<VideoFrameType> delta(1, VideoFrameType::kVideoFrameDelta);
+
+  // a joined first, so the group delivers to it first, and waits there.
+  VideoFrame frame = Frame(1, 0);
+  frame.set_rtp_timestamp(1000);
+  a->Encode(frame, &key);
+  b->Encode(frame, &key);
+  init_gate.Set();
+  // Should an assertion end the test early, the group's thread must not stay
+  // waiting in the callback with its lock held.
+  struct OpenGate {
+    ~OpenGate() { gate->Set(); }
+    webrtc::Event* gate;
+  } open_gate{&gated.gate};
+  ASSERT_TRUE(gated.entered.Wait(TimeDelta::Seconds(5)));
+
+  std::atomic<bool> released{false};
+  webrtc::PlatformThread releasing = webrtc::PlatformThread::SpawnJoinable(
+      [&] {
+        a->Release();
+        released = true;
+      },
+      "release");
+  webrtc::Event().Wait(TimeDelta::Millis(100));
+  EXPECT_FALSE(released.load());  // The delivery is still under way.
+  gated.gate.Set();
+  releasing.Finalize();
+  EXPECT_TRUE(released.load());
+
+  ASSERT_TRUE(counting.got.Wait(TimeDelta::Seconds(5)));  // Frame 0.
+  for (int n = 1; n < 4; ++n) {
+    VideoFrame next = Frame(1, n);
+    next.set_rtp_timestamp(1000 + 90 * kFrameMs * n);
+    b->Encode(next, &delta);
+    // One at a time: a frame asked for while another waits replaces it.
+    ASSERT_TRUE(counting.got.Wait(TimeDelta::Seconds(5)));
+  }
+  EXPECT_EQ(counting.count.load(), 4);
+  EXPECT_EQ(gated.count.load(), 1);  // Nothing after Release.
+  b->Release();
+}
