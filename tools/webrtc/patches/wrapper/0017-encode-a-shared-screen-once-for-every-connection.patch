+TEST_F(SharedEncoderTest, AJoinerWaitsForAKeyFrame) {
+  auto a = NewWatcher(10);
+  auto b = NewWatcher(20);
+  a->Init();
+  b->Init();
+  auto c = NewWatcher(30);
+  constexpr int kJoinAt = 10;
+  for (int n = 0; n < 60; ++n) {
+    if (n == kJoinAt) {
+      c->Init();
+    }
+    a->Ask(Frame(1, n));
+    b->Ask(Frame(1, n));
+    if (n >= kJoinAt) {
+      c->Ask(Frame(1, n));
+    }
+    NextFrame();
+  }
+  const auto images = c->callback.images();
+  ASSERT_FALSE(images.empty());
+  EXPECT_TRUE(images.front().key);
+  ExpectContinuous(images);
+  // Within key_ms (1 s) of the group's last key frame, which was frame 0.
+  const size_t waited = 60 - kJoinAt - images.size();
+  EXPECT_LE(FrameMs(kJoinAt + waited), FrameMs(0) + 1000 + kFrameMs);
+  // The others got that key frame too, and nothing else was lost.
+  EXPECT_EQ(Keys(a->callback.images()), 2);
+  ExpectContinuous(a->callback.images());
+  EXPECT_EQ(inner_->Initialized().size(), 1u);
+}
