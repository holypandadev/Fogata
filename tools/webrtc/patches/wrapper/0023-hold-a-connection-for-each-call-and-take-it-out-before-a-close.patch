+// Windows, where the plugin adds transceivers on a thread of its own and the application
+// can close the connection meanwhile (a participant who left while an offer to them was
+// being made). Close() lets the connection go, which waits for the signaling thread to
+// destroy it; an AddTransceiver issued in that time found the connection still set and
+// was queued on the signaling thread behind its destruction, so it ran on a destroyed
+// PeerConnection and made a video channel with the Call already freed (an access
+// violation in WebRtcVideoSendChannel's constructor). Now it is answered at once, with
+// no transceiver.
+//
+// Returns 0 when the call is answered at once with nothing, 2 when it waited behind the
+// close, 3 when it made a transceiver, 1 when the set-up failed.
+int AddWhileClosing() {
+#if defined(__GLIBC__)
+  // Memory freed is overwritten, so that a use of it fails here as it did on Windows,
+  // instead of reading what was left there.
+  mallopt(M_PERTURB, 0xa5);
+#endif
+  if (!LibWebRTC::Initialize()) return 1;
+  scoped_refptr<libwebrtc::RTCPeerConnectionFactory> factory =
+      LibWebRTC::CreateRTCPeerConnectionFactory();
+  if (!factory.get() || !factory->Initialize()) return 1;
+  libwebrtc::RTCConfiguration config{};
+  scoped_refptr<libwebrtc::RTCMediaConstraints> constraints =
+      libwebrtc::RTCMediaConstraints::Create();
+  scoped_refptr<libwebrtc::RTCPeerConnection> pc =
+      factory->Create(config, constraints);
+  if (!pc.get()) return 1;
+
+  // The signaling thread is held in the answer to an offer until released, so that the
+  // close below stays where the connection is being let go of.
+  webrtc::Event holding;
+  webrtc::Event release;
+  webrtc::Event* held = &holding;
+  webrtc::Event* go = &release;
+  pc->CreateOffer(
+      [held, go](const libwebrtc::string, const libwebrtc::string) {
+        held->Set();
+        go->Wait(webrtc::Event::kForever);
+      },
+      [held, go](const char*) {
+        held->Set();
+        go->Wait(webrtc::Event::kForever);
+      },
+      constraints);
+  if (!holding.Wait(webrtc::TimeDelta::Seconds(10))) {
+    std::fprintf(stderr, "the offer never came\n");
+    return 1;
+  }
+
+  std::thread closer([pc] { pc->Close(); });
+  // The close is now letting the connection go, waiting for the signaling thread.
+  std::this_thread::sleep_for(std::chrono::milliseconds(300));
+
+  std::atomic<bool> answered{false};
+  scoped_refptr<libwebrtc::RTCRtpTransceiver> added;
+  std::thread adder([pc, &answered, &added] {
+    added = pc->AddTransceiver(libwebrtc::RTCMediaType::VIDEO);
+    answered = true;
+  });
+  std::this_thread::sleep_for(std::chrono::milliseconds(300));
+  const bool at_once = answered;
+
+  release.Set();
+  closer.join();
+  adder.join();
+  const bool made = added.get() != nullptr;
+  std::fprintf(stderr, "AddTransceiver answered %s, with %s\n",
+               at_once ? "at once" : "only after the close",
+               made ? "a transceiver" : "nothing");
+
+  added = nullptr;
+  factory->Delete(pc);
+  pc = nullptr;
+  factory->Terminate();
+  factory = nullptr;
+  LibWebRTC::Terminate();
+  if (!at_once) return 2;
+  if (made) return 3;
+  return 0;
+}
+
+// Counts the callbacks that come after `closed` is set.
+class LateCallbacks : public libwebrtc::RTCPeerConnectionObserver {
+ public:
+  std::atomic<bool> closed{false};
+  std::atomic<int> late{0};
+  std::atomic<int> before{0};
+
+  void Note() { (closed ? late : before)++; }
+  void OnSignalingState(libwebrtc::RTCSignalingState) override { Note(); }
+  void OnPeerConnectionState(libwebrtc::RTCPeerConnectionState) override {
+    Note();
+  }
+  void OnIceGatheringState(libwebrtc::RTCIceGatheringState) override { Note(); }
+  void OnIceConnectionState(libwebrtc::RTCIceConnectionState) override {
+    Note();
+  }
+  void OnIceCandidate(scoped_refptr<libwebrtc::RTCIceCandidate>) override {
+    Note();
+  }
+  void OnAddStream(scoped_refptr<libwebrtc::RTCMediaStream>) override { Note(); }
+  void OnRemoveStream(scoped_refptr<libwebrtc::RTCMediaStream>) override {
+    Note();
+  }
+  void OnDataChannel(scoped_refptr<libwebrtc::RTCDataChannel>) override {
+    Note();
+  }
+  void OnRenegotiationNeeded() override { Note(); }
+  void OnTrack(scoped_refptr<libwebrtc::RTCRtpTransceiver>) override { Note(); }
+  void OnAddTrack(libwebrtc::vector<scoped_refptr<libwebrtc::RTCMediaStream>>,
+                  scoped_refptr<libwebrtc::RTCRtpReceiver>) override {
+    Note();
+  }
+  void OnRemoveTrack(scoped_refptr<libwebrtc::RTCRtpReceiver>) override {
+    Note();
+  }
+};
+
+// A transceiver added on one thread just before another closes the connection: the add
+// holds the connection while it waits for the signaling thread. Close() returns only
+// once WebRTC's connection is closed: no callback of its observer comes after it, so
+// that the plugin may free its observer then. Before, Close() returned at once, the
+// connection went on while the add held it, and its callbacks (the renegotiation the add
+// asked for) came after the close, to an observer the plugin frees after a close.
+//
+// Returns 0 when no callback came after Close() returned, 4 when one did, 1 when the
+// set-up failed.
+int CallbacksAfterClose() {
+  if (!LibWebRTC::Initialize()) return 1;
+  scoped_refptr<libwebrtc::RTCPeerConnectionFactory> factory =
+      LibWebRTC::CreateRTCPeerConnectionFactory();
+  if (!factory.get() || !factory->Initialize()) return 1;
+  libwebrtc::RTCConfiguration config{};
+  scoped_refptr<libwebrtc::RTCMediaConstraints> constraints =
+      libwebrtc::RTCMediaConstraints::Create();
+  scoped_refptr<libwebrtc::RTCPeerConnection> pc =
+      factory->Create(config, constraints);
+  if (!pc.get()) return 1;
+  LateCallbacks observer;
+  pc->RegisterRTCPeerConnectionObserver(&observer);
+
+  webrtc::Event holding;
+  webrtc::Event release;
+  webrtc::Event* held = &holding;
+  webrtc::Event* go = &release;
+  pc->CreateOffer(
+      [held, go](const libwebrtc::string, const libwebrtc::string) {
+        held->Set();
+        go->Wait(webrtc::Event::kForever);
+      },
+      [held, go](const char*) {
+        held->Set();
+        go->Wait(webrtc::Event::kForever);
+      },
+      constraints);
+  if (!holding.Wait(webrtc::TimeDelta::Seconds(10))) {
+    std::fprintf(stderr, "the offer never came\n");
+    return 1;
+  }
+
+  // The add holds the connection, waiting for the signaling thread; then the close.
+  scoped_refptr<libwebrtc::RTCRtpTransceiver> added;
+  std::thread adder([pc, &added] {
+    added = pc->AddTransceiver(libwebrtc::RTCMediaType::VIDEO);
+  });
+  std::this_thread::sleep_for(std::chrono::milliseconds(300));
+  std::thread closer([pc, &observer] {
+    pc->Close();
+    observer.closed = true;
+  });
+  std::this_thread::sleep_for(std::chrono::milliseconds(300));
+
+  release.Set();
+  closer.join();
+  adder.join();
+  added = nullptr;
+  // Whatever the connection still had queued.
+  std::this_thread::sleep_for(std::chrono::milliseconds(500));
+  const int late = observer.late;
+  std::fprintf(stderr, "callbacks before Close() returned: %d, after: %d\n",
+               observer.before.load(), late);
+
+  pc->DeRegisterRTCPeerConnectionObserver();
+  factory->Delete(pc);
+  pc = nullptr;
+  factory->Terminate();
+  factory = nullptr;
+  LibWebRTC::Terminate();
+  return late == 0 ? 0 : 4;
+}
+
+}  // namespace
+
+// In a process of its own: before the fix the call ran on freed memory and the process
+// crashed, or went on with whatever it read there.
+TEST(ClosedConnection, AddTransceiverWhileClosingIsRefused) {
+  GTEST_FLAG_SET(death_test_style, "threadsafe");
+  EXPECT_EXIT(std::_Exit(AddWhileClosing()), ::testing::ExitedWithCode(0), "");
+}
+
+TEST(ClosedConnection, NoCallbackAfterCloseReturns) {
+  GTEST_FLAG_SET(death_test_style, "threadsafe");
+  EXPECT_EXIT(std::_Exit(CallbacksAfterClose()), ::testing::ExitedWithCode(0), "");
+}
