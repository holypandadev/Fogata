 #include "rtc_base/logging.h"
+#include "rtc_base/time_utils.h"
 #include "third_party/libyuv/include/libyuv.h"
 #ifdef WEBRTC_WIN
 #include "modules/desktop_capture/win/window_capture_utils.h"
@@ -160,7 +161,9 @@ RTCDesktopCapturerImpl::RTCDesktopCapturerImpl(
   type_ = type;
   thread_->Start();
   options_ = webrtc::DesktopCaptureOptions::CreateDefault();
-  options_.set_detect_updated_region(true);
+  // No updated region is asked for: every frame goes whole to the encoder, so
+  // comparing each one with the last (DesktopCapturerDifferWrapper) only cost
+  // the capture thread time.
 #ifdef WEBRTC_WIN
   options_.set_allow_directx_capturer(true);
 #if defined(RTC_ENABLE_WIN_WGC)
@@ -290,7 +293,10 @@ RTCDesktopCapturerImpl::CaptureState RTCDesktopCapturerImpl::Start(
     }
   }
 
-  thread_->BlockingCall([this] { capturer_->Start(this); });
+  thread_->BlockingCall([this] {
+    capturer_->Start(this);
+    next_capture_us_ = 0;
+  });
   capture_state_ = CS_RUNNING;
   thread_->PostTask([this] { CaptureFrame(); });
   if (observer_) {
@@ -430,12 +436,53 @@ void RTCDesktopCapturerImpl::OnWgcFrame(const webrtc::DesktopFrame& frame) {
 
 void RTCDesktopCapturerImpl::CaptureFrame() {
   RTC_DCHECK_RUN_ON(thread_.get());
-  if (capture_state_ == CS_RUNNING) {
-    capturer_->CaptureFrame();
-    thread_->PostDelayedHighPrecisionTask(
-        [this]() { CaptureFrame(); },
-        webrtc::TimeDelta::Millis(capture_delay_));
+  if (capture_state_ != CS_RUNNING) {
+    return;
+  }
+  const int64_t started = webrtc::TimeMicros();
+  capturer_->CaptureFrame();
+  const int64_t now = webrtc::TimeMicros();
+  NoteCapture(now - started, now);
+  // The next capture is due one interval after this one began, not after it
+  // ended: waiting the whole interval after a capture that took 20 ms made 30
+  // frames a second into 19. A capture that took longer than the interval is
+  // followed by the next at once, never by several to catch up.
+  const int64_t interval = int64_t{capture_delay_} * 1000;
+  next_capture_us_ = next_capture_us_ == 0 ? started + interval
+                                           : next_capture_us_ + interval;
+  if (next_capture_us_ < now) {
+    next_capture_us_ = now;
+  }
+  thread_->PostDelayedHighPrecisionTask(
+      [this]() { CaptureFrame(); },
+      webrtc::TimeDelta::Micros(next_capture_us_ - now));
+}
+
+void RTCDesktopCapturerImpl::NoteCapture(int64_t took_us, int64_t now_us) {
+  // What capturing a frame costs on this computer (the capturer, the cursor,
+  // the conversion to I420 and the hand-over to the encoder), told every 10 s
+  // to WebRTC's log at the info level.
+  if (stats_since_us_ == 0) {
+    stats_since_us_ = now_us;
+  }
+  stats_frames_++;
+  stats_total_us_ += took_us;
+  stats_longest_us_ = std::max(stats_longest_us_, took_us);
+  const int64_t span = now_us - stats_since_us_;
+  if (span < 10'000'000) {
+    return;
   }
+  RTC_LOG(LS_INFO) << "RTCDesktopCapturerImpl: " << stats_frames_
+                   << " captures in " << span / 1000 << " ms ("
+                   << stats_frames_ * 1'000'000.0 / span
+                   << " a second, asked " << 1000.0 / capture_delay_
+                   << "), " << stats_total_us_ / 1000.0 / stats_frames_
+                   << " ms each on average, longest "
+                   << stats_longest_us_ / 1000.0 << " ms";
+  stats_since_us_ = now_us;
+  stats_frames_ = 0;
+  stats_total_us_ = 0;
+  stats_longest_us_ = 0;
 }
 
 }  // namespace libwebrtc
